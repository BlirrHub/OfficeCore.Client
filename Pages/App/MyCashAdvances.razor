@page "/app/cash-advances"
@attribute [Authorize]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject CashAdvanceApi CashAdvanceApi

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col overflow-auto">
    <div class="flex justify-between items-center mb-4 flex-shrink-0">
        <div>
            <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">Cash Advances</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Request and track your cash advances</p>
        </div>
        <button @onclick="OpenRequestModal" class="rounded-2xl border border-amber-400/40 bg-amber-400/20 px-4 sm:px-6 py-2 whitespace-nowrap text-amber-200 transition hover:bg-amber-400/30">
            + Request
        </button>
    </div>

    <div class="mb-4 flex gap-4 items-end flex-shrink-0 rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">Start Date</label>
            <input type="date" @bind="startDate" class="w-full rounded border border-neutral-700 bg-neutral-950 px-3 py-2 text-white" />
        </div>
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">End Date</label>
            <input type="date" @bind="endDate" class="w-full rounded border border-neutral-700 bg-neutral-950 px-3 py-2 text-white" />
        </div>
        <button @onclick="LoadRequests" class="rounded-2xl border border-amber-400/40 bg-amber-400/20 px-6 py-2 whitespace-nowrap text-amber-200 transition hover:bg-amber-400/30">
            Filter
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-8 flex-1 flex items-center justify-center">
            <p class="text-gray-400">Loading your cash advance requests...</p>
        </div>
    }
    else if (cashAdvances == null || !cashAdvances.Any())
    {
        <div class="flex flex-1 flex-col items-center justify-center rounded-2xl border border-neutral-800 bg-neutral-900 p-8 text-center">
            <p class="text-gray-400 mb-4">You haven't made any cash advance requests yet.</p>
            <button @onclick="OpenRequestModal" class="rounded-2xl border border-amber-400/40 bg-amber-400/20 px-6 py-2 text-amber-200 transition hover:bg-amber-400/30">
                Request Your First Cash Advance
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 overflow-auto">
            @foreach (var ca in cashAdvances.OrderByDescending(c => c.CreatedAt))
            {
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-5 transition-colors hover:bg-neutral-800">
                    <div class="flex justify-between items-start mb-3">
                        <div class="text-3xl font-bold text-blue-400">
                            ₱@ca.Amount.ToString("N2")
                        </div>
                        @if (ca.Status == 1)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                Pending
                            </span>
                        }
                        else if (ca.Status == 2)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                Approved
                            </span>
                        }
                        else if (ca.Status == 3)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                                Paid
                            </span>
                        }
                    </div>

                    <p class="text-sm text-gray-400 mb-2">
                        <strong class="text-gray-300">Requested:</strong> @ca.CreatedAt.ToString("MMM dd, yyyy")
                    </p>
                    
                    <p class="text-sm text-gray-300 mb-3 line-clamp-2">
                        @ca.Reason
                    </p>

                    @if (ca.Status == 2 || ca.Status == 4)
                    {
                        <p class="text-xs text-green-400 mb-1">
                            Approved on @ca.ApprovedAt?.ToString("MMM dd, yyyy")
                        </p>
                    }

                    @if (ca.Status == 4 && ca.PaidAt.HasValue)
                    {
                        <p class="text-xs text-blue-400 mb-1">
                            Paid on @ca.PaidAt.Value.ToString("MMM dd, yyyy")
                        </p>
                    }

                    @if (ca.PayrollWeekStart.HasValue)
                    {
                        <p class="text-xs text-purple-400">
                            Deducted from payroll (Week of @ca.PayrollWeekStart.Value.ToString("MMM dd"))
                        </p>
                    }

                    <button @onclick="() => ViewDetails(ca.Id)"
                            class="mt-3 w-full rounded border border-sky-400/40 bg-sky-500/20 px-3 py-2 text-sm text-sky-200 transition hover:bg-sky-500/30">
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (showRequestModal)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseRequestModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-lg shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-lg font-bold text-white">Request Cash Advance</h3>
                <button @onclick="CloseRequestModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-300 mb-1">
                    Amount (₱100 - ₱1,000) <span class="text-red-400">*</span>
                </label>
                <input type="number" step="0.01" min="100" max="1000"
                       @bind="newRequest.Amount"
                       class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="Enter amount" />
                @if (!string.IsNullOrEmpty(amountError))
                {
                    <p class="mt-1 text-sm text-red-400">@amountError</p>
                }
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-300 mb-1">
                    Reason (optional)
                </label>
                <textarea @bind="newRequest.Reason" rows="4"
                          class="w-full bg-gray-800 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                          placeholder="Explain why you need this cash advance (optional)"></textarea>
                @if (!string.IsNullOrEmpty(reasonError))
                {
                    <p class="mt-1 text-sm text-red-400">@reasonError</p>
                }
            </div>

            <div class="flex gap-3">
                <button @onclick="SubmitRequest" disabled="@isSaving"
                        class="flex-1 bg-blue-600 text-white rounded-2xl px-4 py-2 hover:bg-blue-700 disabled:opacity-50 transition-colors">
                    @(isSaving ? "Submitting..." : "Submit Request")
                </button>
                <button @onclick="CloseRequestModal" disabled="@isSaving"
                        class="flex-1 bg-gray-800 border border-gray-600 text-white px-4 py-2 rounded-2xl hover:bg-gray-700 disabled:opacity-50 transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (selectedRequest != null)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseDetailsModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-2xl shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-lg font-bold text-white">Cash Advance Details</h3>
                <button @onclick="CloseDetailsModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <div class="p-4 bg-gray-800 border border-gray-700 rounded-lg mb-4">
                    <p class="text-sm text-gray-400">Amount</p>
                    <p class="text-3xl font-bold text-blue-400">₱@selectedRequest.Amount.ToString("N2")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-400 mb-1">Status</label>
                    @if (selectedRequest.Status == 1)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">
                            Pending Approval
                        </span>
                    }
                    else if (selectedRequest.Status == 2)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                            Approved
                        </span>
                    }
                    else if (selectedRequest.Status == 3)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                            Rejected
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">
                            Paid
                        </span>
                    }
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-400 mb-1">Request Date</label>
                    <p class="text-white">@selectedRequest.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-400 mb-1">Reason</label>
                    <p class="text-white">@selectedRequest.Reason</p>
                </div>

                @if (selectedRequest.Status != 1)
                {
                    <div class="mb-3 p-3 @(selectedRequest.Status == 2 || selectedRequest.Status == 4 ? "bg-green-900 bg-opacity-30 border border-green-700" : "bg-red-900 bg-opacity-30 border border-red-700") rounded">
                        <label class="block text-sm font-medium @(selectedRequest.Status == 2 || selectedRequest.Status == 4 ? "text-green-400" : "text-red-400") mb-1">
                            @(selectedRequest.Status == 2 || selectedRequest.Status == 4 ? "Approved" : "Rejected") On
                        </label>
                        <p class="@(selectedRequest.Status == 2 || selectedRequest.Status == 4 ? "text-green-300" : "text-red-300")">
                            @selectedRequest.ApprovedAt?.ToString("MMMM dd, yyyy hh:mm tt")
                        </p>
                    </div>
                }

                @if (selectedRequest.Status == 4 && selectedRequest.PaidAt.HasValue)
                {
                    <div class="mb-3 p-3 bg-blue-900 bg-opacity-30 border border-blue-700 rounded">
                        <label class="block text-sm font-medium text-blue-400 mb-1">Paid On</label>
                        <p class="text-blue-300 font-semibold">@selectedRequest.PaidAt.Value.ToString("MMMM dd, yyyy hh:mm tt")</p>
                    </div>
                }

                @if (selectedRequest.PayrollWeekStart.HasValue)
                {
                    <div class="mb-3 p-3 bg-purple-900 bg-opacity-30 border border-purple-700 rounded">
                        <label class="block text-sm font-medium text-purple-400 mb-1">Payroll Deduction</label>
                        <p class="text-purple-300">
                            This amount was deducted from your payroll for the week starting 
                            <strong>@selectedRequest.PayrollWeekStart.Value.ToString("MMMM dd, yyyy")</strong>
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<CashAdvanceDto>? cashAdvances;
    private CashAdvanceDto? selectedRequest;
    private bool isLoading;
    private bool isSaving;
    private bool showRequestModal;
    private DateOnly? startDate;
    private DateOnly? endDate;

    private CreateCashAdvanceRequest newRequest = new();
    private string? amountError;
    private string? reasonError;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        cashAdvances = await CashAdvanceApi.GetMyRequestsAsync(startDate, endDate);
        isLoading = false;
    }

    private void OpenRequestModal()
    {
        newRequest = new CreateCashAdvanceRequest
        {
            RequestDate = DateOnly.FromDateTime(DateTime.Today)
        };
        amountError = null;
        reasonError = null;
        showRequestModal = true;
    }

    private async Task SubmitRequest()
    {
        amountError = null;
        reasonError = null;

        // Validate amount
        if (newRequest.Amount < 100 || newRequest.Amount > 1000)
        {
            amountError = "Amount must be between ₱100 and ₱1,000";
            return;
        }

        // Validate reason (optional but if provided must be meaningful)
        if (!string.IsNullOrWhiteSpace(newRequest.Reason) && newRequest.Reason.Trim().Length < 3)
        {
            reasonError = "Reason must be at least 3 characters if provided";
            return;
        }

        isSaving = true;
        var result = await CashAdvanceApi.RequestCashAdvanceAsync(newRequest);
        isSaving = false;

        if (result != null)
        {
            await LoadRequests();
            CloseRequestModal();
        }
    }

    private void CloseRequestModal()
    {
        showRequestModal = false;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedRequest = await CashAdvanceApi.GetRequestAsync(id);
    }

    private void CloseDetailsModal()
    {
        selectedRequest = null;
    }
}
