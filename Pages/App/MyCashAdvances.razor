@page "/app/cash-advances"
@attribute [Authorize]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject CashAdvanceApi CashAdvanceApi

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">My Cash Advances</h1>
        <button @onclick="OpenRequestModal" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            + Request Cash Advance
        </button>
    </div>

    <div class="mb-6 flex gap-4 items-end">
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
            <input type="date" @bind="startDate" class="w-full border border-gray-300 rounded px-3 py-2" />
        </div>
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
            <input type="date" @bind="endDate" class="w-full border border-gray-300 rounded px-3 py-2" />
        </div>
        <button @onclick="LoadRequests" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
            Filter
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-8">
            <p class="text-gray-500">Loading your cash advance requests...</p>
        </div>
    }
    else if (cashAdvances == null || !cashAdvances.Any())
    {
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <p class="text-gray-500">You haven't made any cash advance requests yet.</p>
            <button @onclick="OpenRequestModal" class="mt-4 bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
                Request Your First Cash Advance
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var ca in cashAdvances.OrderByDescending(c => c.CreatedAt))
            {
                <div class="bg-white rounded-lg shadow p-5 hover:shadow-lg transition-shadow">
                    <div class="flex justify-between items-start mb-3">
                        <div class="text-3xl font-bold text-blue-700">
                            ₱@ca.Amount.ToString("N2")
                        </div>
                        @if (ca.Status == 0)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                Pending
                            </span>
                        }
                        else if (ca.Status == 1)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                Approved
                            </span>
                        }
                        else if (ca.Status == 2)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                                Paid
                            </span>
                        }
                    </div>

                    <p class="text-sm text-gray-600 mb-2">
                        <strong>Requested:</strong> @ca.CreatedAt.ToString("MMM dd, yyyy")
                    </p>
                    
                    <p class="text-sm text-gray-700 mb-3 line-clamp-2">
                        @ca.Reason
                    </p>

                    @if (ca.Status == 1 || ca.Status == 3)
                    {
                        <p class="text-xs text-green-600 mb-1">
                            Approved on @ca.ApprovedAt?.ToString("MMM dd, yyyy")
                        </p>
                    }

                    @if (ca.Status == 3 && ca.PaidAt.HasValue)
                    {
                        <p class="text-xs text-blue-600 mb-1">
                            Paid on @ca.PaidAt.Value.ToString("MMM dd, yyyy")
                        </p>
                    }

                    @if (ca.PayrollWeekStart.HasValue)
                    {
                        <p class="text-xs text-purple-600">
                            Deducted from payroll (Week of @ca.PayrollWeekStart.Value.ToString("MMM dd"))
                        </p>
                    }

                    <button @onclick="() => ViewDetails(ca.Id)"
                            class="mt-3 w-full bg-gray-100 text-gray-700 px-3 py-2 rounded hover:bg-gray-200 text-sm">
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (showRequestModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" @onclick="CloseRequestModal">
        <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-lg shadow-lg rounded-md bg-white" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-lg font-bold text-gray-900">Request Cash Advance</h3>
                <button @onclick="CloseRequestModal" class="text-gray-400 hover:text-gray-500">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Amount (₱100 - ₱1,000) <span class="text-red-500">*</span>
                </label>
                <input type="number" step="0.01" min="100" max="1000"
                       @bind="newRequest.Amount"
                       class="w-full border border-gray-300 rounded px-3 py-2"
                       placeholder="Enter amount" />
                @if (!string.IsNullOrEmpty(amountError))
                {
                    <p class="mt-1 text-sm text-red-600">@amountError</p>
                }
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Reason (minimum 10 characters) <span class="text-red-500">*</span>
                </label>
                <textarea @bind="newRequest.Reason" rows="4"
                          class="w-full border border-gray-300 rounded px-3 py-2"
                          placeholder="Explain why you need this cash advance"></textarea>
                @if (!string.IsNullOrEmpty(reasonError))
                {
                    <p class="mt-1 text-sm text-red-600">@reasonError</p>
                }
            </div>

            <div class="flex gap-3">
                <button @onclick="SubmitRequest" disabled="@isSaving"
                        class="flex-1 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 disabled:opacity-50">
                    @(isSaving ? "Submitting..." : "Submit Request")
                </button>
                <button @onclick="CloseRequestModal" disabled="@isSaving"
                        class="flex-1 bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400 disabled:opacity-50">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@if (selectedRequest != null)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" @onclick="CloseDetailsModal">
        <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-2xl shadow-lg rounded-md bg-white" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-lg font-bold text-gray-900">Cash Advance Details</h3>
                <button @onclick="CloseDetailsModal" class="text-gray-400 hover:text-gray-500">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <div class="p-4 bg-blue-50 rounded mb-4">
                    <p class="text-sm text-gray-600">Amount</p>
                    <p class="text-3xl font-bold text-blue-700">₱@selectedRequest.Amount.ToString("N2")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                    @if (selectedRequest.Status == 0)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">
                            Pending Approval
                        </span>
                    }
                    else if (selectedRequest.Status == 1)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                            Approved
                        </span>
                    }
                    else if (selectedRequest.Status == 2)
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                            Rejected
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">
                            Paid
                        </span>
                    }
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Request Date</label>
                    <p class="text-gray-900">@selectedRequest.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                    <p class="text-gray-900">@selectedRequest.Reason</p>
                </div>

                @if (selectedRequest.Status != 0)
                {
                    <div class="mb-3 p-3 @(selectedRequest.Status == 1 || selectedRequest.Status == 3 ? "bg-green-50" : "bg-red-50") rounded">
                        <label class="block text-sm font-medium @(selectedRequest.Status == 1 || selectedRequest.Status == 3 ? "text-green-700" : "text-red-700") mb-1">
                            @(selectedRequest.Status == 1 || selectedRequest.Status == 3 ? "Approved" : "Rejected") On
                        </label>
                        <p class="@(selectedRequest.Status == 1 || selectedRequest.Status == 3 ? "text-green-900" : "text-red-900")">
                            @selectedRequest.ApprovedAt?.ToString("MMMM dd, yyyy hh:mm tt")
                        </p>
                    </div>
                }

                @if (selectedRequest.Status == 3 && selectedRequest.PaidAt.HasValue)
                {
                    <div class="mb-3 p-3 bg-blue-50 rounded">
                        <label class="block text-sm font-medium text-blue-700 mb-1">Paid On</label>
                        <p class="text-blue-900 font-semibold">@selectedRequest.PaidAt.Value.ToString("MMMM dd, yyyy hh:mm tt")</p>
                    </div>
                }

                @if (selectedRequest.PayrollWeekStart.HasValue)
                {
                    <div class="mb-3 p-3 bg-purple-50 rounded">
                        <label class="block text-sm font-medium text-purple-700 mb-1">Payroll Deduction</label>
                        <p class="text-purple-900">
                            This amount was deducted from your payroll for the week starting 
                            <strong>@selectedRequest.PayrollWeekStart.Value.ToString("MMMM dd, yyyy")</strong>
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<CashAdvanceDto>? cashAdvances;
    private CashAdvanceDto? selectedRequest;
    private bool isLoading;
    private bool isSaving;
    private bool showRequestModal;
    private DateOnly? startDate;
    private DateOnly? endDate;

    private CreateCashAdvanceRequest newRequest = new();
    private string? amountError;
    private string? reasonError;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        cashAdvances = await CashAdvanceApi.GetMyRequestsAsync(startDate, endDate);
        isLoading = false;
    }

    private void OpenRequestModal()
    {
        newRequest = new CreateCashAdvanceRequest();
        amountError = null;
        reasonError = null;
        showRequestModal = true;
    }

    private async Task SubmitRequest()
    {
        amountError = null;
        reasonError = null;

        // Validate amount
        if (newRequest.Amount < 100 || newRequest.Amount > 1000)
        {
            amountError = "Amount must be between ₱100 and ₱1,000";
            return;
        }

        // Validate reason
        if (string.IsNullOrWhiteSpace(newRequest.Reason) || newRequest.Reason.Length < 10)
        {
            reasonError = "Reason must be at least 10 characters";
            return;
        }

        isSaving = true;
        var result = await CashAdvanceApi.RequestCashAdvanceAsync(newRequest);
        isSaving = false;

        if (result != null)
        {
            await LoadRequests();
            CloseRequestModal();
        }
    }

    private void CloseRequestModal()
    {
        showRequestModal = false;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedRequest = await CashAdvanceApi.GetRequestAsync(id);
    }

    private void CloseDetailsModal()
    {
        selectedRequest = null;
    }
}
