@page "/app/my-tasks"
@attribute [Authorize(Roles = "Employee")]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@using OfficeCore.Client.Components.Common
@inject TaskApi TaskApi
@implements IDisposable

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col">
    <div class="flex justify-between items-center mb-4 flex-shrink-0">
        <div>
            <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">My Tasks</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Tasks assigned to you or claimed from the task pool</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="w-4 h-4 animate-pulse text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"></path>
            </svg>
            <span>Auto-refresh active</span>
        </div>
    </div>

    <div class="mb-4 flex flex-1 flex-col overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900">
        <div class="border-b border-neutral-700 flex-shrink-0">
            <nav class="flex -mb-px overflow-x-auto">
                <button @onclick="() => SelectTab(-1)"
                        class="@(activeTab == -1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    All
                </button>
                <button @onclick="() => SelectTab(1)"
                        class="@(activeTab == 1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Pending
                </button>
                <button @onclick="() => SelectTab(3)"
                        class="@(activeTab == 3 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    In Progress
                </button>
                <button @onclick="() => SelectTab(4)"
                        class="@(activeTab == 4 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Completed
                </button>
                <button @onclick="() => SelectTab(5)"
                        class="@(activeTab == 5 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Approved
                </button>
                <button @onclick="() => SelectTab(6)"
                        class="@(activeTab == 6 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Rejected
                    @if (rejectedCount > 0)
                    {
                        <span class="ml-2 bg-red-100 text-red-600 py-0.5 px-2 rounded-full text-xs">@rejectedCount</span>
                    }
                </button>
            </nav>
        </div>

        <div class="p-4 flex-1 overflow-auto">
            @if (isLoading)
            {
                <div class="text-center py-8">
                    <p class="text-white">Loading tasks...</p>
                </div>
            }
            else if (filteredTasks == null || !filteredTasks.Any())
            {
                <div class="text-center py-8">
                    <p class="text-gray-400">No tasks found.</p>
                    <p class="text-gray-500 text-sm mt-2">Check the Task Pool for available tasks you can claim!</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var task in filteredTasks)
                    {
                        <div class="overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950 shadow-lg transition-colors hover:border-amber-500/40 hover:bg-neutral-900">
                            <div class="p-4">
                                <div class="flex justify-between items-start mb-3">
                                    <h3 class="text-white font-semibold text-lg truncate flex-1">@task.Title</h3>
                                    <PriorityBadge Priority="@task.Priority" PriorityName="@task.PriorityName" />
                                </div>

                                <p class="text-gray-300 text-sm mb-3 line-clamp-2">@task.Description</p>

                                <div class="space-y-2 text-xs mb-4">
                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-400">Status:</span>
                                        <TaskStatusBadge Status="@task.Status" StatusName="@task.StatusName" IsOverdue="@task.IsOverdue" />
                                    </div>

                                    @if (task.DueDate.HasValue)
                                    {
                                        <div class="flex justify-between items-center">
                                            <span class="text-gray-400">Due Date:</span>
                                            <span class="@(task.IsOverdue ? "text-red-400 font-semibold" : "text-gray-200")">
                                                @task.DueDate.Value.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                    }

                                    @if (task.AssignmentType == 2)
                                    {
                                        <div class="flex justify-between items-center">
                                            <span class="text-gray-400">Source:</span>
                                            <span class="text-blue-400">Task Pool</span>
                                        </div>
                                    }

                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-400">Created:</span>
                                        <span class="text-gray-200">@task.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                @if (task.Status == 6 && !string.IsNullOrEmpty(task.RejectionNotes))
                                {
                                    <div class="bg-red-900/20 border border-red-700 rounded p-2 mb-3">
                                        <p class="text-red-300 text-xs font-medium mb-1">Rejection Feedback:</p>
                                        <p class="text-gray-200 text-xs">@task.RejectionNotes</p>
                                    </div>
                                }

                                <div class="flex gap-2">
                                        <button @onclick="() => ViewDetails(task.Id)"
                                            class="flex-1 rounded border border-sky-400/40 bg-sky-500/20 py-2 text-sm text-sky-200 transition hover:bg-sky-500/30">
                                        View Details
                                    </button>

                                    @if (task.Status == 1 || task.Status == 2)
                                    {
                                        <button @onclick="() => StartTask(task.Id)"
                                            class="flex-1 rounded border border-emerald-400/40 bg-emerald-500/20 py-2 text-sm text-emerald-200 transition hover:bg-emerald-500/30">
                                            Start Task
                                        </button>
                                    }
                                    else if (task.Status == 3)
                                    {
                                        <button @onclick="() => OpenCompleteModal(task.Id)"
                                                class="flex-1 rounded border border-violet-400/40 bg-violet-500/20 py-2 text-sm text-violet-200 transition hover:bg-violet-500/30">
                                            Complete
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (selectedTask != null)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseDetailModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-2xl shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div class="flex-1">
                    <h3 class="text-lg font-bold text-white mb-2">@selectedTask.Title</h3>
                    <div class="flex gap-2 items-center">
                        <PriorityBadge Priority="@selectedTask.Priority" PriorityName="@selectedTask.PriorityName" />
                        <TaskStatusBadge Status="@selectedTask.Status" StatusName="@selectedTask.StatusName" IsOverdue="@selectedTask.IsOverdue" />
                    </div>
                </div>
                <button @onclick="CloseDetailModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Description</label>
                    <p class="text-gray-50 bg-neutral-800 p-3 rounded-lg">@selectedTask.Description</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Created By</label>
                        <p class="text-gray-50">@selectedTask.CreatedByName</p>
                        <p class="text-xs text-gray-400">@selectedTask.CreatedAt.ToString("MMM dd, yyyy")</p>
                    </div>

                    @if (selectedTask.AssignmentType == 2)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Assignment Type</label>
                            <p class="text-blue-400">Task Pool (Claimed)</p>
                            <p class="text-xs text-gray-400">@selectedTask.ClaimedAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                    }
                </div>

                <div class="grid grid-cols-2 gap-4">
                    @if (selectedTask.StartDate.HasValue)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Started At</label>
                            <p class="text-gray-50">@selectedTask.StartDate.Value.ToString("MMM dd, yyyy")</p>
                        </div>
                    }

                    @if (selectedTask.DueDate.HasValue)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Due Date</label>
                            <p class="@(selectedTask.IsOverdue ? "text-red-400 font-semibold" : "text-gray-50")">
                                @selectedTask.DueDate.Value.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(selectedTask.CompletionNotes))
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Completion Notes</label>
                        <p class="text-gray-50 bg-neutral-800 p-3 rounded-lg">@selectedTask.CompletionNotes</p>
                        <p class="text-xs text-gray-400 mt-1">@selectedTask.CompletedAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedTask.RejectionNotes))
                {
                    <div class="bg-red-900/20 border border-red-700 rounded-lg p-3">
                        <label class="block text-sm font-medium text-red-300 mb-1">Rejection Feedback</label>
                        <p class="text-gray-50">@selectedTask.RejectionNotes</p>
                        <p class="text-xs text-gray-400 mt-1">Reviewed: @selectedTask.ReviewedAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                }

                @if (selectedTask.Status == 5)
                {
                    <div class="bg-green-900/20 border border-green-700 rounded-lg p-3">
                        <label class="block text-sm font-medium text-green-300 mb-1">Status</label>
                        <p class="text-gray-50">Approved by @selectedTask.ReviewedByName</p>
                        <p class="text-xs text-gray-400">@selectedTask.ReviewedAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>
                }
            </div>

            <div class="flex gap-2 pt-4 mt-4 border-t border-neutral-700">
                @if (selectedTask.Status == 1 || selectedTask.Status == 2)
                {
                    <button @onclick="() => StartTask(selectedTask.Id)"
                            class="flex-1 bg-green-600 text-white rounded-lg py-2 px-4 hover:bg-green-700 transition-colors">
                        Start Task
                    </button>
                }
                else if (selectedTask.Status == 3)
                {
                    <button @onclick="() => OpenCompleteModal(selectedTask.Id)"
                            class="flex-1 bg-purple-600 text-white rounded-lg py-2 px-4 hover:bg-purple-700 transition-colors">
                        Complete Task
                    </button>
                }
                
                <button @onclick="CloseDetailModal"
                        class="flex-1 border border-gray-600 rounded-lg py-2 px-4 text-gray-200 hover:bg-gray-800 transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@if (showCompleteModal)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50" @onclick="CloseCompleteModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-lg shadow-2xl border border-neutral-900" @onclick:stopPropagation="true">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-white">Complete Task</h3>
                <button @onclick="CloseCompleteModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">
                        Completion Notes <span class="text-red-400">*</span>
                    </label>
                    <textarea @bind="completionNotes"
                              class="w-full bg-gray-800 border border-gray-600 rounded-lg px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 min-h-[120px]"
                              placeholder="Describe what you did to complete this task..."></textarea>
                    <p class="text-xs text-gray-400 mt-1">Required: Provide details about how you completed the task</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(completeMessage))
                {
                    <div class="text-sm @(isCompleteError ? "text-red-400 bg-red-900/20 border border-red-700" : "text-green-400 bg-green-900/20 border border-green-700") rounded-lg p-3">
                        @completeMessage
                    </div>
                }

                <div class="flex gap-2">
                    <button @onclick="CompleteTask"
                            disabled="@(isCompleting || string.IsNullOrWhiteSpace(completionNotes))"
                            class="flex-1 bg-purple-600 text-white rounded-lg py-2 px-4 hover:bg-purple-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                        @(isCompleting ? "Submitting..." : "Submit Completion")
                    </button>
                    <button @onclick="CloseCompleteModal"
                            disabled="@isCompleting"
                            class="flex-1 border border-gray-600 rounded-lg py-2 px-4 text-gray-200 hover:bg-gray-800 transition-colors">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskDto>? allTasks;
    private List<TaskDto>? filteredTasks;
    private TaskDto? selectedTask;
    
    private bool isLoading = true;
    private bool showCompleteModal = false;
    private bool isCompleting = false;
    
    private int activeTab = -1;
    private int rejectedCount;
    
    private Guid taskToCompleteId;
    private string completionNotes = "";
    private string? completeMessage;
    private bool isCompleteError;
    
    private PeriodicTimer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = Task.Run(async () =>
        {
            while (await refreshTimer.WaitForNextTickAsync())
            {
                await InvokeAsync(async () =>
                {
                    await LoadTasks(silent: true);
                    StateHasChanged();
                });
            }
        });
    }

    private async Task LoadTasks(bool silent = false)
    {
        if (!silent) isLoading = true;

        allTasks = await TaskApi.GetMyTasksAsync();
        UpdateCounts();
        FilterTasks();

        if (!silent) isLoading = false;
    }

    private void UpdateCounts()
    {
        if (allTasks == null) return;
        rejectedCount = allTasks.Count(t => t.Status == 6);
    }

    private void FilterTasks()
    {
        if (allTasks == null)
        {
            filteredTasks = null;
            return;
        }

        if (activeTab == -1)
        {
            filteredTasks = allTasks;
        }
        else
        {
            filteredTasks = allTasks.Where(t => t.Status == activeTab).ToList();
        }
    }

    private void SelectTab(int tab)
    {
        activeTab = tab;
        FilterTasks();
    }

    private async Task ViewDetails(Guid id)
    {
        selectedTask = await TaskApi.GetTaskAsync(id);
    }

    private void CloseDetailModal()
    {
        selectedTask = null;
    }

    private async Task StartTask(Guid id)
    {
        try
        {
            var request = new UpdateTaskStatusRequest { Status = 3 }; // InProgress
            var result = await TaskApi.UpdateStatusAsync(id, request);
            
            if (result != null)
            {
                await LoadTasks();
                if (selectedTask != null)
                {
                    selectedTask = result;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting task: {ex.Message}");
        }
    }

    private void OpenCompleteModal(Guid id)
    {
        taskToCompleteId = id;
        completionNotes = "";
        completeMessage = null;
        isCompleteError = false;
        showCompleteModal = true;
    }

    private void CloseCompleteModal()
    {
        showCompleteModal = false;
        completionNotes = "";
        completeMessage = null;
        taskToCompleteId = Guid.Empty;
    }

    private async Task CompleteTask()
    {
        if (string.IsNullOrWhiteSpace(completionNotes)) return;

        isCompleting = true;
        completeMessage = null;
        isCompleteError = false;

        try
        {
            var request = new CompleteTaskRequest { CompletionNotes = completionNotes };
            var result = await TaskApi.CompleteTaskAsync(taskToCompleteId, request);
            
            if (result != null)
            {
                completeMessage = "Task submitted for approval!";
                isCompleteError = false;
                await Task.Delay(1500);
                await LoadTasks();
                CloseCompleteModal();
                if (selectedTask != null && selectedTask.Id == taskToCompleteId)
                {
                    selectedTask = result;
                }
            }
            else
            {
                completeMessage = "Failed to complete task.";
                isCompleteError = true;
            }
        }
        catch (Exception ex)
        {
            completeMessage = $"Error: {ex.Message}";
            isCompleteError = true;
        }
        finally
        {
            isCompleting = false;
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
