@page "/app/settings"
@attribute [Authorize(Roles = "Employee")]
@using Microsoft.AspNetCore.Authorization
@using OfficeCore.Client.Models.Dtos
@inject OfficeCore.Client.Services.Api.AuthApi AuthApi
@inject NavigationManager Nav

<div class="flex h-[calc(100vh-120px)] flex-col overflow-auto rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5">
	@if (isLoading)
	{
		<div class="flex h-full items-center justify-center">
			<p class="text-sm text-neutral-400">Loading settings...</p>
		</div>
	}
	else
	{
		<section class="rounded-3xl border border-neutral-800 bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.14),_transparent_36%),linear-gradient(135deg,_rgba(23,23,23,0.98),_rgba(10,10,10,1))] p-4 sm:p-6">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div class="max-w-2xl">
					<div class="mb-3 inline-flex items-center gap-2 rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-sky-300">
						Employee Settings
					</div>
					<h1 class="text-2xl font-semibold tracking-tight text-white sm:text-4xl">Personal preferences and account controls.</h1>
					<p class="mt-3 text-sm leading-6 text-neutral-300 sm:text-base">
						Manage how you work in OfficeCore and keep your account secure.
					</p>
				</div>
				@if (profile != null)
				{
					<div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
						<p class="text-xs uppercase tracking-[0.18em] text-neutral-400">Signed in as</p>
						<p class="mt-2 text-lg font-semibold text-white">@GetDisplayName()</p>
						<p class="mt-1 text-xs text-neutral-400">@profile.Username</p>
					</div>
				}
			</div>
		</section>

		<div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
			<div class="grid gap-4 content-start">
				<section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
					<p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Preferences</p>
					<h2 class="mt-2 text-xl font-semibold text-white">Workspace behavior</h2>

					<div class="mt-5 space-y-3">
						<button @onclick='() => TogglePreference(nameof(enableTaskReminders))' class="w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-left transition hover:border-neutral-700">
							<div class="flex items-center justify-between gap-4">
								<div>
									<p class="text-sm font-medium text-white">Task reminders</p>
									<p class="mt-1 text-xs text-neutral-400">Show reminders for due and overdue tasks.</p>
								</div>
								<span class="rounded-full px-2.5 py-1 text-xs @(enableTaskReminders ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-300" : "border border-neutral-700 text-neutral-400")">@(enableTaskReminders ? "On" : "Off")</span>
							</div>
						</button>

						<button @onclick='() => TogglePreference(nameof(enableDailyDigest))' class="w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-left transition hover:border-neutral-700">
							<div class="flex items-center justify-between gap-4">
								<div>
									<p class="text-sm font-medium text-white">Daily digest summary</p>
									<p class="mt-1 text-xs text-neutral-400">Display a daily summary panel for your queues.</p>
								</div>
								<span class="rounded-full px-2.5 py-1 text-xs @(enableDailyDigest ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-300" : "border border-neutral-700 text-neutral-400")">@(enableDailyDigest ? "On" : "Off")</span>
							</div>
						</button>

						<button @onclick='() => TogglePreference(nameof(compactCards))' class="w-full rounded-2xl border border-neutral-800 bg-neutral-950 p-4 text-left transition hover:border-neutral-700">
							<div class="flex items-center justify-between gap-4">
								<div>
									<p class="text-sm font-medium text-white">Compact cards</p>
									<p class="mt-1 text-xs text-neutral-400">Use tighter spacing in list and dashboard cards.</p>
								</div>
								<span class="rounded-full px-2.5 py-1 text-xs @(compactCards ? "border border-emerald-500/30 bg-emerald-500/10 text-emerald-300" : "border border-neutral-700 text-neutral-400")">@(compactCards ? "On" : "Off")</span>
							</div>
						</button>
					</div>
				</section>

				<section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
					<p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Security</p>
					<h2 class="mt-2 text-xl font-semibold text-white">Account protection</h2>

					<div class="mt-5 rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
						<p class="text-sm text-neutral-300">
							Password updates and account details are managed from your profile page.
						</p>
						<button @onclick='() => Nav.NavigateTo("/profile")' class="mt-4 rounded-xl border border-neutral-700 bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-800">
							Open profile security
						</button>
					</div>
				</section>
			</div>

			<div class="grid gap-4 content-start">
				<section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
					<p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Quick access</p>
					<h2 class="mt-2 text-xl font-semibold text-white">Jump to common pages</h2>

					<div class="mt-5 grid gap-3">
						<button @onclick='() => Nav.NavigateTo("/app/dashboard")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
							<span class="text-sm font-medium text-white">Dashboard</span>
							<span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
						</button>
						<button @onclick='() => Nav.NavigateTo("/app/my-tasks")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
							<span class="text-sm font-medium text-white">My tasks</span>
							<span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
						</button>
						<button @onclick='() => Nav.NavigateTo("/app/notifications")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
							<span class="text-sm font-medium text-white">Notifications</span>
							<span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
						</button>
					</div>
				</section>

				<section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
					<p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Session state</p>
					<h2 class="mt-2 text-xl font-semibold text-white">Preference summary</h2>

					<div class="mt-5 space-y-2 text-sm text-neutral-300">
						<div class="flex items-center justify-between rounded-xl border border-neutral-800 bg-neutral-950 px-3 py-2">
							<span>Task reminders</span>
							<span class="text-neutral-400">@(enableTaskReminders ? "Enabled" : "Disabled")</span>
						</div>
						<div class="flex items-center justify-between rounded-xl border border-neutral-800 bg-neutral-950 px-3 py-2">
							<span>Daily digest</span>
							<span class="text-neutral-400">@(enableDailyDigest ? "Enabled" : "Disabled")</span>
						</div>
						<div class="flex items-center justify-between rounded-xl border border-neutral-800 bg-neutral-950 px-3 py-2">
							<span>Compact cards</span>
							<span class="text-neutral-400">@(compactCards ? "Enabled" : "Disabled")</span>
						</div>
					</div>
				</section>
			</div>
		</div>
	}
</div>

@code {
	private bool isLoading = true;
	private UserProfileDto? profile;

	// Session-only UI preferences for now.
	private bool enableTaskReminders = true;
	private bool enableDailyDigest = true;
	private bool compactCards;

	protected override async Task OnInitializedAsync()
	{
		profile = await AuthApi.GetMyProfileAsync();
		isLoading = false;
	}

	private void TogglePreference(string key)
	{
		if (key == nameof(enableTaskReminders))
		{
			enableTaskReminders = !enableTaskReminders;
			return;
		}

		if (key == nameof(enableDailyDigest))
		{
			enableDailyDigest = !enableDailyDigest;
			return;
		}

		compactCards = !compactCards;
	}

	private string GetDisplayName()
	{
		if (profile == null)
		{
			return "Employee";
		}

		var full = $"{profile.FirstName} {profile.LastName}".Trim();
		return string.IsNullOrWhiteSpace(full) ? profile.Username : full;
	}
}