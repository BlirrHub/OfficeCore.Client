@page "/app/liquidations"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject LiquidationApi LiquidationApi

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col overflow-auto">
    <div class="mb-4 flex flex-shrink-0 items-start justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">Liquidations</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Create and track your daily liquidations from web or mobile.</p>
        </div>
        <button @onclick="OpenCreateModal"
                class="rounded-2xl border border-amber-400/40 bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30">
            New Liquidation
        </button>
    </div>

    <div class="mb-4 rounded-2xl border border-sky-400/20 bg-sky-500/10 p-4 flex-shrink-0">
        <p class="text-sm text-blue-300">
            <strong>Tip:</strong> You can submit a liquidation here directly, or continue using the mobile app when you're on the move.
        </p>
    </div>

    <div class="mb-4 flex gap-4 items-end flex-shrink-0 rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">Start Date</label>
            <input type="date" @bind="startDate" class="w-full rounded border border-neutral-700 bg-neutral-950 px-3 py-2 text-white" />
        </div>
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">End Date</label>
            <input type="date" @bind="endDate" class="w-full rounded border border-neutral-700 bg-neutral-950 px-3 py-2 text-white" />
        </div>
        <button @onclick="LoadLiquidations" class="rounded-2xl border border-amber-400/40 bg-amber-400/20 px-6 py-2 whitespace-nowrap text-amber-200 transition hover:bg-amber-400/30">
            Filter
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-8 flex-1 flex items-center justify-center">
            <p class="text-gray-400">Loading your liquidations...</p>
        </div>
    }
    else if (liquidations == null || !liquidations.Any())
    {
        <div class="flex flex-1 items-center justify-center rounded-2xl border border-neutral-800 bg-neutral-900 p-8 text-center">
            <p class="text-gray-400">No liquidations found for the selected period.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 overflow-auto">
            @foreach (var liq in liquidations.OrderByDescending(l => l.Date))
            {
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-5 transition-colors hover:bg-neutral-800">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <p class="text-sm text-gray-400">Date</p>
                            <p class="text-lg font-bold text-white">@liq.Date.ToString("MMM dd, yyyy")</p>
                        </div>
                        @if (liq.Status == 1)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                Pending
                            </span>
                        }
                        else if (liq.Status == 2)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                Rejected
                            </span>
                        }
                    </div>

                    <div class="space-y-2 mb-4">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Cash Received:</span>
                            <span class="font-semibold text-blue-400">₱@liq.PettyCashReceived.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Total Spent:</span>
                            <span class="font-semibold text-white">₱@liq.TotalSpent.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Returned:</span>
                            <span class="font-semibold text-green-400">₱@liq.AmountReturned.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Reimbursement:</span>
                            <span class="font-semibold text-purple-400">₱@liq.ReimbursementDue.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="text-xs text-gray-500 mb-3">
                        @liq.Entries.Count() expense @(liq.Entries.Count() == 1 ? "entry" : "entries")
                    </div>

                    @if (liq.Status == 2)
                    {
                        <p class="text-xs text-green-400 mb-2">
                            Approved on @liq.ApprovedAt?.ToString("MMM dd, yyyy")
                        </p>
                    }

                    <button @onclick="() => ViewDetails(liq.Id)"
                            class="w-full rounded border border-sky-400/40 bg-sky-500/20 px-3 py-2 text-sm text-sky-200 transition hover:bg-sky-500/30">
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm" @onclick="CloseCreateModal">
        <div class="max-h-[90vh] w-full max-w-4xl overflow-auto rounded-3xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-white">Create Liquidation</h3>
                    <p class="mt-1 text-sm text-neutral-400">Submit your liquidation with expense lines and optional receipt files.</p>
                </div>
                <button @onclick="CloseCreateModal" class="text-neutral-500 transition hover:text-neutral-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(createError))
            {
                <div class="mb-4 rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
                    @createError
                </div>
            }

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-neutral-300">Date</label>
                    <input type="date" @bind="createLiquidation.Date" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-neutral-300">Petty Cash Received</label>
                    <input type="number" step="0.01" min="0" @bind="createLiquidation.PettyCashReceived" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <div>
                        <h4 class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-400">Expense Entries</h4>
                        <p class="mt-1 text-sm text-neutral-500">Attach receipts where available. Accepted files depend on server validation.</p>
                    </div>
                    <button @onclick="AddCreateEntry"
                            class="rounded-xl border border-sky-400/40 bg-sky-500/20 px-4 py-2 text-sm font-medium text-sky-200 transition hover:bg-sky-500/30">
                        Add Entry
                    </button>
                </div>

                <div class="space-y-3">
                    @for (var index = 0; index < createLiquidation.Entries.Count; index++)
                    {
                        var entry = createLiquidation.Entries[index];
                        <div class="grid gap-3 rounded-2xl border border-neutral-800 bg-neutral-950 p-4 md:grid-cols-[1fr_160px_1fr_auto]">
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Particulars</label>
                                <input @bind="entry.Particulars" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Amount</label>
                                <input type="number" step="0.01" min="0" @bind="entry.Amount" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Receipt</label>
                                <InputFile OnChange="@(args => OnCreateReceiptChanged(index, args))" accept="image/*,.pdf" class="w-full rounded-xl border border-dashed border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-300 file:mr-3 file:rounded-lg file:border-0 file:bg-amber-400/20 file:px-3 file:py-2 file:text-amber-200" />
                                <p class="mt-2 truncate text-xs text-neutral-500">@(string.IsNullOrWhiteSpace(entry.ReceiptName) ? "Optional" : entry.ReceiptName)</p>
                            </div>
                            <div class="flex items-center">
                                <button @onclick="() => RemoveCreateEntry(index)"
                                        disabled="@(createLiquidation.Entries.Count == 1)"
                                        class="w-full rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200 transition hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-40">
                                    Remove
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Total Spent</p>
                    <p class="mt-2 text-2xl font-semibold text-white">₱@CreateTotalSpent.ToString("N2")</p>
                </div>
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Amount Returned</p>
                    <p class="mt-2 text-2xl font-semibold text-emerald-300">₱@CreateAmountReturned.ToString("N2")</p>
                </div>
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Reimbursement Due</p>
                    <p class="mt-2 text-2xl font-semibold text-violet-300">₱@CreateReimbursementDue.ToString("N2")</p>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button @onclick="CloseCreateModal"
                        class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900">
                    Cancel
                </button>
                <button @onclick="SubmitLiquidation"
                        disabled="@isSubmittingCreate"
                        class="rounded-xl border border-amber-400/40 bg-amber-400/20 px-5 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30 disabled:cursor-not-allowed disabled:opacity-60">
                    @(isSubmittingCreate ? "Submitting..." : "Submit Liquidation")
                </button>
            </div>
        </div>
    </div>
}

@if (selectedLiquidation != null)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-4xl shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Liquidation Details</h3>
                    <p class="text-sm text-gray-400">@selectedLiquidation.Date.ToString("MMMM dd, yyyy")</p>
                </div>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4 flex justify-between items-center">
                @if (selectedLiquidation.Status == 1)
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">
                        Pending Approval
                    </span>
                }
                else if (selectedLiquidation.Status == 2)
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                        Approved
                    </span>
                }
                else
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                        Rejected
                    </span>
                }
            </div>

            <div class="mb-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="p-3 bg-blue-900 bg-opacity-30 border border-blue-700 rounded-lg">
                    <p class="text-xs text-gray-400">Cash Received</p>
                    <p class="text-lg font-bold text-blue-400">₱@selectedLiquidation.PettyCashReceived.ToString("N2")</p>
                </div>
                <div class="p-3 bg-gray-800 border border-gray-700 rounded-lg">
                    <p class="text-xs text-gray-400">Total Spent</p>
                    <p class="text-lg font-bold text-white">₱@selectedLiquidation.TotalSpent.ToString("N2")</p>
                </div>
                <div class="p-3 bg-green-900 bg-opacity-30 border border-green-700 rounded-lg">
                    <p class="text-xs text-gray-400">Returned</p>
                    <p class="text-lg font-bold text-green-400">₱@selectedLiquidation.AmountReturned.ToString("N2")</p>
                </div>
                <div class="p-3 bg-purple-900 bg-opacity-30 border border-purple-700 rounded-lg">
                    <p class="text-xs text-gray-400">Reimbursement</p>
                    <p class="text-lg font-bold text-purple-400">₱@selectedLiquidation.ReimbursementDue.ToString("N2")</p>
                </div>
            </div>

            <div class="mb-4">
                <h4 class="font-semibold text-white mb-2">Expense Entries</h4>
                <div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-700">
                        <thead class="bg-gray-950">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">#</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">Particulars</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-400 uppercase">Amount</th>
                                <th class="px-4 py-2 text-center text-xs font-medium text-gray-400 uppercase">Receipt</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-600">
                            @foreach (var entry in selectedLiquidation.Entries.OrderBy(e => e.SequenceOrder))
                            {
                                <tr class="hover:bg-neutral-650">
                                    <td class="px-4 py-3 text-sm text-gray-400">@entry.SequenceOrder</td>
                                    <td class="px-4 py-3 text-sm text-white">@entry.Particulars</td>
                                    <td class="px-4 py-3 text-sm text-right text-white">₱@entry.Amount.ToString("N2")</td>
                                    <td class="px-4 py-3 text-sm text-center">
                                        @if (!string.IsNullOrEmpty(entry.ReceiptImageUrl))
                                        {
                                            <a href="@entry.ReceiptImageUrl" target="_blank"
                                               class="text-blue-400 hover:text-blue-300 inline-flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-gray-500">No receipt</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-neutral-900">
                            <tr>
                                <td colspan="2" class="px-4 py-3 text-sm font-bold text-white text-right">Total:</td>
                                <td class="px-4 py-3 text-sm font-bold text-white text-right">
                                    ₱@selectedLiquidation.TotalSpent.ToString("N2")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedLiquidation.IssuedByName))
            {
                <div class="mb-3 p-3 bg-blue-900 bg-opacity-30 border border-blue-700 rounded">
                    <p class="text-sm text-blue-300">
                        <strong>Issued by:</strong> @selectedLiquidation.IssuedByName on @selectedLiquidation.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }

            @if (selectedLiquidation.Status == 2)
            {
                <div class="p-3 bg-green-900 bg-opacity-30 border border-green-700 rounded">
                    <p class="text-sm text-green-300">
                        <strong>Approved on:</strong> @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }
            else if (selectedLiquidation.Status == 3)
            {
                <div class="p-3 bg-red-900 bg-opacity-30 border border-red-700 rounded">
                    <p class="text-sm text-red-300">
                        <strong>Rejected on:</strong> @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<LiquidationDto>? liquidations;
    private LiquidationDto? selectedLiquidation;
    private bool isLoading;
    private bool showCreateModal;
    private bool isSubmittingCreate;
    private DateOnly? startDate;
    private DateOnly? endDate;
    private string? createError;
    private EmployeeLiquidationForm createLiquidation = EmployeeLiquidationForm.CreateDefault();

    private decimal CreateTotalSpent => createLiquidation.Entries.Sum(entry => entry.Amount);
    private decimal CreateAmountReturned => Math.Max(createLiquidation.PettyCashReceived - CreateTotalSpent, 0m);
    private decimal CreateReimbursementDue => Math.Max(CreateTotalSpent - createLiquidation.PettyCashReceived, 0m);

    protected override async Task OnInitializedAsync()
    {
        // Default to current month
        var today = DateTime.Today;
        startDate = new DateOnly(today.Year, today.Month, 1);
        endDate = DateOnly.FromDateTime(today);

        await LoadLiquidations();
    }

    private void OpenCreateModal()
    {
        createError = null;
        createLiquidation = EmployeeLiquidationForm.CreateDefault();
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        if (isSubmittingCreate)
        {
            return;
        }

        createError = null;
        showCreateModal = false;
        createLiquidation = EmployeeLiquidationForm.CreateDefault();
    }

    private void AddCreateEntry()
    {
        createLiquidation.Entries.Add(new EmployeeLiquidationEntry());
    }

    private void RemoveCreateEntry(int index)
    {
        if (createLiquidation.Entries.Count == 1)
        {
            return;
        }

        createLiquidation.Entries.RemoveAt(index);
    }

    private void OnCreateReceiptChanged(int index, InputFileChangeEventArgs args)
    {
        if (index < 0 || index >= createLiquidation.Entries.Count)
        {
            return;
        }

        createLiquidation.Entries[index].Receipt = args.File;
        createLiquidation.Entries[index].ReceiptName = args.File?.Name;
    }

    private async Task SubmitLiquidation()
    {
        createError = ValidateCreateLiquidation();
        if (!string.IsNullOrWhiteSpace(createError))
        {
            return;
        }

        isSubmittingCreate = true;

        var request = new CreateLiquidationRequest
        {
            Date = createLiquidation.Date,
            PettyCashReceived = createLiquidation.PettyCashReceived,
            Entries = createLiquidation.Entries.Select(entry => new CreateLiquidationEntryDto
            {
                Particulars = entry.Particulars.Trim(),
                Amount = entry.Amount
            }).ToList()
        };

        var created = await LiquidationApi.SubmitLiquidationAsync(request, createLiquidation.Entries.Select(entry => entry.Receipt).ToList());
        isSubmittingCreate = false;

        if (created == null)
        {
            createError = LiquidationApi.LastError ?? "Unable to submit liquidation.";
            return;
        }

        showCreateModal = false;
        await LoadLiquidations();
        await ViewDetails(created.Id);
    }

    private string? ValidateCreateLiquidation()
    {
        if (createLiquidation.PettyCashReceived < 0)
        {
            return "Petty cash received cannot be negative.";
        }

        if (createLiquidation.Entries.Count == 0)
        {
            return "Add at least one expense entry.";
        }

        if (createLiquidation.Entries.Any(entry => string.IsNullOrWhiteSpace(entry.Particulars)))
        {
            return "Each entry needs particulars.";
        }

        if (createLiquidation.Entries.Any(entry => entry.Amount <= 0))
        {
            return "Each entry amount must be greater than zero.";
        }

        return null;
    }

    private async Task LoadLiquidations()
    {
        isLoading = true;
        liquidations = await LiquidationApi.GetMyLiquidationsAsync(startDate, endDate);
        isLoading = false;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedLiquidation = await LiquidationApi.GetLiquidationAsync(id);
    }

    private void CloseModal()
    {
        selectedLiquidation = null;
    }

    private sealed class EmployeeLiquidationForm
    {
        public DateOnly Date { get; set; }
        public decimal PettyCashReceived { get; set; }
        public List<EmployeeLiquidationEntry> Entries { get; set; } = new();

        public static EmployeeLiquidationForm CreateDefault()
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            return new EmployeeLiquidationForm
            {
                Date = today,
                Entries = new List<EmployeeLiquidationEntry> { new() }
            };
        }
    }

    private sealed class EmployeeLiquidationEntry
    {
        public string Particulars { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public IBrowserFile? Receipt { get; set; }
        public string? ReceiptName { get; set; }
    }
}
