@page "/app/liquidations"
@attribute [Authorize]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject LiquidationApi LiquidationApi

<div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-3 sm:p-4 flex flex-col overflow-auto">
    <div class="mb-4 flex-shrink-0">
        <h1 class="text-xl sm:text-2xl text-white font-bold">Liquidations</h1>
        <p class="text-gray-400 text-xs sm:text-sm mt-1">View and track your daily liquidations</p>
    </div>

    <div class="mb-4 bg-blue-900 bg-opacity-30 border border-blue-700 rounded-lg p-4 flex-shrink-0">
        <p class="text-sm text-blue-300">
            <strong>Note:</strong> Daily liquidations are submitted via the mobile app. 
            This page shows your liquidation history for reference.
        </p>
    </div>

    <div class="mb-4 flex gap-4 items-end flex-shrink-0">
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">Start Date</label>
            <input type="date" @bind="startDate" class="w-full bg-neutral-700 border border-neutral-600 text-white rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>
        <div class="flex-1">
            <label class="block text-sm font-medium text-gray-400 mb-1">End Date</label>
            <input type="date" @bind="endDate" class="w-full bg-neutral-700 border border-neutral-600 text-white rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
        </div>
        <button @onclick="LoadLiquidations" class="bg-black text-white border rounded-2xl px-6 py-2 hover:bg-gray-800 whitespace-nowrap">
            Filter
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-8 flex-1 flex items-center justify-center">
            <p class="text-gray-400">Loading your liquidations...</p>
        </div>
    }
    else if (liquidations == null || !liquidations.Any())
    {
        <div class="bg-neutral-800 border border-neutral-700 rounded-lg p-8 text-center flex-1 flex items-center justify-center">
            <p class="text-gray-400">No liquidations found for the selected period.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 overflow-auto">
            @foreach (var liq in liquidations.OrderByDescending(l => l.Date))
            {
                <div class="bg-neutral-800 border border-neutral-700 rounded-lg p-5 hover:bg-neutral-750 transition-colors">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <p class="text-sm text-gray-400">Date</p>
                            <p class="text-lg font-bold text-white">@liq.Date.ToString("MMM dd, yyyy")</p>
                        </div>
                        @if (liq.Status == 1)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                Pending
                            </span>
                        }
                        else if (liq.Status == 2)
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                Rejected
                            </span>
                        }
                    </div>

                    <div class="space-y-2 mb-4">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Cash Received:</span>
                            <span class="font-semibold text-blue-400">₱@liq.PettyCashReceived.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Total Spent:</span>
                            <span class="font-semibold text-white">₱@liq.TotalSpent.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Returned:</span>
                            <span class="font-semibold text-green-400">₱@liq.AmountReturned.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Reimbursement:</span>
                            <span class="font-semibold text-purple-400">₱@liq.ReimbursementDue.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="text-xs text-gray-500 mb-3">
                        @liq.Entries.Count() expense @(liq.Entries.Count() == 1 ? "entry" : "entries")
                    </div>

                    @if (liq.Status == 2)
                    {
                        <p class="text-xs text-green-400 mb-2">
                            Approved on @liq.ApprovedAt?.ToString("MMM dd, yyyy")
                        </p>
                    }

                    <button @onclick="() => ViewDetails(liq.Id)"
                            class="w-full bg-neutral-700 border border-neutral-600 text-white px-3 py-2 rounded hover:bg-neutral-600 text-sm">
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (selectedLiquidation != null)
{
    <div class="fixed inset-0 bg-black bg-opacity-70 overflow-y-auto h-full w-full z-50" @onclick="CloseModal">
        <div class="relative top-20 mx-auto p-5 border border-neutral-700 w-11/12 max-w-4xl shadow-lg rounded-md bg-neutral-800" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Liquidation Details</h3>
                    <p class="text-sm text-gray-400">@selectedLiquidation.Date.ToString("MMMM dd, yyyy")</p>
                </div>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4 flex justify-between items-center">
                @if (selectedLiquidation.Status == 1)
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">
                        Pending Approval
                    </span>
                }
                else if (selectedLiquidation.Status == 2)
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                        Approved
                    </span>
                }
                else
                {
                    <span class="px-3 py-1 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                        Rejected
                    </span>
                }
            </div>

            <div class="mb-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="p-3 bg-blue-900 bg-opacity-30 border border-blue-700 rounded">
                    <p class="text-xs text-gray-400">Cash Received</p>
                    <p class="text-lg font-bold text-blue-400">₱@selectedLiquidation.PettyCashReceived.ToString("N2")</p>
                </div>
                <div class="p-3 bg-neutral-700 border border-neutral-600 rounded">
                    <p class="text-xs text-gray-400">Total Spent</p>
                    <p class="text-lg font-bold text-white">₱@selectedLiquidation.TotalSpent.ToString("N2")</p>
                </div>
                <div class="p-3 bg-green-900 bg-opacity-30 border border-green-700 rounded">
                    <p class="text-xs text-gray-400">Returned</p>
                    <p class="text-lg font-bold text-green-400">₱@selectedLiquidation.AmountReturned.ToString("N2")</p>
                </div>
                <div class="p-3 bg-purple-900 bg-opacity-30 border border-purple-700 rounded">
                    <p class="text-xs text-gray-400">Reimbursement</p>
                    <p class="text-lg font-bold text-purple-400">₱@selectedLiquidation.ReimbursementDue.ToString("N2")</p>
                </div>
            </div>

            <div class="mb-4">
                <h4 class="font-semibold text-white mb-2">Expense Entries</h4>
                <div class="bg-neutral-700 border border-neutral-600 rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-neutral-600">
                        <thead class="bg-neutral-900">
                            <tr>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">#</th>
                                <th class="px-4 py-2 text-left text-xs font-medium text-gray-400 uppercase">Particulars</th>
                                <th class="px-4 py-2 text-right text-xs font-medium text-gray-400 uppercase">Amount</th>
                                <th class="px-4 py-2 text-center text-xs font-medium text-gray-400 uppercase">Receipt</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-600">
                            @foreach (var entry in selectedLiquidation.Entries.OrderBy(e => e.SequenceOrder))
                            {
                                <tr class="hover:bg-neutral-650">
                                    <td class="px-4 py-3 text-sm text-gray-400">@entry.SequenceOrder</td>
                                    <td class="px-4 py-3 text-sm text-white">@entry.Particulars</td>
                                    <td class="px-4 py-3 text-sm text-right text-white">₱@entry.Amount.ToString("N2")</td>
                                    <td class="px-4 py-3 text-sm text-center">
                                        @if (!string.IsNullOrEmpty(entry.ReceiptImagePath))
                                        {
                                            <a href="@($"/api/files/receipt/{entry.ReceiptImagePath}")" target="_blank"
                                               class="text-blue-400 hover:text-blue-300 inline-flex items-center">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-gray-500">No receipt</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-neutral-900">
                            <tr>
                                <td colspan="2" class="px-4 py-3 text-sm font-bold text-white text-right">Total:</td>
                                <td class="px-4 py-3 text-sm font-bold text-white text-right">
                                    ₱@selectedLiquidation.TotalSpent.ToString("N2")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedLiquidation.IssuedByName))
            {
                <div class="mb-3 p-3 bg-blue-900 bg-opacity-30 border border-blue-700 rounded">
                    <p class="text-sm text-blue-300">
                        <strong>Issued by:</strong> @selectedLiquidation.IssuedByName on @selectedLiquidation.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }

            @if (selectedLiquidation.Status == 2)
            {
                <div class="p-3 bg-green-900 bg-opacity-30 border border-green-700 rounded">
                    <p class="text-sm text-green-300">
                        <strong>Approved on:</strong> @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }
            else if (selectedLiquidation.Status == 3)
            {
                <div class="p-3 bg-red-900 bg-opacity-30 border border-red-700 rounded">
                    <p class="text-sm text-red-300">
                        <strong>Rejected on:</strong> @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<LiquidationDto>? liquidations;
    private LiquidationDto? selectedLiquidation;
    private bool isLoading;
    private DateOnly? startDate;
    private DateOnly? endDate;

    protected override async Task OnInitializedAsync()
    {
        // Default to current month
        var today = DateTime.Today;
        startDate = new DateOnly(today.Year, today.Month, 1);
        endDate = DateOnly.FromDateTime(today);

        await LoadLiquidations();
    }

    private async Task LoadLiquidations()
    {
        isLoading = true;
        liquidations = await LiquidationApi.GetMyLiquidationsAsync(startDate, endDate);
        isLoading = false;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedLiquidation = await LiquidationApi.GetLiquidationAsync(id);
    }

    private void CloseModal()
    {
        selectedLiquidation = null;
    }
}
