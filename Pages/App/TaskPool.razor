@page "/app/task-pool"
@attribute [Authorize(Roles = "Employee")]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@using OfficeCore.Client.Components.Common
@inject TaskApi TaskApi
@implements IDisposable

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col">
    <div class="flex justify-between items-center mb-4 flex-shrink-0">
        <div>
            <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">Task Pool</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Available tasks that anyone can claim - first come, first served!</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-400">
            <svg class="w-4 h-4 animate-pulse text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"></path>
            </svg>
            <span>Auto-refresh active</span>
        </div>
    </div>

    <div class="mb-4 flex gap-4 items-end flex-shrink-0 flex-wrap rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
        <div class="flex-1 min-w-[150px]">
            <label class="block text-xs text-gray-200 mb-1">Priority</label>
            <select @bind="selectedPriority" class="w-full border border-neutral-700 rounded-lg px-3 py-2 text-gray-200 bg-neutral-950">
                <option value="">All Priorities</option>
                <option value="1">Critical</option>
                <option value="2">High</option>
                <option value="3">Normal</option>
                <option value="4">Low</option>
            </select>
        </div>
        <button @onclick="() => LoadTasks()" class="rounded-lg border border-amber-400/40 bg-amber-400/20 px-4 py-2 text-amber-200 transition hover:bg-amber-400/30">
            Filter
        </button>
    </div>

    <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4 flex-1 overflow-auto">
        @if (isLoading)
        {
            <div class="text-center py-8">
                <p class="text-white">Loading available tasks...</p>
            </div>
        }
        else if (tasks == null || !tasks.Any())
        {
            <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-gray-400">No tasks available in the pool right now.</p>
                <p class="text-gray-500 text-sm mt-2">Check back later or review your assigned tasks!</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var task in tasks)
                {
                    <div class="overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950 shadow-lg transition-colors hover:border-emerald-500/40 hover:bg-neutral-900">
                        <div class="p-4">
                            <div class="flex justify-between items-start mb-3">
                                <h3 class="text-white font-semibold text-lg truncate flex-1">@task.Title</h3>
                                <PriorityBadge Priority="@task.Priority" PriorityName="@task.PriorityName" />
                            </div>

                            <p class="text-gray-300 text-sm mb-3 line-clamp-3">@task.Description</p>

                            <div class="space-y-2 text-xs mb-4">
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Created By:</span>
                                    <span class="text-gray-200">@task.CreatedByName</span>
                                </div>

                                @if (task.DueDate.HasValue)
                                {
                                    <div class="flex justify-between items-center">
                                        <span class="text-gray-400">Due Date:</span>
                                        <span class="@(task.IsOverdue ? "text-red-400 font-semibold" : "text-gray-200")">
                                            @task.DueDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                }

                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Posted:</span>
                                    <span class="text-gray-200">@task.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>

                            @if (task.IsOverdue)
                            {
                                <div class="bg-red-900/20 border border-red-700 rounded p-2 mb-3">
                                    <p class="text-red-300 text-xs font-medium">⚠️ This task is overdue!</p>
                                </div>
                            }

                            <div class="flex gap-2">
                                <button @onclick="() => ViewDetails(task.Id)"
                                    class="flex-1 rounded border border-sky-400/40 bg-sky-500/20 py-2 text-sm text-sky-200 transition hover:bg-sky-500/30">
                                    View Details
                                </button>

                                <button @onclick="() => ClaimTask(task.Id)"
                                    class="flex-1 rounded border border-emerald-400/40 bg-emerald-500/20 py-2 text-sm text-emerald-200 transition hover:bg-emerald-500/30">
                                    Claim Task
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (selectedTask != null)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-2xl shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div class="flex-1">
                    <h3 class="text-lg font-bold text-white mb-2">@selectedTask.Title</h3>
                    <div class="flex gap-2 items-center">
                        <PriorityBadge Priority="@selectedTask.Priority" PriorityName="@selectedTask.PriorityName" />
                        <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">Task Pool</span>
                        @if (selectedTask.IsOverdue)
                        {
                            <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">Overdue</span>
                        }
                    </div>
                </div>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Description</label>
                    <p class="text-gray-50 bg-neutral-800 p-3 rounded-lg">@selectedTask.Description</p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Created By</label>
                        <p class="text-gray-50">@selectedTask.CreatedByName</p>
                        <p class="text-xs text-gray-400">@selectedTask.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Priority Level</label>
                        <PriorityBadge Priority="@selectedTask.Priority" PriorityName="@selectedTask.PriorityName" />
                    </div>
                </div>

                @if (selectedTask.DueDate.HasValue)
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Due Date</label>
                        <p class="@(selectedTask.IsOverdue ? "text-red-400 font-semibold text-lg" : "text-gray-50 text-lg")">
                            @selectedTask.DueDate.Value.ToString("MMMM dd, yyyy")
                        </p>
                        @if (selectedTask.IsOverdue)
                        {
                            <p class="text-red-300 text-sm mt-1">⚠️ This task is past its due date</p>
                        }
                        else
                        {
                            var daysUntilDue = (selectedTask.DueDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                            <p class="text-gray-400 text-sm mt-1">@daysUntilDue days remaining</p>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(claimMessage))
                {
                    <div class="text-sm @(isClaimError ? "text-red-400 bg-red-900/20 border border-red-700" : "text-green-400 bg-green-900/20 border border-green-700") rounded-lg p-3">
                        @claimMessage
                    </div>
                }

                <div class="bg-blue-900/20 border border-blue-700 rounded-lg p-3">
                    <p class="text-blue-300 text-sm">
                        💡 <strong>First come, first served!</strong> Claim this task to start working on it. 
                        Once claimed, it will appear in your "My Tasks" list.
                    </p>
                </div>
            </div>

            <div class="flex gap-2 pt-4 mt-4 border-t border-neutral-700">
                <button @onclick="() => ClaimTask(selectedTask.Id)"
                        disabled="@isClaiming"
                        class="flex-1 bg-green-600 text-white rounded-lg py-2 px-4 hover:bg-green-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    @(isClaiming ? "Claiming..." : "Claim This Task")
                </button>
                
                <button @onclick="CloseModal"
                        disabled="@isClaiming"
                        class="flex-1 border border-gray-600 rounded-lg py-2 px-4 text-gray-200 hover:bg-gray-800 transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskDto>? tasks;
    private TaskDto? selectedTask;
    
    private bool isLoading = true;
    private bool isClaiming = false;
    
    private string selectedPriority = "";
    private string? claimMessage;
    private bool isClaimError;
    
    private PeriodicTimer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = Task.Run(async () =>
        {
            while (await refreshTimer.WaitForNextTickAsync())
            {
                await InvokeAsync(async () =>
                {
                    await LoadTasks(silent: true);
                    StateHasChanged();
                });
            }
        });
    }

    private async Task LoadTasks(bool silent = false)
    {
        if (!silent) isLoading = true;

        var allTasks = await TaskApi.GetPoolTasksAsync();
        
        // Filter by priority if selected
        if (!string.IsNullOrEmpty(selectedPriority) && allTasks != null)
        {
            int priorityFilter = int.Parse(selectedPriority);
            tasks = allTasks.Where(t => t.Priority == priorityFilter).ToList();
        }
        else
        {
            tasks = allTasks;
        }

        if (!silent) isLoading = false;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedTask = await TaskApi.GetTaskAsync(id);
        claimMessage = null;
        isClaimError = false;
    }

    private void CloseModal()
    {
        selectedTask = null;
        claimMessage = null;
        isClaimError = false;
    }

    private async Task ClaimTask(Guid id)
    {
        isClaiming = true;
        claimMessage = null;
        isClaimError = false;

        try
        {
            var result = await TaskApi.ClaimTaskAsync(id);
            
            if (result != null)
            {
                claimMessage = "Task claimed successfully! Redirecting to My Tasks...";
                isClaimError = false;
                await Task.Delay(1500);
                await LoadTasks();
                CloseModal();
            }
            else
            {
                claimMessage = "Failed to claim task. It may have been claimed by someone else.";
                isClaimError = true;
            }
        }
        catch (Exception ex)
        {
            claimMessage = $"Error: {ex.Message}";
            isClaimError = true;
        }
        finally
        {
            isClaiming = false;
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
