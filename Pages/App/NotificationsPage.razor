@page "/notifications"
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject NotificationApi NotificationApi
@inject NavigationManager Navigation

<div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Notifications</h1>
            @if (unreadCount > 0)
            {
                <button @onclick="MarkAllAsRead" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Mark All Read
                </button>
            }
        </div>

        @if (isLoading)
        {
            <div class="text-center py-8">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
                <p class="mt-2 text-gray-600">Loading notifications...</p>
            </div>
        }
        else if (notifications.Count == 0)
        {
            <div class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No notifications</h3>
                <p class="mt-1 text-sm text-gray-500">You're all caught up!</p>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var notification in notifications)
                {
                    <div class="@GetNotificationClasses(notification) rounded-lg cursor-pointer hover:shadow-md transition-all"
                         @onclick="() => HandleNotificationClick(notification)">
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="@GetTypeBadgeClasses(notification.Type)">
                                        @notification.Type
                                    </span>
                                    @if (!notification.IsRead)
                                    {
                                        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                                    }
                                </div>
                                <p class="@GetTitleClasses(notification) mt-2">@notification.Title</p>
                                <p class="text-sm text-gray-600 mt-1">@notification.Message</p>
                                <p class="text-xs text-gray-400 mt-2">@FormatDateTime(notification.CreatedAt)</p>
                            </div>
                            <button @onclick="(e) => DeleteNotification(notification.Id, e)" 
                                    @onclick:stopPropagation="true"
                                    class="ml-4 text-gray-400 hover:text-red-500 p-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private int unreadCount = 0;
    private List<NotificationDto> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        isLoading = true;
        notifications = await NotificationApi.GetNotificationsAsync(100);
        unreadCount = await NotificationApi.GetUnreadCountAsync();
        isLoading = false;
    }

    private async Task HandleNotificationClick(NotificationDto notification)
    {
        if (!notification.IsRead)
        {
            await NotificationApi.MarkAsReadAsync(notification.Id);
            notification.IsRead = true;
            unreadCount = Math.Max(0, unreadCount - 1);
        }

        if (!string.IsNullOrEmpty(notification.ActionUrl))
        {
            Navigation.NavigateTo(notification.ActionUrl);
        }
    }

    private async Task DeleteNotification(Guid id, MouseEventArgs e)
    {
        var notification = notifications.FirstOrDefault(n => n.Id == id);
        if (notification != null)
        {
            if (!notification.IsRead)
            {
                unreadCount = Math.Max(0, unreadCount - 1);
            }
            
            notifications.Remove(notification);
            await NotificationApi.DeleteNotificationAsync(id);
        }
    }

    private async Task MarkAllAsRead()
    {
        await NotificationApi.MarkAllAsReadAsync();
        foreach (var notification in notifications)
        {
            notification.IsRead = true;
        }
        unreadCount = 0;
    }

    private string GetNotificationClasses(NotificationDto notification)
    {
        return notification.IsRead 
            ? "p-4 border border-gray-200 bg-white" 
            : "p-4 border-2 border-blue-200 bg-blue-50";
    }

    private string GetTitleClasses(NotificationDto notification)
    {
        return notification.IsRead 
            ? "font-medium text-gray-900" 
            : "font-semibold text-gray-900";
    }

    private string GetTypeBadgeClasses(string type)
    {
        return type.ToLower() switch
        {
            "cashadvance" => "px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800",
            "liquidation" => "px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800",
            "task" => "px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800",
            "announcement" => "px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800",
            _ => "px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800"
        };
    }

    private string FormatDateTime(DateTimeOffset time)
    {
        var local = time.ToLocalTime();
        var diff = DateTimeOffset.Now - time;
        
        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} minutes ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} hours ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays} days ago";
        
        return local.ToString("MMMM dd, yyyy 'at' h:mm tt");
    }
}
