@page "/admin/create-employee"
@using OfficeCore.Client.Models.Dtos

@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi

<div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-4 sm:p-6">
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-white">Employees</h1>
    <p class="mt-1 text-sm text-neutral-400">Create a new employee profile and default settings.</p>
</div>

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else
{
    <div class="mt-6 max-w-xl rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
        <h2 class="font-semibold text-white">Create Employee</h2>

        <div class="mt-4 grid grid-cols-1 gap-3">
            <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Username" @bind="Req.Username" />

            <div class="grid grid-cols-2 gap-3">
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="First name" @bind="Req.FirstName" />
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Last name" @bind="Req.LastName" />
            </div>

            <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Department" @bind="Req.Department" />
            <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Position" @bind="Req.Position" />

            <div class="grid grid-cols-3 gap-3">
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" type="number" placeholder="Biometric ID" @bind="Req.BiometricId" />
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" type="number" step="0.01" placeholder="Daily rate" @bind="Req.DailyRate" />
            </div>

            <div>
                <label class="text-sm text-gray-300">Schedule</label>
                <select class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2 w-full" @bind="SelectedSchedule">
                    <option value="8-5">8:00 am - 5:00 pm</option>
                    <option value="9-6">9:00 am - 6:00 pm</option>
                    <option value="none">None</option>
                </select>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="Req.IsOTEnabled" />
                OT Enabled
            </label>

            <div class="border border-neutral-700 rounded-lg p-3 bg-neutral-900">
                <p class="text-sm font-semibold mb-2 text-gray-200">Government Deductions</p>
                <div class="grid grid-cols-3 gap-2">
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="Req.HasSSSDeduction" />
                        SSS
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="Req.HasPhilHealthDeduction" />
                        PhilHealth
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="Req.HasPagIBIGDeduction" />
                        Pag-IBIG
                    </label>
                </div>
            </div>

                 <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2"
                   placeholder="Roles (comma separated: HR,Payroll)"
                   @bind="RolesInput" />

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="text-sm @(IsError ? "text-red-600" : "text-green-700")">@Message</div>
            }

            <button class="rounded-lg border border-amber-400/40 bg-amber-400/20 py-2 text-amber-200 transition hover:bg-amber-400/30"
                    @onclick="CreateNewEmployee">
                Create
            </button>
        </div>
    </div>
}

@code {
    private CreateEmployeeRequest Req = new();
    private string RolesInput = "";
    private string SelectedSchedule = "8-5";
    private string? Message;
    private bool IsError;

    protected override void OnInitialized()
    {
        if (AuthState.UserType != "Admin")
        {
            Nav.NavigateTo("/login", true);
        }
    }

    private async Task CreateNewEmployee()
    {
        Message = null;

        // set default temp password and apply schedule selection
        Req.TempPassword = "password";

        Req.Roles = RolesInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        // map schedule dropdown to time fields
        if (SelectedSchedule == "8-5")
        {
            Req.SchedTimeIn = TimeOnly.Parse("08:00");
            Req.SchedTimeOut = TimeOnly.Parse("17:00");
        }
        else if (SelectedSchedule == "9-6")
        {
            Req.SchedTimeIn = TimeOnly.Parse("09:00");
            Req.SchedTimeOut = TimeOnly.Parse("18:00");
        }
        else
        {
            Req.SchedTimeIn = null;
            Req.SchedTimeOut = null;
        }

        var ok = await AdminApi.CreateEmployeeAsync(Req);

        IsError = !ok;
        Message = ok ? "Employee created." : "Failed to create employee (check token/roles/server).";
    }
}
