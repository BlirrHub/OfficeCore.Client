@page "/admin/employees"
@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi
@using OfficeCore.Client.Features.Employees

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else
{
    <div class="mt-6 max-w-7xl bg-white border rounded-xl p-4">
        <div class="flex justify-between items-center mb-4">
            <h1 class="text-2xl font-bold">Employees</h1>
            <button class="bg-black text-white border rounded-2xl p-2 px-6 py-2 hover:bg-gray-800" 
                    @onclick="NavigateToCreateEmployee">
                Create Employee
            </button>
        </div>

        @if (isLoading)
        {
            <p>Loading employees...</p>
        }
        else if (employees == null || !employees.Any())
        {
            <p class="text-gray-500">No employees found.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Name
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Department
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Position
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Roles
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Status
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var employee in employees)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @employee.FirstName @employee.LastName
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @(employee.Department ?? "-")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @(employee.Position ?? "-")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @if (employee.Roles?.Any() == true)
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var role in employee.Roles)
                                            {
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                                                    @role
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">No roles</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    @if (employee.IsActive)
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <button class="text-indigo-600 hover:text-indigo-900" 
                                            @onclick="@(() => Nav.NavigateTo($"/admin/employees/{employee.Id}"))">
                                        Edit
                                    </button>
                                    <button class="text-indigo-600 hover:text-indigo-900" 
                                            @onclick="@(() => DeleteEmployee(employee.Id))">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code 
{
    private List<Employee>? employees;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.UserType == "Admin")
        {
            await GetEmployees();
        }
    }

    private void NavigateToCreateEmployee()
    {
        Nav.NavigateTo("/admin/create-employee");
    }

    private async Task GetEmployees()
    {
        isLoading = true;
        employees = await AdminApi.GetAllEmployeesAsync();
        isLoading = false;
    }

    private async Task DeleteEmployee(Guid id)
    {
        var ok = await AdminApi.DeleteEmployeeAsync(id);
        if (ok)
            await GetEmployees();
    }
}
