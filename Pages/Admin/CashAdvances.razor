@page "/admin/cash-advances"
@attribute [Authorize(Roles = "Admin")]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject CashAdvanceAdminApi CashAdvanceApi
@inject PettyCashAdminApi PettyCashApi

<div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-3 sm:p-4 flex flex-col">
    <h1 class="text-xl sm:text-2xl text-white font-bold mb-4">Cash Advance Requests</h1>

    <div class="mb-4 flex gap-4 items-end flex-shrink-0">
        <div class="flex-1">
            <label class="block text-xs text-gray-200 mb-1">Start Date</label>
            <input type="date" @bind="startDate" class="w-full border rounded-lg px-3 py-2 text-gray-200 bg-neutral-800" />
        </div>
        <div class="flex-1">
            <label class="block text-xs text-gray-200 mb-1">End Date</label>
            <input type="date" @bind="endDate" class="w-full border rounded-lg px-3 py-2 text-gray-200 bg-neutral-800" />
        </div>
        <button @onclick="LoadRequests" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Filter
        </button>
    </div>

    <div class="bg-neutral-800 rounded-lg mb-4 flex-shrink-0">
        <div class="border-b border-neutral-700">
            <nav class="flex -mb-px">
                <button @onclick="() => SelectTab(0)"
                        class="@(activeTab == 0 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Pending
                    @if (pendingCount > 0)
                    {
                        <span class="ml-2 bg-blue-100 text-blue-600 py-0.5 px-2 rounded-full text-xs">@pendingCount</span>
                    }
                </button>
                <button @onclick="() => SelectTab(1)"
                        class="@(activeTab == 1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Approved
                </button>
                <button @onclick="() => SelectTab(3)"
                        class="@(activeTab == 3 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Paid
                </button>
                <button @onclick="() => SelectTab(2)"
                        class="@(activeTab == 2 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Rejected
                </button>
                <button @onclick="() => SelectTab(-1)"
                        class="@(activeTab == -1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    All
                </button>
            </nav>
        </div>

        <div class="p-4 flex-1 overflow-auto">
            @if (isLoading)
            {
                <div class="text-center py-8">
                    <p class="text-white">Loading requests...</p>
                </div>
            }
            else if (filteredRequests == null || !filteredRequests.Any())
            {
                <div class="text-center py-8">
                    <p class="text-gray-400">No cash advance requests found.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full divide-y divide-neutral-500">
                        <thead class="bg-neutral-900 sticky top-0 z-10">
                            <tr>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider bg-neutral-950">Employee</th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">Request Date</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Amount</th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">Reason</th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">Status</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-neutral-600 divide-y divide-neutral-500">
                            @foreach (var ca in filteredRequests)
                            {
                                <tr class="hover:bg-neutral-800">
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm font-medium text-gray-50 bg-neutral-700">
                                        @($"{ca.EmployeeFirstName} {ca.EmployeeLastName}")
                                    </td>
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-200">
                                        @ca.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right font-bold text-gray-50">
                                        ₱@ca.Amount.ToString("N2")
                                    </td>
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 text-xs sm:text-sm text-gray-200 max-w-xs truncate">
                                        @ca.Reason
                                    </td>
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                        @if (ca.Status == 0)
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-800 text-yellow-100">
                                                Pending
                                            </span>
                                        }
                                        else if (ca.Status == 1)
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-800 text-green-100">
                                                Approved
                                            </span>
                                        }
                                        else if (ca.Status == 2)
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-800 text-red-100">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-800 text-blue-100">
                                                Paid
                                            </span>
                                        }
                                    </td>
                                    <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm font-medium text-right">
                                        <button @onclick="() => ViewDetails(ca.Id)"
                                                class="text-blue-400 hover:text-blue-300">
                                            View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (selectedRequest != null)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" @onclick="CloseModal">
        <div class="relative top-20 mx-auto p-5 border border-neutral-700 w-11/12 max-w-2xl shadow-lg rounded-md bg-neutral-800" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Cash Advance Request</h3>
                    <p class="text-sm text-gray-400">@($"{selectedRequest.EmployeeFirstName} {selectedRequest.EmployeeLastName}")</p>
                </div>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <div class="p-4 bg-neutral-700 rounded mb-4">
                    <p class="text-sm text-gray-400">Requested Amount</p>
                    <p class="text-3xl font-bold text-blue-400">₱@selectedRequest.Amount.ToString("N2")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-300 mb-1">Request Date</label>
                    <p class="text-gray-50">@selectedRequest.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</p>
                </div>

                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-300 mb-1">Reason</label>
                    <p class="text-gray-50">@selectedRequest.Reason</p>
                </div>

                @if (selectedRequest.Status != 0)
                {
                    <div class="mb-3">
                        <label class="block text-sm font-medium text-gray-300 mb-1">
                            @(selectedRequest.Status == 1 ? "Approved" : "Rejected") On
                        </label>
                        <p class="text-gray-50">
                            @selectedRequest.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                    </div>
                }

                @if (selectedRequest.Status == 3)
                {
                    <div class="mb-3 p-3 bg-green-900 rounded">
                        <label class="block text-sm font-medium text-green-300 mb-1">Paid On</label>
                        <p class="text-green-100 font-semibold">@selectedRequest.PaidAt?.ToString("MMMM dd, yyyy hh:mm tt")</p>
                    </div>
                }

                @if (selectedRequest.PayrollWeekStart.HasValue)
                {
                    <div class="mb-3 p-3 bg-purple-50 rounded">
                        <label class="block text-sm font-medium text-purple-700 mb-1">Included in Payroll</label>
                        <p class="text-purple-900 font-semibold">Week starting @selectedRequest.PayrollWeekStart.Value.ToString("MMM dd, yyyy")</p>
                    </div>
                }
            </div>

            @if (selectedRequest.Status == 0)
            {
                <div class="mt-6 flex gap-3">
                    <button @onclick="ApproveSelected" disabled="@isSaving"
                            class="flex-1 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 disabled:opacity-50">
                        @(isSaving ? "Processing..." : "Approve")
                    </button>
                    <button @onclick="RejectSelected" disabled="@isSaving"
                            class="flex-1 bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 disabled:opacity-50">
                        Reject
                    </button>
                </div>
            }
            else if (selectedRequest.Status == 1)
            {
                <div class="mt-6">
                    <button @onclick="MarkAsPaid" disabled="@isSaving"
                            class="w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 disabled:opacity-50">
                        @(isSaving ? "Processing..." : "Mark as Paid")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<CashAdvanceDto>? cashAdvances;
    private List<CashAdvanceDto>? filteredRequests;
    private CashAdvanceDto? selectedRequest;
    private bool isLoading;
    private bool isSaving;
    private int activeTab = 0; // 0=Pending, 1=Approved, 2=Rejected, 3=Paid, -1=All
    private int pendingCount = 0;
    private DateOnly? startDate;
    private DateOnly? endDate;

    protected override async Task OnInitializedAsync()
    {
        // Default to current month
        var today = DateTime.Today;
        startDate = new DateOnly(today.Year, today.Month, 1);
        endDate = DateOnly.FromDateTime(today);

        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;

        if (activeTab == 0)
        {
            cashAdvances = await CashAdvanceApi.GetPendingRequestsAsync();
        }
        else
        {
            var statusFilter = activeTab == -1 ? null : (int?)activeTab;
            cashAdvances = await CashAdvanceApi.GetRequestsAsync(startDate, endDate, statusFilter);
        }

        pendingCount = cashAdvances?.Count(ca => ca.Status == 0) ?? 0;
        ApplyFilter();
        isLoading = false;
    }

    private void ApplyFilter()
    {
        if (cashAdvances == null)
        {
            filteredRequests = null;
            return;
        }

        filteredRequests = activeTab switch
        {
            0 => cashAdvances.Where(ca => ca.Status == 0).ToList(),
            1 => cashAdvances.Where(ca => ca.Status == 1).ToList(),
            2 => cashAdvances.Where(ca => ca.Status == 2).ToList(),
            3 => cashAdvances.Where(ca => ca.Status == 3).ToList(),
            _ => cashAdvances
        };
    }

    private async Task SelectTab(int tab)
    {
        activeTab = tab;
        await LoadRequests();
    }

    private async Task ViewDetails(Guid id)
    {
        selectedRequest = await CashAdvanceApi.GetRequestAsync(id);
    }

    private async Task ApproveSelected()
    {
        if (selectedRequest == null) return;

        isSaving = true;
        var result = await CashAdvanceApi.ApproveRequestAsync(selectedRequest.Id);
        isSaving = false;

        if (result != null)
        {
            selectedRequest = result;
            await LoadRequests();
        }
    }

    private async Task RejectSelected()
    {
        if (selectedRequest == null) return;

        isSaving = true;
        var result = await CashAdvanceApi.RejectRequestAsync(selectedRequest.Id);
        isSaving = false;

        if (result != null)
        {
            selectedRequest = result;
            await LoadRequests();
        }
    }

    private async Task MarkAsPaid()
    {
        if (selectedRequest == null) return;

        isSaving = true;
        var result = await CashAdvanceApi.MarkAsPaidAsync(selectedRequest.Id);
        isSaving = false;

        if (result != null)
        {
            selectedRequest = result;
            await LoadRequests();
            
            // Recalculate petty cash for the paid date
            if (result.PaidAt.HasValue)
            {
                var paidDate = DateOnly.FromDateTime(result.PaidAt.Value.DateTime);
                await PettyCashApi.RecalculateBalanceAsync(paidDate);
            }
        }
    }

    private void CloseModal()
    {
        selectedRequest = null;
    }
}
