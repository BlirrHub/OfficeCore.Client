@page "/admin/employees/{Id:guid}"
@using OfficeCore.Client.Features.Employees

@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else if (isLoading)
{
    <p>Loading employee...</p>
}
else if (employee is null)
{
    <p class="text-gray-500">Employee not found.</p>
}
else
{
    <div class="mt-6 max-w-xl rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-semibold tracking-tight text-white">Edit Employee</h1>
            <button class="text-amber-300 hover:text-amber-200" @onclick="BackToList">Back</button>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3">
            <div class="text-sm text-gray-400">Username: <span class="text-gray-100 font-medium">@employee.Username</span></div>

            <div class="grid grid-cols-2 gap-3">
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="First name" @bind="employee.FirstName" />
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Last name" @bind="employee.LastName" />
            </div>

            <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Department" @bind="employee.Department" />
            <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" placeholder="Position" @bind="employee.Position" />

            <div class="grid grid-cols-2 gap-3">
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" type="number" placeholder="Biometric ID" @bind="employee.BiometricId" />
                <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2" type="number" step="0.01" placeholder="Daily rate" @bind="employee.DailyRate" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-sm text-gray-300">Schedule Time In</label>
                    <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2 w-full" type="time" @bind="employee.SchedTimeIn" />
                </div>
                <div>
                    <label class="text-sm text-gray-300">Schedule Time Out</label>
                    <input class="border border-neutral-700 bg-neutral-900 text-gray-100 rounded-lg px-3 py-2 w-full" type="time" @bind="employee.SchedTimeOut" />
                </div>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsOTEnabled" />
                OT Enabled
            </label>

            <div class="border border-neutral-700 rounded-lg p-3 bg-neutral-900">
                <p class="text-sm font-semibold mb-2 text-gray-200">Government Deductions</p>
                <div class="grid grid-cols-3 gap-2">
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasSSSDeduction" />
                        SSS
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasPhilHealthDeduction" />
                        PhilHealth
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasPagIBIGDeduction" />
                        Pag-IBIG
                    </label>
                </div>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsActive" />
                Active
            </label>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="text-sm @(isError ? "text-red-600" : "text-green-700")">@message</div>
            }

            <div class="flex gap-2">
                <button class="rounded-lg border border-amber-400/40 bg-amber-400/20 py-2 px-4 text-amber-200 transition hover:bg-amber-400/30" @onclick="Save">Save</button>

                <button class="rounded-lg border border-red-400/40 bg-red-500/10 py-2 px-4 text-red-300 transition hover:bg-red-500/20" @onclick="Delete">
                    @(confirmDelete ? "Click again to confirm" : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Employee? employee;
    private bool isLoading = true;

    private string? message;
    private bool isError;

    private bool confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        confirmDelete = false;
        message = null;

        if (AuthState.UserType != "Admin")
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        isLoading = true;
        employee = await AdminApi.GetEmployeeByIdAsync(Id);
        isLoading = false;
    }

    private void BackToList() => Nav.NavigateTo("/admin/employees");

    private async Task Save()
    {
        if (employee is null)
            return;

        message = null;
        confirmDelete = false;

        var ok = await AdminApi.UpdateEmployeeAsync(Id, employee);
        isError = !ok;
        message = ok ? "Employee updated." : "Failed to update employee.";
    }

    private async Task Delete()
    {
        if (!confirmDelete)
        {
            confirmDelete = true;
            return;
        }

        var ok = await AdminApi.DeleteEmployeeAsync(Id);
        if (ok)
        {
            Nav.NavigateTo("/admin/employees", true);
            return;
        }

        isError = true;
        message = "Failed to delete employee.";
        confirmDelete = false;
    }
}
