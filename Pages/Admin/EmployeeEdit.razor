@page "/admin/employees/{Id:guid}"
@using OfficeCore.Client.Features.Employees

@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else if (isLoading)
{
    <p>Loading employee...</p>
}
else if (employee is null)
{
    <p class="text-gray-500">Employee not found.</p>
}
else
{
    <div class="mt-6 max-w-xl bg-white border rounded-xl p-4">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold">Edit Employee</h1>
            <button class="text-indigo-600 hover:text-indigo-900" @onclick="BackToList">Back</button>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3">
            <div class="text-sm text-gray-500">Username: <span class="text-gray-900 font-medium">@employee.Username</span></div>

            <div class="grid grid-cols-2 gap-3">
                <input class="border rounded-lg px-3 py-2" placeholder="First name" @bind="employee.FirstName" />
                <input class="border rounded-lg px-3 py-2" placeholder="Last name" @bind="employee.LastName" />
            </div>

            <input class="border rounded-lg px-3 py-2" placeholder="Department" @bind="employee.Department" />
            <input class="border rounded-lg px-3 py-2" placeholder="Position" @bind="employee.Position" />

            <div class="grid grid-cols-3 gap-3">
                <input class="border rounded-lg px-3 py-2" type="number" placeholder="Biometric ID" @bind="employee.BiometricId" />
                <input class="border rounded-lg px-3 py-2" type="number" step="0.01" placeholder="Daily rate" @bind="employee.DailyRate" />
                <input class="border rounded-lg px-3 py-2" type="number" step="0.01" placeholder="Std hours/day" @bind="employee.StdHoursPerDay" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-sm text-gray-600">Schedule Time In</label>
                    <input class="border rounded-lg px-3 py-2 w-full" type="time" @bind="employee.SchedTimeIn" />
                </div>
                <div>
                    <label class="text-sm text-gray-600">Schedule Time Out</label>
                    <input class="border rounded-lg px-3 py-2 w-full" type="time" @bind="employee.SchedTimeOut" />
                </div>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsOTEnabled" />
                OT Enabled
            </label>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsActive" />
                Active
            </label>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="text-sm @(isError ? "text-red-600" : "text-green-700")">@message</div>
            }

            <div class="flex gap-2">
                <button class="bg-black text-white rounded-lg py-2 px-4" @onclick="Save">Save</button>

                <button class="border rounded-lg py-2 px-4 text-red-700" @onclick="Delete">
                    @(confirmDelete ? "Click again to confirm" : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Employee? employee;
    private bool isLoading = true;

    private string? message;
    private bool isError;

    private bool confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        confirmDelete = false;
        message = null;

        if (AuthState.UserType != "Admin")
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        employee = await AdminApi.GetEmployeeByIdAsync(Id);
        isLoading = false;
    }

    private void BackToList() => Nav.NavigateTo("/admin/employees");

    private async Task Save()
    {
        if (employee is null)
            return;

        message = null;
        confirmDelete = false;

        var ok = await AdminApi.UpdateEmployeeAsync(Id, employee);
        isError = !ok;
        message = ok ? "Employee updated." : "Failed to update employee.";
    }

    private async Task Delete()
    {
        if (!confirmDelete)
        {
            confirmDelete = true;
            return;
        }

        var ok = await AdminApi.DeleteEmployeeAsync(Id);
        if (ok)
        {
            Nav.NavigateTo("/admin/employees", true);
            return;
        }

        isError = true;
        message = "Failed to delete employee.";
        confirmDelete = false;
    }
}
