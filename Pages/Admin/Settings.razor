@page "/admin/settings"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Nav

<div class="flex h-[calc(100vh-120px)] flex-col overflow-auto rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5">
    <section class="rounded-3xl border border-neutral-800 bg-[radial-gradient(circle_at_top_left,_rgba(245,158,11,0.13),_transparent_32%),linear-gradient(135deg,_rgba(23,23,23,0.98),_rgba(10,10,10,1))] p-4 sm:p-6">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-3xl">
                <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-amber-300">
                    Admin Settings Hub
                </div>
                <h1 class="text-2xl font-semibold tracking-tight text-white sm:text-4xl">Configure operations, policy, and organization data.</h1>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-300 sm:text-base">
                    Use this page as your command center for the parts of OfficeCore that influence daily operations.
                </p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
                <p class="text-xs uppercase tracking-[0.18em] text-neutral-400">Last reviewed</p>
                <p class="mt-2 text-lg font-semibold text-white">@DateTime.Now.ToString("MMMM dd, yyyy")</p>
                <p class="mt-1 text-xs text-neutral-400">Keep defaults aligned with active policies.</p>
            </div>
        </div>
    </section>

    <div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
        <div class="grid gap-4 content-start">
            <section class="grid gap-4 md:grid-cols-2">
                <button @onclick='() => Nav.NavigateTo("/admin/organization")' class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-sky-500/40 hover:bg-neutral-900/90">
                    <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Organization</p>
                    <p class="mt-2 text-xl font-semibold text-white">Departments, positions, and roles</p>
                    <p class="mt-3 text-sm text-neutral-400">Maintain structural data used across attendance, payroll, and assignments.</p>
                </button>

                <button @onclick='() => Nav.NavigateTo("/admin/employees")' class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-emerald-500/40 hover:bg-neutral-900/90">
                    <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Employee policy</p>
                    <p class="mt-2 text-xl font-semibold text-white">Activation and profile defaults</p>
                    <p class="mt-3 text-sm text-neutral-400">Control employee setup quality and role assignments for clean access control.</p>
                </button>

                <button @onclick='() => Nav.NavigateTo("/admin/payroll-weekly")' class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-amber-500/40 hover:bg-neutral-900/90">
                    <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Payroll settings</p>
                    <p class="mt-2 text-xl font-semibold text-white">Weekly payroll controls</p>
                    <p class="mt-3 text-sm text-neutral-400">Review payroll flow and deductions before releasing weekly runs.</p>
                </button>

                <button @onclick='() => Nav.NavigateTo("/admin/petty-cash")' class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-fuchsia-500/40 hover:bg-neutral-900/90">
                    <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Finance controls</p>
                    <p class="mt-2 text-xl font-semibold text-white">Petty cash and approvals</p>
                    <p class="mt-3 text-sm text-neutral-400">Supervise available cash, issuance flow, and reimbursement consistency.</p>
                </button>
            </section>

            <section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
                <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Operational checklist</p>
                <h2 class="mt-2 text-xl font-semibold text-white">Daily admin readiness</h2>

                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                    <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
                        <p class="text-sm font-medium text-white">Attendance and payroll alignment</p>
                        <p class="mt-1 text-xs text-neutral-400">Confirm attendance imports are clean before payroll processing.</p>
                    </div>
                    <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
                        <p class="text-sm font-medium text-white">Approval queue cadence</p>
                        <p class="mt-1 text-xs text-neutral-400">Set a daily schedule for cash advances and liquidations review.</p>
                    </div>
                    <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
                        <p class="text-sm font-medium text-white">Role and access hygiene</p>
                        <p class="mt-1 text-xs text-neutral-400">Audit elevated roles periodically to reduce permission drift.</p>
                    </div>
                    <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
                        <p class="text-sm font-medium text-white">Task operations policy</p>
                        <p class="mt-1 text-xs text-neutral-400">Keep task priority and review standards consistent per team.</p>
                    </div>
                </div>
            </section>
        </div>

        <div class="grid gap-4 content-start">
            <section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
                <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Quick actions</p>
                <h2 class="mt-2 text-xl font-semibold text-white">Jump to admin modules</h2>

                <div class="mt-5 grid gap-3">
                    <button @onclick='() => Nav.NavigateTo("/admin/dashboard")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
                        <span class="text-sm font-medium text-white">Dashboard</span>
                        <span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
                    </button>
                    <button @onclick='() => Nav.NavigateTo("/admin/tasks")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
                        <span class="text-sm font-medium text-white">Task administration</span>
                        <span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
                    </button>
                    <button @onclick='() => Nav.NavigateTo("/admin/cash-advances")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
                        <span class="text-sm font-medium text-white">Cash advances</span>
                        <span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
                    </button>
                    <button @onclick='() => Nav.NavigateTo("/admin/daily-liquidations")' class="flex items-center justify-between rounded-2xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-left transition hover:border-neutral-600 hover:bg-neutral-900">
                        <span class="text-sm font-medium text-white">Daily liquidations</span>
                        <span class="text-xs uppercase tracking-[0.14em] text-neutral-500">Open</span>
                    </button>
                </div>
            </section>

            <section class="rounded-3xl border border-neutral-800 bg-neutral-900 p-5">
                <p class="text-xs uppercase tracking-[0.16em] text-neutral-500">Admin account</p>
                <h2 class="mt-2 text-xl font-semibold text-white">Security and profile</h2>

                <div class="mt-5 rounded-2xl border border-neutral-800 bg-neutral-950 p-4">
                    <p class="text-sm text-neutral-300">Update your password and profile details from the profile page.</p>
                    <button @onclick='() => Nav.NavigateTo("/profile")' class="mt-4 rounded-xl border border-neutral-700 bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-800">
                        Open profile
                    </button>
                </div>
            </section>
        </div>
    </div>
</div>
