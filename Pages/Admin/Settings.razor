@page "/admin/settings"
@inject IJSRuntime JSRuntime

<div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-4 flex flex-col">
    <div class="mb-4 flex-shrink-0">
        <h1 class="text-2xl text-white font-bold">System Settings</h1>
        <p class="text-gray-400 text-sm mt-1">Application preferences and configuration</p>
    </div>

    <div class="flex-1 overflow-auto">
        <div class="max-w-3xl">
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-6 mb-4">
                <h2 class="text-lg font-semibold text-white mb-4">General Settings</h2>
                <p class="text-gray-400 text-sm">General application settings will appear here.</p>
            </div>

            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-6">
                <h2 class="text-lg font-semibold text-white mb-4">Organization Management</h2>
                <p class="text-gray-400 text-sm mb-3">
                    Manage departments, positions, and roles in the dedicated Organization page.
                </p>
                <a href="/admin/organization" 
                   class="inline-flex items-center gap-2 bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    Go to Organization Management
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    // Add general settings logic here as needed
}
