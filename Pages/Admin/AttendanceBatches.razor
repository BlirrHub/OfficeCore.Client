@page "/admin/attendance-batches"
@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi
@using OfficeCore.Client.Models.Dtos

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else
{
    <div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-3 sm:p-4 flex flex-col">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4 flex-shrink-0">
            <div>
                <h1 class="text-xl sm:text-2xl text-white font-bold">Import Batches</h1>
                <p class="text-xs sm:text-sm text-gray-200">View and manage attendance import batches.</p>
            </div>
            <button class="w-full sm:w-auto bg-blue-600 text-white rounded-lg py-2 px-4 hover:bg-blue-700 text-sm sm:text-base" 
                    @onclick="@(() => Nav.NavigateTo("/admin/attendance-weekly"))">
                Go to Weekly Attendance
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="text-xs sm:text-sm mb-3 p-3 rounded-lg flex-shrink-0 @(IsError ? "bg-red-600 text-white" : "bg-green-600 text-white")">
                @Message
            </div>
        }

        @if (isLoading)
        {
            <p class="text-white text-sm">Loading batches...</p>
        }
        else if (batches is null || !batches.Any())
        {
            <div class="text-center py-8 sm:py-12">
                <svg class="w-12 h-12 sm:w-16 sm:h-16 mx-auto text-gray-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <p class="text-sm text-gray-400">No import batches found.</p>
            </div>
        }
        else
        {
            <div class="flex-1 overflow-auto border border-neutral-900 rounded-lg">
                <div class="inline-block w-full align-middle">
                    <table class="w-full divide-y divide-neutral-500">
                        <thead class="bg-neutral-950">
                            <tr>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">
                                    Imported
                                </th>
                                <th class="hidden md:table-cell px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">
                                    File Name
                                </th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">
                                    Week
                                </th>
                                <th class="hidden lg:table-cell px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">
                                    Records
                                </th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">
                                    Status
                                </th>
                                <th class="px-2 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-neutral-600 divide-y divide-neutral-500">
                        @foreach (var batch in batches)
                        {
                            <tr class="hover:bg-neutral-800">
                                <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-50">
                                    <div>@batch.ImportedAtUtc.ToLocalTime().ToString("MM/dd/yyyy")</div>
                                    <div class="text-xs text-gray-400">@batch.ImportedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                                    <div class="md:hidden text-xs text-gray-300 mt-1 truncate max-w-[150px]" title="@batch.OriginalFileName">
                                        @batch.OriginalFileName
                                    </div>
                                </td>
                                <td class="hidden md:table-cell px-3 sm:px-6 py-3 sm:py-4 text-xs sm:text-sm text-gray-200">
                                    <div class="max-w-xs truncate" title="@batch.OriginalFileName">
                                        @batch.OriginalFileName
                                    </div>
                                </td>
                                <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-200">
                                    <div class="hidden sm:block">@batch.WeekStart.ToString("MM/dd") - @batch.WeekEnd.ToString("MM/dd/yyyy")</div>
                                    <div class="sm:hidden">@batch.WeekStart.ToString("MM/dd") - @batch.WeekEnd.ToString("MM/dd")</div>
                                    <div class="lg:hidden text-xs text-green-400 mt-1">✓ @batch.InsertedCount</div>
                                </td>
                                <td class="hidden lg:table-cell px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-200">
                                    <div class="space-y-1">
                                        <div>
                                            <span class="text-green-400">✓</span> @batch.InsertedCount inserted
                                        </div>
                                        @if (batch.SkippedDuplicateCount > 0)
                                        {
                                            <div class="text-xs">
                                                <span class="text-gray-400">○</span> @batch.SkippedDuplicateCount skipped
                                            </div>
                                        }
                                        @if (batch.UnmatchedEmployeeCount > 0)
                                        {
                                            <div class="text-xs text-orange-400">
                                                ⚠ @batch.UnmatchedEmployeeCount unmatched
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm">
                                    @if (batch.ErrorCount > 0)
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-600 text-white">
                                            @batch.ErrorCount errors
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-600 text-white">
                                            Success
                                        </span>
                                    }
                                </td>
                                <td class="px-2 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right">
                                    <button 
                                        class="inline-flex items-center justify-center px-2 sm:px-3 py-1.5 border border-red-300 rounded-md text-xs sm:text-sm font-medium text-red-700 bg-neutral-800 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" 
                                        @onclick="@(() => ConfirmDelete(batch.Id, batch.OriginalFileName))">
                                        <svg class="w-3 h-3 sm:w-4 sm:h-4 sm:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        <span class="hidden sm:inline">Delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        }
    </div>

    @* Delete Confirmation Modal *@
    @if (showDeleteConfirm)
    {
        <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" @onclick="CancelDelete">
            <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-xl" @onclick:stopPropagation="true">
                <div class="flex items-start mb-4">
                    <div class="flex-shrink-0">
                        <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <div class="ml-4 flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">Delete Import Batch</h3>
                        <p class="text-sm text-gray-600 mb-2">
                            Are you sure you want to delete the batch:
                        </p>
                        <p class="text-sm font-semibold text-gray-900 mb-3">
                            "@batchToDeleteName"
                        </p>
                        <p class="text-sm text-gray-600">
                            This will permanently remove all attendance records from this import.
                        </p>
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                    <button 
                        class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
                        @onclick="CancelDelete"
                        disabled="@isDeleting">
                        Cancel
                    </button>
                    <button 
                        class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 disabled:bg-gray-400"
                        @onclick="ExecuteDelete"
                        disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete Batch</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<AttendanceImportBatchDto>? batches;
    private bool isLoading = true;
    private string? Message;
    private bool IsError;

    // Delete confirmation state
    private bool showDeleteConfirm;
    private Guid batchToDeleteId;
    private string batchToDeleteName = "";
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.UserType != "Admin")
        {
            Nav.NavigateTo("/login", true);
            return;
        }
        
        await LoadBatches();
    }

    private async Task LoadBatches()
    {
        Message = null;
        IsError = false;
        isLoading = true;

        batches = await AdminApi.GetAllAttendanceBatchesAsync();

        if (batches is null)
        {
            IsError = true;
            Message = "Failed to load import batches.";
        }

        isLoading = false;
    }

    private void ConfirmDelete(Guid id, string fileName)
    {
        batchToDeleteId = id;
        batchToDeleteName = fileName;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        batchToDeleteId = Guid.Empty;
        batchToDeleteName = "";
    }

    private async Task ExecuteDelete()
    {
        if (batchToDeleteId == Guid.Empty)
            return;

        isDeleting = true;
        Message = null;
        IsError = false;

        var success = await AdminApi.DeleteAttendanceBatchAsync(batchToDeleteId);

        if (success)
        {
            Message = "Batch deleted successfully.";
            IsError = false;
            CancelDelete();
            await LoadBatches();
        }
        else
        {
            Message = "Failed to delete batch.";
            IsError = true;
        }

        isDeleting = false;
    }
}
