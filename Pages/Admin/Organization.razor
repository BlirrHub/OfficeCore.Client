@page "/admin/organization"
@using OfficeCore.Client.Models.Dtos
@inject OfficeCore.Client.Services.Api.SettingsApi SettingsApi
@inject IJSRuntime JSRuntime

<div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-4 flex flex-col">
    <div class="mb-4 flex-shrink-0">
        <h1 class="text-2xl text-white font-bold">Organization Management</h1>
        <p class="text-gray-400 text-sm mt-1">Manage departments, positions, and roles</p>
    </div>

    <div class="flex-1 overflow-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <!-- Departments Section -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-white">Departments</h2>
                    <button @onclick="ShowCreateDepartment" 
                            class="bg-black text-white px-3 py-1.5 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                        + Add
                    </button>
                </div>

                @if (isLoadingDepartments)
                {
                    <p class="text-gray-400 text-sm">Loading...</p>
                }
                else
                {
                    <div class="space-y-2 max-h-[500px] overflow-y-auto">
                        @foreach (var dept in departments)
                        {
                            <div class="flex items-center justify-between bg-neutral-700 border border-neutral-600 rounded-lg p-3 hover:bg-neutral-600">
                                @if (editingDepartmentId == dept.Id)
                                {
                                    <input @bind-value="editingDepartmentName" 
                                           @bind-value:event="oninput"
                                           class="bg-neutral-900 border border-neutral-500 rounded px-2 py-1 text-sm flex-1 mr-2 text-white" />
                                    <div class="flex gap-2">
                                        <button @onclick="() => SaveDepartment(dept.Id)" 
                                                class="text-green-400 hover:text-green-300 text-xs font-semibold">
                                            Save
                                        </button>
                                        <button @onclick="CancelEditDepartment" 
                                                class="text-gray-400 hover:text-gray-300 text-xs font-semibold">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-white">@dept.Name</span>
                                    <div class="flex gap-2">
                                        <button @onclick="() => EditDepartment(dept)" 
                                                class="text-blue-400 hover:text-blue-300 text-xs font-semibold">
                                            Edit
                                        </button>
                                        <button @onclick="() => DeleteDepartment(dept.Id)" 
                                                class="text-red-400 hover:text-red-300 text-xs font-semibold">
                                            Delete
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (departments.Count == 0)
                        {
                            <p class="text-gray-500 text-sm text-center py-4">No departments yet</p>
                        }
                    </div>

                    @if (showCreateDepartment)
                    {
                        <div class="mt-4 p-3 border border-neutral-600 rounded-lg bg-neutral-900">
                            <input @bind-value="newDepartmentName" 
                                   @bind-value:event="oninput"
                                   placeholder="Department name..." 
                                   class="bg-neutral-800 border border-neutral-600 rounded px-3 py-2 text-sm w-full mb-2 text-white placeholder-gray-500" />
                            <div class="flex gap-2">
                                <button @onclick="CreateDepartment" 
                                        class="bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                                    Create
                                </button>
                                <button @onclick="() => showCreateDepartment = false" 
                                        class="border border-neutral-600 px-4 py-2 rounded-lg text-sm hover:bg-neutral-800 text-gray-300">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Positions Section -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-white">Positions</h2>
                    <button @onclick="ShowCreatePosition" 
                            class="bg-black text-white px-3 py-1.5 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                        + Add
                    </button>
                </div>

                @if (isLoadingPositions)
                {
                    <p class="text-gray-400 text-sm">Loading...</p>
                }
                else
                {
                    <div class="space-y-2 max-h-[500px] overflow-y-auto">
                        @foreach (var pos in positions)
                        {
                            <div class="bg-neutral-700 border border-neutral-600 rounded-lg p-3 hover:bg-neutral-600">
                                @if (editingPositionId == pos.Id)
                                {
                                    <div class="space-y-2">
                                        <input @bind-value="editingPositionName" 
                                               @bind-value:event="oninput"
                                               placeholder="Position name"
                                               class="bg-neutral-900 border border-neutral-500 rounded px-2 py-1 text-sm w-full text-white" />
                                        <select @bind="editingPositionDepartmentId" 
                                                class="bg-neutral-900 border border-neutral-500 rounded px-2 py-1 text-sm w-full text-white">
                                            <option value="">Select Department</option>
                                            @foreach (var dept in departments)
                                            {
                                                <option value="@dept.Id">@dept.Name</option>
                                            }
                                        </select>
                                        <div class="flex gap-2">
                                            <button @onclick="() => SavePosition(pos.Id)" 
                                                    class="text-green-400 hover:text-green-300 text-xs font-semibold">
                                                Save
                                            </button>
                                            <button @onclick="CancelEditPosition" 
                                                    class="text-gray-400 hover:text-gray-300 text-xs font-semibold">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <div class="text-sm text-white">@pos.Name</div>
                                            <div class="text-xs text-gray-400">@pos.DepartmentName</div>
                                        </div>
                                        <div class="flex gap-2">
                                            <button @onclick="() => EditPosition(pos)" 
                                                    class="text-blue-400 hover:text-blue-300 text-xs font-semibold">
                                                Edit
                                            </button>
                                            <button @onclick="() => DeletePosition(pos.Id)" 
                                                    class="text-red-400 hover:text-red-300 text-xs font-semibold">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (positions.Count == 0)
                        {
                            <p class="text-gray-500 text-sm text-center py-4">No positions yet</p>
                        }
                    </div>

                    @if (showCreatePosition)
                    {
                        <div class="mt-4 p-3 border border-neutral-600 rounded-lg bg-neutral-900 space-y-2">
                            <input @bind-value="newPositionName" 
                                   @bind-value:event="oninput"
                                   placeholder="Position name..." 
                                   class="bg-neutral-800 border border-neutral-600 rounded px-3 py-2 text-sm w-full text-white placeholder-gray-500" />
                            <select @bind="newPositionDepartmentId" 
                                    class="bg-neutral-800 border border-neutral-600 rounded px-3 py-2 text-sm w-full text-white">
                                <option value="">Select Department</option>
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            </select>
                            <div class="flex gap-2">
                                <button @onclick="CreatePosition" 
                                        class="bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                                    Create
                                </button>
                                <button @onclick="CancelCreatePosition" 
                                        class="border border-neutral-600 px-4 py-2 rounded-lg text-sm hover:bg-neutral-800 text-gray-300">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Roles Section -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-white">Roles</h2>
                    <button @onclick="ShowCreateRole" 
                            class="bg-black text-white px-3 py-1.5 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                        + Add
                    </button>
                </div>

                @if (isLoadingRoles)
                {
                    <p class="text-gray-400 text-sm">Loading...</p>
                }
                else
                {
                    <div class="space-y-2 max-h-[500px] overflow-y-auto">
                        @foreach (var role in roles)
                        {
                            <div class="flex items-center justify-between bg-neutral-700 border border-neutral-600 rounded-lg p-3 hover:bg-neutral-600">
                                @if (editingRoleId == role.Id)
                                {
                                    <input @bind-value="editingRoleName" 
                                           @bind-value:event="oninput"
                                           class="bg-neutral-900 border border-neutral-500 rounded px-2 py-1 text-sm flex-1 mr-2 text-white" />
                                    <div class="flex gap-2">
                                        <button @onclick="() => SaveRole(role.Id)" 
                                                class="text-green-400 hover:text-green-300 text-xs font-semibold">
                                            Save
                                        </button>
                                        <button @onclick="CancelEditRole" 
                                                class="text-gray-400 hover:text-gray-300 text-xs font-semibold">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-white">@role.Name</span>
                                    <div class="flex gap-2">
                                        <button @onclick="() => EditRole(role)" 
                                                class="text-blue-400 hover:text-blue-300 text-xs font-semibold">
                                            Edit
                                        </button>
                                        <button @onclick="() => DeleteRole(role.Id)" 
                                                class="text-red-400 hover:text-red-300 text-xs font-semibold">
                                            Delete
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (roles.Count == 0)
                        {
                            <p class="text-gray-500 text-sm text-center py-4">No roles yet</p>
                        }
                    </div>

                    @if (showCreateRole)
                    {
                        <div class="mt-4 p-3 border border-neutral-600 rounded-lg bg-neutral-900">
                            <input @bind-value="newRoleName" 
                                   @bind-value:event="oninput"
                                   placeholder="Role name..." 
                                   class="bg-neutral-800 border border-neutral-600 rounded px-3 py-2 text-sm w-full mb-2 text-white placeholder-gray-500" />
                            <div class="flex gap-2">
                                <button @onclick="CreateRole" 
                                        class="bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600">
                                    Create
                                </button>
                                <button @onclick="() => showCreateRole = false" 
                                        class="border border-neutral-600 px-4 py-2 rounded-lg text-sm hover:bg-neutral-800 text-gray-300">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    // Departments
    private List<DepartmentDto> departments = new();
    private bool isLoadingDepartments = false;
    private bool showCreateDepartment = false;
    private string newDepartmentName = string.Empty;
    private Guid? editingDepartmentId = null;
    private string editingDepartmentName = string.Empty;

    // Positions
    private List<PositionDto> positions = new();
    private bool isLoadingPositions = false;
    private bool showCreatePosition = false;
    private string newPositionName = string.Empty;
    private string newPositionDepartmentId = string.Empty;
    private Guid? editingPositionId = null;
    private string editingPositionName = string.Empty;
    private string editingPositionDepartmentId = string.Empty;

    // Roles
    private List<RoleDto> roles = new();
    private bool isLoadingRoles = false;
    private bool showCreateRole = false;
    private string newRoleName = string.Empty;
    private Guid? editingRoleId = null;
    private string editingRoleName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        await Task.WhenAll(
            LoadDepartments(),
            LoadPositions(),
            LoadRoles()
        );
    }

    // ===== DEPARTMENTS =====
    
    private async Task LoadDepartments()
    {
        isLoadingDepartments = true;
        departments = await SettingsApi.GetDepartmentsAsync();
        isLoadingDepartments = false;
    }

    private void ShowCreateDepartment()
    {
        showCreateDepartment = true;
        newDepartmentName = string.Empty;
    }

    private async Task CreateDepartment()
    {
        if (string.IsNullOrWhiteSpace(newDepartmentName)) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", "Creating department:", newDepartmentName);
            var success = await SettingsApi.CreateDepartmentAsync(new CreateDepartmentRequest { Name = newDepartmentName });
            await JSRuntime.InvokeVoidAsync("console.log", "Create result:", success);
            
            if (success)
            {
                await LoadDepartments();
                showCreateDepartment = false;
                newDepartmentName = string.Empty;
                StateHasChanged();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Failed to create department. Check console for details.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error creating department:", ex.Message);
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private void EditDepartment(DepartmentDto dept)
    {
        editingDepartmentId = dept.Id;
        editingDepartmentName = dept.Name;
    }

    private async Task SaveDepartment(Guid id)
    {
        if (string.IsNullOrWhiteSpace(editingDepartmentName)) return;

        var success = await SettingsApi.UpdateDepartmentAsync(id, new UpdateDepartmentRequest { Name = editingDepartmentName });
        if (success)
        {
            await LoadDepartments();
            editingDepartmentId = null;
            editingDepartmentName = string.Empty;
        }
    }

    private void CancelEditDepartment()
    {
        editingDepartmentId = null;
        editingDepartmentName = string.Empty;
    }

    private async Task DeleteDepartment(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this department?"))
            return;

        var success = await SettingsApi.DeleteDepartmentAsync(id);
        if (success)
        {
            await LoadDepartments();
        }
    }

    // ===== POSITIONS =====
    
    private async Task LoadPositions()
    {
        isLoadingPositions = true;
        positions = await SettingsApi.GetPositionsAsync();
        isLoadingPositions = false;
    }

    private void ShowCreatePosition()
    {
        showCreatePosition = true;
        newPositionName = string.Empty;
        newPositionDepartmentId = string.Empty;
    }

    private void CancelCreatePosition()
    {
        showCreatePosition = false;
        newPositionName = string.Empty;
        newPositionDepartmentId = string.Empty;
    }

    private async Task CreatePosition()
    {
        if (string.IsNullOrWhiteSpace(newPositionName)) return;
        if (string.IsNullOrWhiteSpace(newPositionDepartmentId) || !Guid.TryParse(newPositionDepartmentId, out var deptId)) return;

        var success = await SettingsApi.CreatePositionAsync(new CreatePositionRequest 
        { 
            Name = newPositionName,
            DepartmentId = deptId
        });
        
        if (success)
        {
            await LoadPositions();
            showCreatePosition = false;
            newPositionName = string.Empty;
            newPositionDepartmentId = string.Empty;
        }
    }

    private void EditPosition(PositionDto pos)
    {
        editingPositionId = pos.Id;
        editingPositionName = pos.Name;
        editingPositionDepartmentId = pos.DepartmentId.ToString();
    }

    private async Task SavePosition(Guid id)
    {
        if (string.IsNullOrWhiteSpace(editingPositionName)) return;
        if (string.IsNullOrWhiteSpace(editingPositionDepartmentId) || !Guid.TryParse(editingPositionDepartmentId, out var deptId)) return;

        var success = await SettingsApi.UpdatePositionAsync(id, new UpdatePositionRequest 
        { 
            Name = editingPositionName,
            DepartmentId = deptId
        });
        
        if (success)
        {
            await LoadPositions();
            editingPositionId = null;
            editingPositionName = string.Empty;
            editingPositionDepartmentId = string.Empty;
        }
    }

    private void CancelEditPosition()
    {
        editingPositionId = null;
        editingPositionName = string.Empty;
        editingPositionDepartmentId = string.Empty;
    }

    private async Task DeletePosition(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this position?"))
            return;

        var success = await SettingsApi.DeletePositionAsync(id);
        if (success)
        {
            await LoadPositions();
        }
    }

    // ===== ROLES =====
    
    private async Task LoadRoles()
    {
        isLoadingRoles = true;
        roles = await SettingsApi.GetRolesAsync();
        isLoadingRoles = false;
    }

    private void ShowCreateRole()
    {
        showCreateRole = true;
        newRoleName = string.Empty;
    }

    private async Task CreateRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName)) return;

        var success = await SettingsApi.CreateRoleAsync(new CreateRoleRequest { Name = newRoleName });
        if (success)
        {
            await LoadRoles();
            showCreateRole = false;
            newRoleName = string.Empty;
        }
    }

    private void EditRole(RoleDto role)
    {
        editingRoleId = role.Id;
        editingRoleName = role.Name;
    }

    private async Task SaveRole(Guid id)
    {
        if (string.IsNullOrWhiteSpace(editingRoleName)) return;

        var success = await SettingsApi.UpdateRoleAsync(id, new UpdateRoleRequest { Name = editingRoleName });
        if (success)
        {
            await LoadRoles();
            editingRoleId = null;
            editingRoleName = string.Empty;
        }
    }

    private void CancelEditRole()
    {
        editingRoleId = null;
        editingRoleName = string.Empty;
    }

    private async Task DeleteRole(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this role?"))
            return;

        var success = await SettingsApi.DeleteRoleAsync(id);
        if (success)
        {
            await LoadRoles();
        }
    }
}
