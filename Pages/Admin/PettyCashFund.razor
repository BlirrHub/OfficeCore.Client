@page "/admin/petty-cash"
@attribute [Authorize(Roles = "Admin")]
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@inject PettyCashAdminApi PettyCashApi

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col">
    <div class="mb-4">
        <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">Petty Cash Fund</h1>
        <p class="mt-1 text-xs sm:text-sm text-neutral-400">Monitor balances, funding actions, and transaction history.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4 flex-shrink-0">
        <div class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-sm text-gray-400">Current Balance</p>
                    <p class="text-3xl font-bold text-blue-400">
                        @if (currentBalance != null)
                        {
                            @($"₱{currentBalance.ClosingBalance:N2}")
                        }
                        else
                        {
                            <span class="text-gray-400">-</span>
                        }
                    </p>
                </div>
                <button @onclick="RefreshCurrentBalance" class="text-blue-400 hover:text-blue-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            </div>
            @if (currentBalance != null)
            {
                <div class="text-xs text-gray-400">
                    As of @currentBalance.Date.ToString("MMM dd, yyyy")
                </div>
            }
        </div>

        <div class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <p class="text-sm text-gray-400 mb-2">Today's Opening</p>
            <p class="text-2xl font-bold text-green-400">
                @if (currentBalance != null)
                {
                    @($"₱{currentBalance.OpeningBalance:N2}")
                }
                else
                {
                    <span class="text-gray-400">-</span>
                }
            </p>
        </div>

        <div class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <p class="text-sm text-gray-400 mb-2">Total Deposits | Withdrawals</p>
            <p class="text-2xl font-bold text-purple-400">
                @if (currentBalance != null)
                {
                    @($"₱{currentBalance.Deposits:N2}")
                }
                else
                {
                    <span class="text-gray-400">-</span>
                }
                <span class="text-sm text-gray-400 mx-2">|</span>
                @if (currentBalance != null)
                {
                    <span class="text-red-400">₱@currentBalance.Withdrawals.ToString("N2")</span>
                }
                else
                {
                    <span class="text-gray-400">-</span>
                }
            </p>
        </div>
    </div>

    <div class="bg-neutral-900 rounded-2xl border border-neutral-800 p-4 mb-4 flex-shrink-0">
        <h2 class="text-lg font-semibold text-white mb-3">Manage Fund</h2>
        <div class="flex gap-3 flex-wrap">
            <input type="date" @bind="selectedDate" class="flex-1 min-w-[200px] border border-neutral-700 rounded-lg px-3 py-2 text-gray-200 bg-neutral-950" />
            <button @onclick="LoadSpecificDate" class="rounded-lg border border-sky-400/40 bg-sky-500/20 px-4 py-2 text-sky-200 transition hover:bg-sky-500/30">
                Load Date
            </button>
            <button @onclick="OpenSetOpeningModal" class="rounded-lg border border-violet-400/40 bg-violet-500/20 px-4 py-2 text-violet-200 transition hover:bg-violet-500/30">
                Set Opening Balance
            </button>
            <button @onclick="OpenAddFundModal" class="rounded-lg border border-emerald-400/40 bg-emerald-500/20 px-4 py-2 text-emerald-200 transition hover:bg-emerald-500/30">
                Add Fund
            </button>
            <button @onclick="OpenDeductFundModal" class="rounded-lg border border-red-400/40 bg-red-500/20 px-4 py-2 text-red-200 transition hover:bg-red-500/30">
                Deduct Fund
            </button>
        </div>
    </div>

    <div class="flex-1 overflow-auto bg-neutral-900 rounded-2xl border border-neutral-800 p-4">
        <div class="flex justify-between items-center mb-3">
            <h2 class="text-lg font-semibold text-white">
                Fund History - @selectedDate.ToString("MMMM dd, yyyy")
            </h2>
            <button @onclick="LoadTransactionHistory" class="rounded-lg border border-sky-400/40 bg-sky-500/20 px-3 py-2 text-sm text-sky-200 transition hover:bg-sky-500/30">
                <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
        </div>

        @if (isLoadingHistory)
        {
            <div class="text-center py-8">
                <p class="text-white">Loading transactions...</p>
            </div>
        }
        else if (transactionDetails == null)
        {
            <div class="text-center py-8">
                <p class="text-gray-400">No transactions found for this date.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @if (transactionDetails.CashAdvancesPaid.Any())
                {
                    <div class="bg-neutral-800 rounded-lg p-4">
                        <h5 class="text-sm font-medium text-red-400 mb-3">Cash Advances Paid</h5>
                        <div class="bg-neutral-700 rounded-lg overflow-hidden">
                            <table class="w-full text-sm">
                                <thead class="bg-neutral-900">
                                    <tr>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Employee</th>
                                        <th class="px-3 py-2 text-right text-xs text-gray-400">Amount</th>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Time</th>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Reason</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-neutral-600">
                                    @foreach (var ca in transactionDetails.CashAdvancesPaid)
                                    {
                                        <tr>
                                            <td class="px-3 py-2 text-gray-200">@ca.EmployeeName</td>
                                            <td class="px-3 py-2 text-right font-semibold text-red-400">₱@ca.Amount.ToString("N2")</td>
                                            <td class="px-3 py-2 text-gray-300">@ca.PaidAt.ToString("hh:mm tt")</td>
                                            <td class="px-3 py-2 text-gray-300 max-w-xs truncate">@(string.IsNullOrEmpty(ca.Reason) ? "-" : ca.Reason)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-neutral-900">
                                    <tr>
                                        <td class="px-3 py-2 text-xs font-bold text-gray-300">Total:</td>
                                        <td class="px-3 py-2 text-right font-bold text-red-400">₱@transactionDetails.CashAdvancesPaid.Sum(x => x.Amount).ToString("N2")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                @if (transactionDetails.LiquidationsIssued.Any())
                {
                    <div class="bg-neutral-800 rounded-lg p-4">
                        <h5 class="text-sm font-medium text-purple-400 mb-3">Liquidations Issued</h5>
                        <div class="bg-neutral-700 rounded-lg overflow-hidden">
                            <table class="w-full text-sm">
                                <thead class="bg-neutral-900">
                                    <tr>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Employee</th>
                                        <th class="px-3 py-2 text-right text-xs text-gray-400">Issued</th>
                                        <th class="px-3 py-2 text-right text-xs text-gray-400">Returned</th>
                                        <th class="px-3 py-2 text-right text-xs text-gray-400">Net</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-neutral-600">
                                    @foreach (var liq in transactionDetails.LiquidationsIssued)
                                    {
                                        <tr>
                                            <td class="px-3 py-2 text-gray-200">@liq.EmployeeName</td>
                                            <td class="px-3 py-2 text-right text-red-400">₱@liq.PettyCashReceived.ToString("N2")</td>
                                            <td class="px-3 py-2 text-right text-green-400">₱@liq.AmountReturned.ToString("N2")</td>
                                            <td class="px-3 py-2 text-right font-semibold @((liq.PettyCashReceived - liq.AmountReturned) > 0 ? "text-red-400" : "text-green-400")">
                                                ₱@((liq.PettyCashReceived - liq.AmountReturned).ToString("N2"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (transactionDetails.ManualTransactions.Any())
                {
                    <div class="bg-neutral-800 rounded-lg p-4">
                        <h5 class="text-sm font-medium text-blue-400 mb-3">Manual Transactions</h5>
                        <div class="bg-neutral-700 rounded-lg overflow-hidden">
                            <table class="w-full text-sm">
                                <thead class="bg-neutral-900">
                                    <tr>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Type</th>
                                        <th class="px-3 py-2 text-right text-xs text-gray-400">Amount</th>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Time</th>
                                        <th class="px-3 py-2 text-left text-xs text-gray-400">Notes</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-neutral-600">
                                    @foreach (var txn in transactionDetails.ManualTransactions)
                                    {
                                        <tr>
                                            <td class="px-3 py-2 text-gray-200">
                                                <span class="px-2 py-1 rounded text-xs font-medium @(txn.Type == "Deposit" ? "bg-green-900 text-green-300" : "bg-red-900 text-red-300")">
                                                    @txn.Type
                                                </span>
                                            </td>
                                            <td class="px-3 py-2 text-right font-semibold @(txn.Type == "Deposit" ? "text-green-400" : "text-red-400")">
                                                ₱@txn.Amount.ToString("N2")
                                            </td>
                                            <td class="px-3 py-2 text-gray-300">@txn.CreatedAt.ToLocalTime().ToString("hh:mm tt")</td>
                                            <td class="px-3 py-2 text-gray-300 max-w-xs truncate">@(string.IsNullOrEmpty(txn.Notes) ? "-" : txn.Notes)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-neutral-900">
                                    <tr>
                                        <td class="px-3 py-2 text-xs font-bold text-gray-300">Totals:</td>
                                        <td class="px-3 py-2 text-right">
                                            <div class="text-xs">
                                                <span class="text-green-400">+₱@transactionDetails.ManualTransactions.Where(t => t.Type == "Deposit").Sum(t => t.Amount).ToString("N2")</span>
                                                <span class="text-gray-500 mx-1">|</span>
                                                <span class="text-red-400">-₱@transactionDetails.ManualTransactions.Where(t => t.Type == "Withdrawal").Sum(t => t.Amount).ToString("N2")</span>
                                            </div>
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                @if (!transactionDetails.CashAdvancesPaid.Any() && 
                     !transactionDetails.LiquidationsIssued.Any() && 
                     !transactionDetails.ManualTransactions.Any())
                {
                    <div class="text-center py-8">
                        <p class="text-gray-400">No transactions for this date.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Set Opening Balance Modal *@
@if (showSetOpeningModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm" @onclick="CloseModals">
        <div class="my-8 w-full max-w-lg rounded-3xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-white">Set Opening Balance</h3>
                    <p class="mt-1 text-sm text-neutral-400">Initialize or correct the starting petty cash amount for a specific date.</p>
                </div>
                <button @onclick="CloseModals" class="text-neutral-500 transition hover:text-neutral-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Date</label>
                <input type="date" @bind="modalDate" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Opening Balance Amount</label>
                <input type="number" step="0.01" @bind="modalAmount"
                       class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Notes (optional)</label>
                <textarea @bind="modalNotes" rows="3"
                          class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white"
                          placeholder="e.g., Initial fund setup, Adjusted opening balance..."></textarea>
            </div>

            <div class="flex justify-end gap-3">
                <button @onclick="CloseModals" disabled="@isSaving"
                        class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900 disabled:opacity-50">
                    Cancel
                </button>
                <button @onclick="SaveSetOpening" disabled="@isSaving"
                        class="rounded-xl border border-violet-400/40 bg-violet-500/20 px-5 py-2 text-sm font-medium text-violet-200 transition hover:bg-violet-500/30 disabled:opacity-50">
                    @(isSaving ? "Saving..." : "Set Opening Balance")
                </button>
            </div>
        </div>
    </div>
}

@* Add Fund Modal *@
@if (showAddFundModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm" @onclick="CloseModals">
        <div class="my-8 w-full max-w-lg rounded-3xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-white">Add Fund</h3>
                    <p class="mt-1 text-sm text-neutral-400">Record a deposit or replenishment into the petty cash fund.</p>
                </div>
                <button @onclick="CloseModals" class="text-neutral-500 transition hover:text-neutral-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Date</label>
                <input type="date" @bind="modalDate" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Amount to Add</label>
                <input type="number" step="0.01" @bind="modalAmount"
                       class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Notes (optional)</label>
                <textarea @bind="modalNotes" rows="3"
                          class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white"
                          placeholder="e.g., Replenishment from main fund, Cash deposit..."></textarea>
            </div>

            <div class="flex justify-end gap-3">
                <button @onclick="CloseModals" disabled="@isSaving"
                        class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900 disabled:opacity-50">
                    Cancel
                </button>
                <button @onclick="SaveAddFund" disabled="@isSaving"
                        class="rounded-xl border border-emerald-400/40 bg-emerald-500/20 px-5 py-2 text-sm font-medium text-emerald-200 transition hover:bg-emerald-500/30 disabled:opacity-50">
                    @(isSaving ? "Saving..." : "Add Fund")
                </button>
            </div>
        </div>
    </div>
}

@* Deduct Fund Modal *@
@if (showDeductFundModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm" @onclick="CloseModals">
        <div class="my-8 w-full max-w-lg rounded-3xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-white">Deduct Fund</h3>
                    <p class="mt-1 text-sm text-neutral-400">Record a manual withdrawal or cash deduction for the selected date.</p>
                </div>
                <button @onclick="CloseModals" class="text-neutral-500 transition hover:text-neutral-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Date</label>
                <input type="date" @bind="modalDate" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Amount to Deduct</label>
                <input type="number" step="0.01" @bind="modalAmount"
                       class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
            </div>

            <div class="mb-4">
                <label class="mb-1 block text-sm font-medium text-neutral-300">Notes (optional)</label>
                <textarea @bind="modalNotes" rows="3"
                          class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white"
                          placeholder="e.g., Office supplies purchase, Emergency withdrawal..."></textarea>
            </div>

            <div class="flex justify-end gap-3">
                <button @onclick="CloseModals" disabled="@isSaving"
                        class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900 disabled:opacity-50">
                    Cancel
                </button>
                <button @onclick="SaveDeductFund" disabled="@isSaving"
                        class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-2 text-sm font-medium text-red-200 transition hover:bg-red-500/20 disabled:opacity-50">
                    @(isSaving ? "Saving..." : "Deduct Fund")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private PettyCashFundDto? currentBalance;
    private PettyCashFundDto? selectedFund;
    private PettyCashTransactionDetailsDto? transactionDetails;
    private bool isLoadingHistory;
    private bool isSaving;
    private bool showSetOpeningModal;
    private bool showAddFundModal;
    private bool showDeductFundModal;

    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly modalDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal modalAmount = 0;
    private string? modalNotes = null;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCurrentBalance();
        await LoadTransactionHistory();
    }

    private async Task RefreshCurrentBalance()
    {
        currentBalance = await PettyCashApi.GetCurrentBalanceAsync();
        selectedFund = currentBalance;
    }

    private async Task LoadSpecificDate()
    {
        selectedFund = await PettyCashApi.GetFundAsync(selectedDate);
        await LoadTransactionHistory();
    }

    private async Task LoadTransactionHistory()
    {
        isLoadingHistory = true;
        transactionDetails = await PettyCashApi.GetTransactionDetailsAsync(selectedDate);
        isLoadingHistory = false;
    }

    private async Task RefreshFundHistory()
    {
        await LoadTransactionHistory();
    }

    private void OpenSetOpeningModal()
    {
        modalDate = selectedDate;
        modalAmount = selectedFund?.OpeningBalance ?? 0;
        modalNotes = null;
        showSetOpeningModal = true;
    }

    private void OpenAddFundModal()
    {
        modalDate = selectedDate;
        modalAmount = 0;
        modalNotes = null;
        showAddFundModal = true;
    }

    private void OpenDeductFundModal()
    {
        modalDate = selectedDate;
        modalAmount = 0;
        modalNotes = null;
        showDeductFundModal = true;
    }

    private async Task SaveSetOpening()
    {
        isSaving = true;
        var result = await PettyCashApi.SetOpeningBalanceAsync(modalDate, modalAmount, modalNotes);
        isSaving = false;

        if (result != null)
        {
            selectedFund = result;
            await RefreshCurrentBalance();
            await LoadTransactionHistory();
            CloseModals();
        }
    }

    private async Task SaveAddFund()
    {
        isSaving = true;
        var result = await PettyCashApi.AddDepositAsync(modalDate, modalAmount, modalNotes);
        isSaving = false;

        if (result != null)
        {
            selectedFund = result;
            await RefreshCurrentBalance();
            await LoadTransactionHistory();
            CloseModals();
        }
    }

    private async Task SaveDeductFund()
    {
        isSaving = true;
        var result = await PettyCashApi.AddWithdrawalAsync(modalDate, modalAmount, modalNotes);
        isSaving = false;

        if (result != null)
        {
            selectedFund = result;
            await RefreshCurrentBalance();
            await LoadTransactionHistory();
            CloseModals();
        }
    }

    private void CloseModals()
    {
        showSetOpeningModal = false;
        showAddFundModal = false;
        showDeductFundModal = false;
        modalAmount = 0;
        modalNotes = null;
    }
}
