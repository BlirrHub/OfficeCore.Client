@page "/admin/liquidations"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Forms
@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Features.Employees
@using OfficeCore.Client.Services.Api
@inject LiquidationAdminApi LiquidationApi
@inject PettyCashAdminApi PettyCashApi
@inject AdminApi AdminApi
@implements IDisposable

<div class="h-[calc(100vh-120px)] rounded-2xl border border-neutral-800 bg-neutral-950 p-3 sm:p-5 flex flex-col">
    <div class="mb-4 flex justify-between items-start gap-4 flex-shrink-0">
        <div class="flex items-start gap-4">
            <div>
                <h1 class="text-xl sm:text-3xl text-white font-semibold tracking-tight">Daily Liquidations</h1>
                <p class="mt-1 text-xs sm:text-sm text-neutral-400">Review submissions and keep reconciliation accurate.</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 text-xs text-gray-400">
                <svg class="w-4 h-4 animate-pulse text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"></path>
                </svg>
                <span>Auto-refresh active</span>
            </div>
            <button @onclick="OpenManualLiquidationModal"
                    class="rounded-xl border border-amber-400/40 bg-amber-400/20 px-4 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30">
                Create Liquidation
            </button>
            <input type="date" @bind="selectedDate" @bind:event="oninput"
                   @onchange="LoadLiquidations"
                   class="border border-neutral-700 rounded-lg px-3 py-2 text-gray-200 bg-neutral-900" />
        </div>
    </div>

    <div class="bg-neutral-900 rounded-2xl border border-neutral-800 mb-4 flex-shrink-0">
        <div class="border-b border-neutral-700">
            <nav class="flex -mb-px">
                <button @onclick="() => SelectTab(1)"
                        class="@(activeTab == 1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Pending
                    @if (pendingCount > 0)
                    {
                        <span class="ml-2 bg-blue-100 text-blue-600 py-0.5 px-2 rounded-full text-xs">@pendingCount</span>
                    }
                </button>
                <button @onclick="() => SelectTab(2)"
                        class="@(activeTab == 2 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Approved
                    @if (approvedCount > 0)
                    {
                        <span class="ml-2 bg-blue-100 text-blue-600 py-0.5 px-2 rounded-full text-xs">@approvedCount</span>
                    }
                </button>
                <button @onclick="() => SelectTab(3)"
                        class="@(activeTab == 3 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    Rejected
                </button>
                <button @onclick="() => SelectTab(-1)"
                        class="@(activeTab == -1 ? "border-blue-500 text-blue-400" : "border-transparent text-gray-400 hover:text-gray-200 hover:border-gray-600") whitespace-nowrap py-4 px-6 border-b-2 font-medium text-sm">
                    All
                </button>
            </nav>
        </div>

        <div class="p-4 flex-1 overflow-auto">
            @if (isLoading)
            {
                <div class="text-center py-8">
                    <p class="text-white">Loading liquidations...</p>
                </div>
            }
            else if (filteredLiquidations == null || !filteredLiquidations.Any())
            {
                <div class="text-center py-8">
                    <p class="text-gray-400">No liquidations found.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full divide-y divide-neutral-800">
                        <thead class="bg-neutral-900 sticky top-0 z-10">
                            <tr>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider bg-neutral-950">Employee</th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">Date</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Cash Received</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Total Spent</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Returned</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Reimbursement</th>
                                <th class="px-3 sm:px-6 py-3 text-left text-xs font-bold text-white uppercase tracking-wider">Status</th>
                                <th class="px-3 sm:px-6 py-3 text-right text-xs font-bold text-white uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-neutral-950 divide-y divide-neutral-800">
                            @foreach (var liq in filteredLiquidations)
                    {
                        <tr class="hover:bg-neutral-900">
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-50 bg-neutral-900">
                                @($"{liq.EmployeeFirstName} {liq.EmployeeLastName}")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-gray-200">
                                @liq.Date.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right text-gray-50">
                                ₱@liq.PettyCashReceived.ToString("N2")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right text-gray-50">
                                ₱@liq.TotalSpent.ToString("N2")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right text-gray-50">
                                ₱@liq.AmountReturned.ToString("N2")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm text-right text-gray-50">
                                ₱@liq.ReimbursementDue.ToString("N2")
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap">
                                @if (liq.Status == 1)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-800 text-yellow-100">
                                        Pending
                                    </span>
                                }
                                else if (liq.Status == 2)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-800 text-green-100">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-800 text-red-100">
                                        Rejected
                                    </span>
                                }
                            </td>
                            <td class="px-3 sm:px-6 py-3 sm:py-4 whitespace-nowrap text-xs sm:text-sm font-medium text-right">
                                <button @onclick="() => ViewDetails(liq.Id)"
                                        class="text-amber-300 hover:text-amber-200">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
                </div>
            }
        </div>
    </div>
</div>

@if (showManualLiquidationModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm" @onclick="CloseManualLiquidationModal">
        <div class="max-h-[90vh] w-full max-w-4xl overflow-auto rounded-3xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl" @onclick:stopPropagation="true">
            <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-white">Create Liquidation</h3>
                    <p class="mt-1 text-sm text-neutral-400">Record a liquidation directly for an employee when it was prepared outside the mobile workflow.</p>
                </div>
                <button @onclick="CloseManualLiquidationModal" class="text-neutral-500 transition hover:text-neutral-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(manualLiquidationError))
            {
                <div class="mb-4 rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
                    @manualLiquidationError
                </div>
            }

            <div class="grid gap-4 md:grid-cols-3">
                <div class="md:col-span-2">
                    <label class="mb-1 block text-sm font-medium text-neutral-300">Employee</label>
                    <select @bind="manualLiquidation.EmployeeId" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white">
                        <option value="">Select an employee</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@employee.FirstName @employee.LastName (@employee.Department)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-neutral-300">Date</label>
                    <input type="date" @bind="manualLiquidation.Date" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-medium text-neutral-300">Petty Cash Received</label>
                    <input type="number" step="0.01" min="0" @bind="manualLiquidation.PettyCashReceived" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <div>
                        <h4 class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-400">Expense Entries</h4>
                        <p class="mt-1 text-sm text-neutral-500">Add each expense line included in the liquidation.</p>
                    </div>
                    <button @onclick="AddManualEntry"
                            class="rounded-xl border border-sky-400/40 bg-sky-500/20 px-4 py-2 text-sm font-medium text-sky-200 transition hover:bg-sky-500/30">
                        Add Entry
                    </button>
                </div>

                <div class="space-y-3">
                    @for (var index = 0; index < manualLiquidation.Entries.Count; index++)
                    {
                        var entry = manualLiquidation.Entries[index];
                        <div class="grid gap-3 rounded-2xl border border-neutral-800 bg-neutral-950 p-4 md:grid-cols-[1fr_180px_auto]">
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Particulars</label>
                                <input @bind="entry.Particulars" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Amount</label>
                                <input type="number" step="0.01" min="0" @bind="entry.Amount" class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" />
                            </div>
                            <div>
                                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500">Receipt</label>
                                <InputFile OnChange="@(args => OnManualReceiptChanged(index, args))" accept="image/*,.pdf" class="w-full rounded-xl border border-dashed border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-300 file:mr-3 file:rounded-lg file:border-0 file:bg-amber-400/20 file:px-3 file:py-2 file:text-amber-200" />
                                <p class="mt-2 truncate text-xs text-neutral-500">@(string.IsNullOrWhiteSpace(entry.ReceiptName) ? "Optional" : entry.ReceiptName)</p>
                            </div>
                            <div class="flex items-end">
                                <button @onclick="() => RemoveManualEntry(index)"
                                        disabled="@(manualLiquidation.Entries.Count == 1)"
                                        class="w-full rounded-xl border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-200 transition hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-40">
                                    Remove
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Total Spent</p>
                    <p class="mt-2 text-2xl font-semibold text-white">₱@ManualTotalSpent.ToString("N2")</p>
                </div>
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Amount Returned</p>
                    <p class="mt-2 text-2xl font-semibold text-emerald-300">₱@ManualAmountReturned.ToString("N2")</p>
                </div>
                <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                    <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Reimbursement Due</p>
                    <p class="mt-2 text-2xl font-semibold text-violet-300">₱@ManualReimbursementDue.ToString("N2")</p>
                </div>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button @onclick="CloseManualLiquidationModal"
                        class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900">
                    Cancel
                </button>
                <button @onclick="SubmitManualLiquidation"
                        disabled="@isCreatingManualLiquidation"
                        class="rounded-xl border border-amber-400/40 bg-amber-400/20 px-5 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30 disabled:cursor-not-allowed disabled:opacity-60">
                    @(isCreatingManualLiquidation ? "Saving..." : "Create Liquidation")
                </button>
            </div>
        </div>
    </div>
}

@if (selectedLiquidation != null)
{
    <div class="fixed inset-0 backdrop-blur-md bg-black/30 flex items-center justify-center z-50 overflow-y-auto" @onclick="CloseModal">
        <div class="bg-gray-900 rounded-2xl p-6 w-11/12 max-w-4xl shadow-2xl border border-neutral-900 my-8 mx-4" @onclick:stopPropagation="true">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Liquidation Details</h3>
                    <p class="text-sm text-gray-400">@($"{selectedLiquidation.EmployeeFirstName} {selectedLiquidation.EmployeeLastName}") - @selectedLiquidation.Date.ToString("MMMM dd, yyyy")</p>
                </div>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-300">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mb-4 grid grid-cols-2 gap-4">
                <div class="p-3 bg-gray-800 border border-gray-700 rounded-lg">
                    <p class="text-xs text-gray-400">Petty Cash Received</p>
                    <p class="text-lg font-bold text-blue-400">₱@selectedLiquidation.PettyCashReceived.ToString("N2")</p>
                </div>
                <div class="p-3 bg-gray-800 border border-gray-700 rounded-lg">
                    <p class="text-xs text-gray-400">Total Spent</p>
                    <p class="text-lg font-bold text-gray-200">₱@selectedLiquidation.TotalSpent.ToString("N2")</p>
                </div>
                <div class="p-3 bg-gray-800 border border-gray-700 rounded-lg">
                    <p class="text-xs text-gray-400">Amount Returned</p>
                    <p class="text-lg font-bold text-green-400">₱@selectedLiquidation.AmountReturned.ToString("N2")</p>
                </div>
                <div class="p-3 bg-gray-800 border border-gray-700 rounded-lg">
                    <p class="text-xs text-gray-400">Reimbursement Due</p>
                    <p class="text-lg font-bold text-purple-400">₱@selectedLiquidation.ReimbursementDue.ToString("N2")</p>
                </div>
            </div>

            <div class="mb-4">
                <h4 class="font-semibold text-gray-200 mb-2">Expense Entries</h4>
                <table class="min-w-full divide-y divide-gray-700">
                    <thead class="bg-gray-950">
                        <tr>
                            <th class="px-4 py-2 text-left text-xs font-bold text-white uppercase">#</th>
                            <th class="px-4 py-2 text-left text-xs font-bold text-white uppercase">Particulars</th>
                            <th class="px-4 py-2 text-right text-xs font-bold text-white uppercase">Amount</th>
                            <th class="px-4 py-2 text-center text-xs font-bold text-white uppercase">Receipt</th>
                        </tr>
                    </thead>
                    <tbody class="bg-gray-800 divide-y divide-gray-700">
                        @foreach (var entry in selectedLiquidation.Entries.OrderBy(e => e.SequenceOrder))
                        {
                            <tr>
                                <td class="px-4 py-2 text-sm text-gray-300">@entry.SequenceOrder</td>
                                <td class="px-4 py-2 text-sm text-gray-50">@entry.Particulars</td>
                                <td class="px-4 py-2 text-sm text-right text-gray-50">₱@entry.Amount.ToString("N2")</td>
                                <td class="px-4 py-2 text-sm text-center">
                                    @if (!string.IsNullOrEmpty(entry.ReceiptImageUrl))
                                    {
                                        <a href="@entry.ReceiptImageUrl" target="_blank"
                                           class="text-blue-400 hover:text-blue-300">
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (selectedLiquidation.Status == 1)
            {
                <div class="mt-6 flex gap-3">
                    <button @onclick="ApproveSelected" disabled="@isSaving"
                            class="flex-1 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 disabled:opacity-50">
                        @(isSaving ? "Processing..." : "Approve")
                    </button>
                    <button @onclick="RejectSelected" disabled="@isSaving"
                            class="flex-1 bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 disabled:opacity-50">
                        Reject
                    </button>
                </div>
            }
            else if (selectedLiquidation.Status == 2)
            {
                <div class="mt-6 p-4 bg-green-50 rounded">
                    <p class="text-sm text-green-800">
                        <strong>Approved</strong> on @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>

                <div class="mt-4">
                    <h4 class="font-semibold text-gray-200 mb-2">Reconciliation</h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Amount Returned</label>
                            <input type="number" step="0.01" @bind="reconciliationData.AmountReturned"
                                   class="w-full border border-neutral-600 rounded px-3 py-2 text-gray-200 bg-neutral-700" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Reimbursement Due</label>
                            <input type="number" step="0.01" @bind="reconciliationData.ReimbursementDue"
                                   class="w-full border border-neutral-600 rounded px-3 py-2 text-gray-200 bg-neutral-700" />
                        </div>
                    </div>
                    <button @onclick="SaveReconciliation" disabled="@isSaving"
                            class="mt-3 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 disabled:opacity-50">
                        @(isSaving ? "Saving..." : "Update Reconciliation")
                    </button>
                </div>
            }
            else
            {
                <div class="mt-6 p-4 bg-red-900 rounded">
                    <p class="text-sm text-red-200">
                        <strong>Rejected</strong> on @selectedLiquidation.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<LiquidationDto>? liquidations;
    private List<LiquidationDto>? filteredLiquidations;
    private List<Employee> employees = new();
    private LiquidationDto? selectedLiquidation;
    private bool isLoading;
    private bool isSaving;
    private bool showManualLiquidationModal;
    private bool isCreatingManualLiquidation;
    private int activeTab = 1; // 1=Pending, 2=Approved, 3=Rejected, -1=All
    private int pendingCount = 0;
    private int approvedCount = 0;
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private string? manualLiquidationError;
    private UpdateLiquidationReconciliationRequest reconciliationData = new();
    private ManualLiquidationForm manualLiquidation = ManualLiquidationForm.CreateDefault();
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _cts;

    private decimal ManualTotalSpent => manualLiquidation.Entries.Sum(entry => entry.Amount);
    private decimal ManualAmountReturned => Math.Max(manualLiquidation.PettyCashReceived - ManualTotalSpent, 0m);
    private decimal ManualReimbursementDue => Math.Max(ManualTotalSpent - manualLiquidation.PettyCashReceived, 0m);

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
        await LoadLiquidations();
        
        // Start auto-refresh every 10 seconds
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _cts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _refreshTimer.WaitForNextTickAsync(_cts.Token))
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadLiquidations();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Timer was cancelled, this is expected on dispose
            }
        });
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _refreshTimer?.Dispose();
        _cts?.Dispose();
    }

    private async Task LoadLiquidations()
    {
        isLoading = true;
        liquidations = await LiquidationApi.GetLiquidationsByDateAsync(selectedDate);

        // Calculate counts for all statuses
        pendingCount = liquidations?.Count(liq => liq.Status == 1) ?? 0;
        approvedCount = liquidations?.Count(liq => liq.Status == 2) ?? 0;

        ApplyFilter();
        isLoading = false;
    }

    private async Task LoadEmployees()
    {
        employees = (await AdminApi.GetAllEmployeesAsync())?.Where(employee => employee.IsActive).OrderBy(employee => employee.FirstName).ThenBy(employee => employee.LastName).ToList() ?? new();
    }

    private void ApplyFilter()
    {
        if (liquidations == null)
        {
            filteredLiquidations = null;
            return;
        }

        filteredLiquidations = activeTab switch
        {
            1 => liquidations.Where(liq => liq.Status == 1).ToList(),
            2 => liquidations.Where(liq => liq.Status == 2).ToList(),
            3 => liquidations.Where(liq => liq.Status == 3).ToList(),
            _ => liquidations.ToList()
        };
    }

    private void SelectTab(int tab)
    {
        activeTab = tab;
        ApplyFilter();
    }

    private void OpenManualLiquidationModal()
    {
        manualLiquidationError = null;
        manualLiquidation = ManualLiquidationForm.CreateDefault(selectedDate);
        showManualLiquidationModal = true;
    }

    private void CloseManualLiquidationModal()
    {
        if (isCreatingManualLiquidation)
        {
            return;
        }

        manualLiquidationError = null;
        showManualLiquidationModal = false;
        manualLiquidation = ManualLiquidationForm.CreateDefault(selectedDate);
    }

    private void AddManualEntry()
    {
        manualLiquidation.Entries.Add(new ManualLiquidationEntry());
    }

    private void RemoveManualEntry(int index)
    {
        if (manualLiquidation.Entries.Count == 1)
        {
            return;
        }

        manualLiquidation.Entries.RemoveAt(index);
    }

    private async Task SubmitManualLiquidation()
    {
        manualLiquidationError = ValidateManualLiquidation();
        if (!string.IsNullOrWhiteSpace(manualLiquidationError))
        {
            return;
        }

        isCreatingManualLiquidation = true;

        var request = new CreateLiquidationRequest
        {
            UserId = manualLiquidation.EmployeeId,
            Date = manualLiquidation.Date,
            PettyCashReceived = manualLiquidation.PettyCashReceived,
            IssuedByName = "Admin",
            Entries = manualLiquidation.Entries
                .Select(entry => new CreateLiquidationEntryDto
                {
                    Particulars = entry.Particulars.Trim(),
                    Amount = entry.Amount
                })
                .ToList()
        };

        var created = await LiquidationApi.CreateLiquidationAsync(request, manualLiquidation.Entries.Select(entry => entry.Receipt).ToList());
        isCreatingManualLiquidation = false;

        if (created == null)
        {
            manualLiquidationError = LiquidationApi.LastError ?? "Unable to create the liquidation. Check for duplicate entries on the same date and try again.";
            return;
        }

        showManualLiquidationModal = false;
        selectedDate = created.Date;
        await LoadLiquidations();
        await ViewDetails(created.Id);
    }

    private string? ValidateManualLiquidation()
    {
        if (manualLiquidation.EmployeeId == null || manualLiquidation.EmployeeId == Guid.Empty)
        {
            return "Select an employee.";
        }

        if (manualLiquidation.PettyCashReceived < 0)
        {
            return "Petty cash received cannot be negative.";
        }

        if (manualLiquidation.Entries.Count == 0)
        {
            return "Add at least one expense entry.";
        }

        if (manualLiquidation.Entries.Any(entry => string.IsNullOrWhiteSpace(entry.Particulars)))
        {
            return "Each entry needs particulars.";
        }

        if (manualLiquidation.Entries.Any(entry => entry.Amount <= 0))
        {
            return "Each entry amount must be greater than zero.";
        }

        return null;
    }

    private void OnManualReceiptChanged(int index, InputFileChangeEventArgs args)
    {
        if (index < 0 || index >= manualLiquidation.Entries.Count)
        {
            return;
        }

        var file = args.File;
        manualLiquidation.Entries[index].Receipt = file;
        manualLiquidation.Entries[index].ReceiptName = file?.Name;
    }

    private async Task ViewDetails(Guid id)
    {
        selectedLiquidation = await LiquidationApi.GetLiquidationAsync(id);
        if (selectedLiquidation != null)
        {
            reconciliationData = new UpdateLiquidationReconciliationRequest
            {
                AmountReturned = selectedLiquidation.AmountReturned,
                ReimbursementDue = selectedLiquidation.ReimbursementDue
            };
        }
    }

    private async Task ApproveSelected()
    {
        if (selectedLiquidation == null) return;

        isSaving = true;
        var result = await LiquidationApi.ApproveLiquidationAsync(selectedLiquidation.Id);
        isSaving = false;

        if (result != null)
        {
            selectedLiquidation = result;
            await LoadLiquidations();
            await PettyCashApi.RecalculateBalanceAsync(selectedDate);
        }
    }

    private async Task RejectSelected()
    {
        if (selectedLiquidation == null) return;

        isSaving = true;
        var result = await LiquidationApi.RejectLiquidationAsync(selectedLiquidation.Id);
        isSaving = false;

        if (result != null)
        {
            selectedLiquidation = result;
            await LoadLiquidations();
        }
    }

    private async Task SaveReconciliation()
    {
        if (selectedLiquidation == null) return;

        isSaving = true;
        var result = await LiquidationApi.UpdateReconciliationAsync(selectedLiquidation.Id, reconciliationData);
        isSaving = false;

        if (result != null)
        {
            selectedLiquidation = result;
            await LoadLiquidations();
            await PettyCashApi.RecalculateBalanceAsync(selectedDate);
        }
    }

    private void CloseModal()
    {
        selectedLiquidation = null;
    }

    private sealed class ManualLiquidationForm
    {
        public Guid? EmployeeId { get; set; }
        public DateOnly Date { get; set; }
        public decimal PettyCashReceived { get; set; }
        public List<ManualLiquidationEntry> Entries { get; set; } = new();

        public static ManualLiquidationForm CreateDefault(DateOnly? date = null)
        {
            var targetDate = date ?? DateOnly.FromDateTime(DateTime.Today);
            return new ManualLiquidationForm
            {
                Date = targetDate,
                Entries = new List<ManualLiquidationEntry> { new() }
            };
        }
    }

    private sealed class ManualLiquidationEntry
    {
        public string Particulars { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public IBrowserFile? Receipt { get; set; }
        public string? ReceiptName { get; set; }
    }
}
