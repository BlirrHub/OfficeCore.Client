@page "/admin/dashboard"
@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else
{
    <div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-3 sm:p-4 flex flex-col overflow-auto">
        <!-- Header -->
        <div class="mb-4 flex-shrink-0">
            <h1 class="text-xl sm:text-2xl text-white font-bold">Dashboard</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Welcome back! Here's your overview</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <!-- Total Employees Card -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-xs sm:text-sm mb-1">Total Employees</p>
                        <p class="text-2xl sm:text-3xl font-bold text-white">127</p>
                        <p class="text-green-400 text-xs mt-2">↑ 5 this month</p>
                    </div>
                    <div class="text-4xl">👥</div>
                </div>
            </div>

            <!-- Active Today Card -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-xs sm:text-sm mb-1">Active Today</p>
                        <p class="text-2xl sm:text-3xl font-bold text-white">98</p>
                        <p class="text-blue-400 text-xs mt-2">77% attendance</p>
                    </div>
                    <div class="text-4xl">✓</div>
                </div>
            </div>

            <!-- Pending Payroll Card -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-xs sm:text-sm mb-1">Pending Payroll</p>
                        <p class="text-2xl sm:text-3xl font-bold text-white">12</p>
                        <p class="text-yellow-400 text-xs mt-2">Needs approval</p>
                    </div>
                    <div class="text-4xl">💰</div>
                </div>
            </div>

            <!-- Open Tasks Card -->
            <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-400 text-xs sm:text-sm mb-1">Open Tasks</p>
                        <p class="text-2xl sm:text-3xl font-bold text-white">8</p>
                        <p class="text-red-400 text-xs mt-2">3 high priority</p>
                    </div>
                    <div class="text-4xl">📋</div>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 flex-1">
            <!-- Recent Activity -->
            <div class="lg:col-span-2 bg-neutral-800 rounded-lg border border-neutral-700 p-4 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold text-white">Recent Activity</h2>
                    <button class="text-blue-400 hover:text-blue-300 text-sm">View All</button>
                </div>
                <div class="space-y-3 overflow-auto flex-1">
                    <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                        <div class="text-2xl">👤</div>
                        <div class="flex-1">
                            <p class="text-sm text-white">New employee added</p>
                            <p class="text-xs text-gray-400 mt-1">Sarah Johnson joined as Software Engineer</p>
                            <p class="text-xs text-gray-500 mt-1">2 hours ago</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                        <div class="text-2xl">💼</div>
                        <div class="flex-1">
                            <p class="text-sm text-white">Payroll processed</p>
                            <p class="text-xs text-gray-400 mt-1">Weekly payroll for 125 employees completed</p>
                            <p class="text-xs text-gray-500 mt-1">5 hours ago</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                        <div class="text-2xl">📊</div>
                        <div class="flex-1">
                            <p class="text-sm text-white">Attendance imported</p>
                            <p class="text-xs text-gray-400 mt-1">Batch import of 840 attendance records</p>
                            <p class="text-xs text-gray-500 mt-1">1 day ago</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                        <div class="text-2xl">⚙️</div>
                        <div class="flex-1">
                            <p class="text-sm text-white">Department created</p>
                            <p class="text-xs text-gray-400 mt-1">New "Marketing" department added</p>
                            <p class="text-xs text-gray-500 mt-1">2 days ago</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                        <div class="text-2xl">🔄</div>
                        <div class="flex-1">
                            <p class="text-sm text-white">Employee status updated</p>
                            <p class="text-xs text-gray-400 mt-1">Mike Chen status changed to Active</p>
                            <p class="text-xs text-gray-500 mt-1">3 days ago</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions & Stats -->
            <div class="flex flex-col gap-4">
                <!-- Quick Actions -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                    <h2 class="text-lg font-semibold text-white mb-4">Quick Actions</h2>
                    <div class="space-y-2">
                        <button @onclick='() => Nav.NavigateTo("/admin/employees")' 
                                class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                            <span>Manage Employees</span>
                            <span>→</span>
                        </button>
                        <button @onclick='() => Nav.NavigateTo("/admin/attendance-weekly")' 
                                class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                            <span>View Attendance</span>
                            <span>→</span>
                        </button>
                        <button @onclick='() => Nav.NavigateTo("/admin/payroll-weekly")' 
                                class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                            <span>Process Payroll</span>
                            <span>→</span>
                        </button>
                        <button @onclick='() => Nav.NavigateTo("/admin/settings")' 
                                class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                            <span>Settings</span>
                            <span>→</span>
                        </button>
                    </div>
                </div>

                <!-- Department Stats -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                    <h2 class="text-lg font-semibold text-white mb-4">By Department</h2>
                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-300">Engineering</span>
                                <span class="text-white font-semibold">45</span>
                            </div>
                            <div class="w-full bg-neutral-700 rounded-full h-2">
                                <div class="bg-blue-500 h-2 rounded-full" style="width: 35%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-300">Sales</span>
                                <span class="text-white font-semibold">32</span>
                            </div>
                            <div class="w-full bg-neutral-700 rounded-full h-2">
                                <div class="bg-green-500 h-2 rounded-full" style="width: 25%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-300">Marketing</span>
                                <span class="text-white font-semibold">18</span>
                            </div>
                            <div class="w-full bg-neutral-700 rounded-full h-2">
                                <div class="bg-purple-500 h-2 rounded-full" style="width: 14%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-300">HR</span>
                                <span class="text-white font-semibold">12</span>
                            </div>
                            <div class="w-full bg-neutral-700 rounded-full h-2">
                                <div class="bg-yellow-500 h-2 rounded-full" style="width: 9%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-300">Operations</span>
                                <span class="text-white font-semibold">20</span>
                            </div>
                            <div class="w-full bg-neutral-700 rounded-full h-2">
                                <div class="bg-red-500 h-2 rounded-full" style="width: 16%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    
}