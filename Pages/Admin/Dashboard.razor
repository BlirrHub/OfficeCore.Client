@page "/admin/dashboard"
@using OfficeCore.Client.Models.Dtos
@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi

@if (AuthState.UserType != "Admin")
{
    <p class="mt-2 text-red-600">Not authorized.</p>
}
else
{
    <div class="h-[calc(100vh-120px)] bg-neutral-900 border rounded-xl p-3 sm:p-4 flex flex-col overflow-auto">
        <!-- Header -->
        <div class="mb-4 flex-shrink-0">
            <h1 class="text-xl sm:text-2xl text-white font-bold">Dashboard</h1>
            <p class="text-gray-400 text-xs sm:text-sm mt-1">Welcome back! Here's your overview</p>
        </div>

        @if (isLoading)
        {
            <div class="flex items-center justify-center h-64">
                <div class="flex flex-col items-center gap-3">
                    <svg class="animate-spin h-10 w-10 text-blue-500" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span class="text-gray-400">Loading dashboard...</span>
                </div>
            </div>
        }
        else if (stats == null)
        {
            <div class="flex items-center justify-center h-64">
                <div class="text-center">
                    <p class="text-red-400 mb-2">Failed to load dashboard stats</p>
                    <button @onclick="LoadDashboardStats" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        Retry
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Stats Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                <!-- Total Employees Card -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors cursor-pointer"
                     @onclick='() => Nav.NavigateTo("/admin/employees")'>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-400 text-xs sm:text-sm mb-1">Total Employees</p>
                            <p class="text-2xl sm:text-3xl font-bold text-white">@stats.TotalEmployees</p>
                            <p class="text-green-400 text-xs mt-2">@stats.ActiveEmployees active</p>
                        </div>
                        <div class="text-4xl">👥</div>
                    </div>
                </div>

                <!-- Pending Cash Advances Card -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors cursor-pointer"
                     @onclick='() => Nav.NavigateTo("/admin/cash-advances")'>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-400 text-xs sm:text-sm mb-1">Pending Cash Advances</p>
                            <p class="text-2xl sm:text-3xl font-bold text-white">@stats.PendingCashAdvances</p>
                            <p class="text-yellow-400 text-xs mt-2">Needs approval</p>
                        </div>
                        <div class="text-4xl">💰</div>
                    </div>
                </div>

                <!-- Pending Liquidations Card -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors cursor-pointer"
                     @onclick='() => Nav.NavigateTo("/admin/daily-liquidations")'>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-400 text-xs sm:text-sm mb-1">Pending Liquidations</p>
                            <p class="text-2xl sm:text-3xl font-bold text-white">@stats.PendingLiquidations</p>
                            <p class="text-yellow-400 text-xs mt-2">Awaiting review</p>
                        </div>
                        <div class="text-4xl">📄</div>
                    </div>
                </div>

                <!-- Open Tasks Card -->
                <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4 hover:bg-neutral-750 transition-colors cursor-pointer"
                     @onclick='() => Nav.NavigateTo("/admin/tasks")'>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-400 text-xs sm:text-sm mb-1">Open Tasks</p>
                            <p class="text-2xl sm:text-3xl font-bold text-white">@stats.PendingTasks</p>
                            <p class="text-red-400 text-xs mt-2">@stats.HighPriorityTasks high priority</p>
                        </div>
                        <div class="text-4xl">✓</div>
                    </div>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 flex-1">
                <!-- Recent Activity -->
                <div class="lg:col-span-2 bg-neutral-800 rounded-lg border border-neutral-700 p-4 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold text-white">Recent Activity</h2>
                    </div>
                    <div class="space-y-3 overflow-auto flex-1">
                        @if (stats.RecentActivities.Count == 0)
                        {
                            <div class="text-center text-gray-500 py-8">
                                <p>No recent activity</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var activity in stats.RecentActivities)
                            {
                                <div class="flex items-start gap-3 p-3 bg-neutral-700 rounded-lg border border-neutral-600 hover:bg-neutral-650">
                                    <div class="text-2xl">@activity.Icon</div>
                                    <div class="flex-1">
                                        <p class="text-sm text-white">@activity.Title</p>
                                        <p class="text-xs text-gray-400 mt-1">@activity.Description</p>
                                        <p class="text-xs text-gray-500 mt-1">@activity.RelativeTime</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Quick Actions & Stats -->
                <div class="flex flex-col gap-4">
                    <!-- Quick Actions -->
                    <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                        <h2 class="text-lg font-semibold text-white mb-4">Quick Actions</h2>
                        <div class="space-y-2">
                            <button @onclick='() => Nav.NavigateTo("/admin/employees")' 
                                    class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                                <span>Manage Employees</span>
                                <span>→</span>
                            </button>
                            <button @onclick='() => Nav.NavigateTo("/admin/attendance-weekly")' 
                                    class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                                <span>View Attendance</span>
                                <span>→</span>
                            </button>
                            <button @onclick='() => Nav.NavigateTo("/admin/payroll-weekly")' 
                                    class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                                <span>Process Payroll</span>
                                <span>→</span>
                            </button>
                            <button @onclick='() => Nav.NavigateTo("/admin/settings")' 
                                    class="w-full bg-black text-white px-4 py-3 rounded-lg text-sm hover:bg-gray-800 border border-neutral-600 text-left flex items-center justify-between">
                                <span>Settings</span>
                                <span>→</span>
                            </button>
                        </div>
                    </div>

                    <!-- Department Stats -->
                    @if (stats.DepartmentStats.Count > 0)
                    {
                        <div class="bg-neutral-800 rounded-lg border border-neutral-700 p-4">
                            <h2 class="text-lg font-semibold text-white mb-4">By Department</h2>
                            <div class="space-y-3">
                                @foreach (var dept in stats.DepartmentStats)
                                {
                                    <div>
                                        <div class="flex justify-between text-sm mb-1">
                                            <span class="text-gray-300">@dept.Department</span>
                                            <span class="text-white font-semibold">@dept.EmployeeCount</span>
                                        </div>
                                        <div class="w-full bg-neutral-700 rounded-full h-2">
                                            <div class="@GetDepartmentColor(dept.Department) h-2 rounded-full" 
                                                 style="width: @(dept.Percentage)%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private DashboardStatsDto? stats;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
    }

    private async Task LoadDashboardStats()
    {
        isLoading = true;
        stats = await AdminApi.GetDashboardStatsAsync();
        isLoading = false;
    }

    private string GetDepartmentColor(string department)
    {
        // Assign colors based on department name hash for consistency
        var colors = new[] { "bg-blue-500", "bg-green-500", "bg-purple-500", "bg-yellow-500", "bg-red-500", "bg-pink-500", "bg-indigo-500" };
        var hash = Math.Abs(department.GetHashCode());
        return colors[hash % colors.Length];
    }
}

