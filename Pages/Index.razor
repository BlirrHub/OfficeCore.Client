@page "/"
@layout AuthLayout
@inject NavigationManager Nav
@inject OfficeCore.Client.Services.State.AuthState AuthState

<div class="min-h-screen flex items-center justify-center bg-neutral-950">
    <div class="text-center">
        <div class="mb-8">
            <h1 class="text-5xl font-bold text-white mb-3">OfficeCore</h1>
            <p class="text-gray-400 text-lg">Employee Management System</p>
        </div>
        
        <div class="flex items-center justify-center gap-3">
            <svg class="animate-spin h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-gray-400 text-lg">Loading...</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Check if user is already authenticated
        if (AuthState.IsAuthenticated)
        {
            if (AuthState.UserType == "Admin")
                Nav.NavigateTo("/admin/dashboard", true);
            else
                Nav.NavigateTo("/app/dashboard", true);
        }
        else
        {
            Nav.NavigateTo("/login", true);
        }
    }
}
