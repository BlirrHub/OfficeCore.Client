@page "/change-password"
@layout AuthLayout

@inject NavigationManager Nav
@inject OfficeCore.Client.Services.Api.AuthApi AuthApi
@inject OfficeCore.Client.Services.State.AuthState AuthState

<div class="min-h-screen flex items-center justify-center bg-neutral-950 p-4">
    <div class="w-full max-w-md">
        <!-- Logo/Brand -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white mb-2">OfficeCore</h1>
            <p class="text-gray-400 text-sm">Employee Management System</p>
        </div>

        <!-- Change Password Card -->
        <div class="bg-neutral-900 rounded-2xl shadow-2xl p-8 border border-neutral-800">
            <!-- Warning Banner -->
            <div class="bg-amber-900/20 border border-amber-500/50 rounded-lg p-4 mb-6 flex items-start gap-3">
                <svg class="w-6 h-6 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <div>
                    <h3 class="text-amber-400 font-semibold text-sm mb-1">Password Change Required</h3>
                    <p class="text-amber-200/80 text-xs">You must change your password before continuing to use the system.</p>
                </div>
            </div>

            <h2 class="text-2xl font-bold text-white mb-2">Change Password</h2>
            <p class="text-gray-400 text-sm mb-6">Create a new secure password for your account</p>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Current Password</label>
                    <input class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           type="password"
                           placeholder="Enter your current password"
                           @bind="CurrentPassword"
                           @onkeydown="@HandleKeyPress" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">New Password</label>
                    <input class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           type="password"
                           placeholder="Enter new password (min. 6 characters)"
                           @bind="NewPassword"
                           @onkeydown="@HandleKeyPress" />
                    @if (!string.IsNullOrEmpty(NewPassword) && NewPassword.Length < 6)
                    {
                        <p class="text-xs text-amber-400 mt-1">Password must be at least 6 characters</p>
                    }
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Confirm New Password</label>
                    <input class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           type="password"
                           placeholder="Confirm your new password"
                           @bind="ConfirmPassword"
                           @onkeydown="@HandleKeyPress" />
                    @if (!string.IsNullOrEmpty(ConfirmPassword) && NewPassword != ConfirmPassword)
                    {
                        <p class="text-xs text-red-400 mt-1">Passwords do not match</p>
                    }
                    else if (!string.IsNullOrEmpty(ConfirmPassword) && NewPassword == ConfirmPassword)
                    {
                        <p class="text-xs text-green-400 mt-1">✓ Passwords match</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="bg-red-900/20 border border-red-500/50 rounded-lg p-3 flex items-start gap-2">
                        <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="text-sm text-red-400">@Error</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                {
                    <div class="bg-green-900/20 border border-green-500/50 rounded-lg p-3 flex items-start gap-2">
                        <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="text-sm text-green-400">@SuccessMessage</span>
                    </div>
                }

                <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg py-3 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-neutral-900 disabled:opacity-50 disabled:cursor-not-allowed"
                        @onclick="Submit"
                        disabled="@IsUpdating">
                    @if (IsUpdating)
                    {
                        <span class="flex items-center justify-center gap-2">
                            <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Updating password...</span>
                        </span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-gray-500 text-xs mt-6">
            &copy; 2026 OfficeCore. All rights reserved.
        </p>
    </div>
</div>

@code {
    private string CurrentPassword = "";
    private string NewPassword = "";
    private string ConfirmPassword = "";
    private string? Error;
    private string? SuccessMessage;
    private bool IsUpdating = false;

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsUpdating)
        {
            await Submit();
        }
    }

    private async Task Submit()
    {
        if (IsUpdating) return;
        
        Error = null;
        SuccessMessage = null;
        IsUpdating = true;

        try
        {
            if (string.IsNullOrWhiteSpace(CurrentPassword))
            {
                Error = "Please enter your current password.";
                return;
            }

            if (NewPassword.Length < 6)
            {
                Error = "New password must be at least 6 characters long.";
                return;
            }

            if (NewPassword != ConfirmPassword)
            {
                Error = "New password and confirmation password do not match.";
                return;
            }

            var result = await AuthApi.ChangePasswordAsync(new()
            {
                CurrentPassword = CurrentPassword,
                NewPassword = NewPassword
            });

            if (result is null)
            {
                Error = "Failed to change password. Please check your current password and try again.";
                return;
            }

            // Update token in state (important)
            AuthState.Set(result.AccessToken, AuthState.UserType ?? "", AuthState.Roles);

            SuccessMessage = "Password updated successfully! Redirecting...";
            await Task.Delay(1500);

            // Redirect based on user type
            if (AuthState.UserType == "Admin")
                Nav.NavigateTo("/admin/employees", true);
            else
                Nav.NavigateTo("/app/dashboard", true);
        }
        finally
        {
            IsUpdating = false;
        }
    }
}
