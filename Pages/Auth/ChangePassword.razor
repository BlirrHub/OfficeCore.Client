@page "/change-password"
@layout AuthLayout

@inject NavigationManager Nav
@inject OfficeCore.Client.Services.Api.AuthApi AuthApi
@inject OfficeCore.Client.Services.State.AuthState AuthState

<div class="min-h-screen flex bg-gray-100 p-4">
    <div class="w-full max-w-md bg-white rounded-xl shadow p-6">
        <h1 class="text-2xl font-bold">Change Password</h1>
        <p class="text-sm text-gray-600 mt-1">You must change your password before continuing.</p>

        <div class="mt-5 space-y-3">
            <div>
                <label class="text-sm text-gray-600">Current password</label>
                <input class="mt-1 w-full border rounded-lg px-3 py-2"
                       type="password"
                       @bind="CurrentPassword" />
            </div>

            <div>
                <label class="text-sm text-gray-600">New password</label>
                <input class="mt-1 w-full border rounded-lg px-3 py-2"
                       type="password"
                       @bind="NewPassword" />
            </div>

            <div>
                <label class="text-sm text-gray-600">Confirm new password</label>
                <input class="mt-1 w-full border rounded-lg px-3 py-2"
                       type="password"
                       @bind="ConfirmPassword" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="text-sm text-red-600">@Error</div>
            }

            <button class="w-full mt-2 bg-black text-white rounded-lg py-2"
                    @onclick="Submit">
                Update password
            </button>
        </div>
    </div>
</div>

@code {
    private string CurrentPassword = "";
    private string NewPassword = "";
    private string ConfirmPassword = "";
    private string? Error;

    private async Task Submit()
    {
        Error = null;

        if (NewPassword.Length < 6)
        {
            Error = "New password must be at least 6 characters.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            Error = "Passwords do not match.";
            return;
        }

        var result = await AuthApi.ChangePasswordAsync(new()
        {
            CurrentPassword = CurrentPassword,
            NewPassword = NewPassword
        });

        if (result is null)
        {
            Error = "Failed to change password. Check your current password.";
            return;
        }

        // Update token in state (important)
        AuthState.Set(result.AccessToken, AuthState.UserType ?? "", AuthState.Roles);

        // Redirect based on user type
        if (AuthState.UserType == "Admin")
            Nav.NavigateTo("/admin/employees", true);
        else
            Nav.NavigateTo("/app", true);
    }
}
