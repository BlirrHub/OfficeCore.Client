@page "/login"
@layout AuthLayout

@inject NavigationManager Nav 
@inject OfficeCore.Client.Services.Api.AuthApi AuthApi
@inject OfficeCore.Client.Services.State.AuthState AuthState
@inject Microsoft.JSInterop.IJSRuntime JS
@inject HttpClient Http

<div class="min-h-screen flex items-center justify-center bg-neutral-950 p-4">
    <div class="w-full max-w-md">
        <!-- Logo/Brand -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white mb-2">OfficeCore</h1>
            <p class="text-gray-400 text-sm">Employee Management System</p>
        </div>

        <!-- Login Card -->
        <div class="bg-neutral-900 rounded-2xl shadow-2xl p-8 border border-neutral-800">
            <h2 class="text-2xl font-bold text-white mb-2">Welcome Back</h2>
            <p class="text-gray-400 text-sm mb-6">Sign in to your account to continue</p>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Username</label>
                    <input class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           placeholder="Enter your username"
                           @bind="Username"
                           @onkeydown="@HandleKeyPress" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                    <input class="w-full bg-neutral-800 border border-neutral-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                           type="password"
                           placeholder="Enter your password"
                           @bind="Password"
                           @onkeydown="@HandleKeyPress" />
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="bg-red-900/20 border border-red-500/50 rounded-lg p-3 flex items-start gap-2">
                        <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="text-sm text-red-400">@Error</span>
                    </div>
                }

                <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg py-3 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-neutral-900 disabled:opacity-50 disabled:cursor-not-allowed"
                        @onclick="DoLogin"
                        disabled="@IsLoggingIn">
                    @if (IsLoggingIn)
                    {
                        <span class="flex items-center justify-center gap-2">
                            <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Signing in...</span>
                        </span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-gray-500 text-xs mt-6">
            &copy; 2026 OfficeCore. All rights reserved.
        </p>
    </div>
</div>

@code {
    private string Username = "";
    private string Password = "";
    private string? Error;
    private bool IsLoggingIn = false;

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsLoggingIn)
        {
            await DoLogin();
        }
    }

    private async Task DoLogin()
    {
        if (IsLoggingIn) return;
        
        Error = null;
        IsLoggingIn = true;

        try
        {
            var result = await AuthApi.LoginAsync(new()
            {
                Username = Username,
                Password = Password
            });

            if (result is null)
            {
                Error = "Invalid username or password. Please try again.";
                return;
            }

            AuthState.Set(result.AccessToken, result.UserType, result.Roles);
            await AuthState.SaveAsync(JS);
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", result.AccessToken);

            if (result.MustChangePassword)
            {
                Nav.NavigateTo("/change-password");
                return;
            }

            if (result.UserType == "Admin")
                Nav.NavigateTo("/admin/dashboard");
            else
                Nav.NavigateTo("/app/dashboard");
        }
        finally
        {
            IsLoggingIn = false;
        }
    }
}