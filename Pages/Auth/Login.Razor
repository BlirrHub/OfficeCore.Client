@page "/login"
@layout AuthLayout

@inject NavigationManager Nav 
@inject OfficeCore.Client.Services.Api.AuthApi AuthApi
@inject OfficeCore.Client.Services.State.AuthState AuthState

<div class="min-h-screen flex bg-gray-100 p-1">
    <div class="w-full max-w-md bg-white rounded-xl shadow p-6">
        <h1 class="text-2xl font-bold">Login</h1>

        <div class="mt-5 space-y-3">
            <div>
                <label class="text-sm text-gray-600">Username</label>
                <input class="mt-1 w-full border rounded-lg px-3 py-2"
                       @bind="Username" />
            </div>

            <div>
                <label class="text-sm text-gray-600">Password</label>
                <input class="mt-1 w-full border rounded-lg px-3 py-2"
                       type="password"
                       @bind="Password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="text-sm text-red-600">@Error</div>
            }

            <button class="w-full mt-2 bg-black text-white rounded-lg py-2"
                    @onclick="DoLogin">
                Sign in
            </button>
        </div>
    </div>
</div>

@code {
    private string Username = "";
    private string Password = "";
    private string? Error;

    private async Task DoLogin()
    {
        Error = null;

        var result = await AuthApi.LoginAsync(new()
        {
            Username = Username,
            Password = Password
        });

        if (result is null)
        {
            Error = "Invalid username/password.";
            return;
        }

        AuthState.Set(result.AccessToken, result.UserType, result.Roles);

        if (result.MustChangePassword)
        {
            Nav.NavigateTo("/change-password");
            return;
        }

        if (result.UserType == "Admin")
            Nav.NavigateTo("/admin/dashboard");
        else
            Nav.NavigateTo("/app");
    }
}