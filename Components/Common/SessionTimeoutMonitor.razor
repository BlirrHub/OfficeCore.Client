@using OfficeCore.Client.Services.State
@using OfficeCore.Client.Services.Utilities
@inject AuthState AuthState
@inject NavigationManager Navigation
@implements IAsyncDisposable

@code {
    private CancellationTokenSource? _cancellationTokenSource;
    private const int CheckIntervalSeconds = 30; // Check every 30 seconds

    protected override async Task OnInitializedAsync()
    {
        _cancellationTokenSource = new CancellationTokenSource();

        // Check on initialization
        await CheckTokenExpiration();

        // Start periodic checks
        _ = MonitorTokenAsync(_cancellationTokenSource.Token);
    }

    private async Task MonitorTokenAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(CheckIntervalSeconds), cancellationToken);
                await CheckTokenExpiration();
            }
        }
        catch (OperationCanceledException)
        {
            // Cancellation requested, stop monitoring
        }
    }

    private Task CheckTokenExpiration()
    {
        if (AuthState.IsTokenExpired)
        {
            AuthState.Clear();
            Navigation.NavigateTo("/auth/login", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_cancellationTokenSource is not null)
        {
            _cancellationTokenSource.Cancel();
            _cancellationTokenSource.Dispose();
        }
    }
}
