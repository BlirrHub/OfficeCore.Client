@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Services.Api
@using OfficeCore.Client.Services.State
@inject NotificationApi NotificationApi
@inject NavigationManager Navigation
@inject AuthState AuthState

<div class="relative">
    <button @onclick="ToggleDropdown" class="relative rounded-lg p-2 text-neutral-400 transition hover:bg-neutral-800 hover:text-neutral-200 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        @if (unreadCount > 0)
        {
            <span class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 text-[10px] font-bold leading-none text-white bg-red-500 rounded-full">
                @(unreadCount > 99 ? "99+" : unreadCount.ToString())
            </span>
        }
    </button>

    @if (isOpen)
    {
        <div class="absolute right-0 mt-2 w-80 rounded-2xl border border-neutral-800 bg-neutral-900 shadow-2xl z-50">
            <div class="flex items-center justify-between border-b border-neutral-800 p-4">
                <h3 class="text-lg font-semibold text-white">Notifications</h3>
                @if (unreadCount > 0)
                {
                    <button @onclick="MarkAllAsRead" class="text-sm text-amber-300 transition hover:text-amber-200">
                        Mark all read
                    </button>
                }
            </div>

            <div class="max-h-96 overflow-y-auto">
                @if (notifications.Count == 0)
                {
                    <div class="p-4 text-center text-neutral-500">
                        No notifications
                    </div>
                }
                else
                {
                    @foreach (var notification in notifications)
                    {
                        <div class="@GetNotificationClasses(notification) cursor-pointer transition-colors" 
                             @onclick="() => HandleNotificationClick(notification)">
                            <div class="flex justify-between items-start">
                                <div class="flex-1">
                                    <p class="@GetTitleClasses(notification)">@notification.Title</p>
                                    <p class="mt-1 text-sm text-neutral-300">@notification.Message</p>
                                    <p class="mt-1 text-xs text-neutral-500">@FormatTimeAgo(notification.CreatedAt)</p>
                                </div>
                                <button @onclick="(e) => DeleteNotification(notification.Id, e)" 
                                        @onclick:stopPropagation="true"
                                        class="ml-2 text-neutral-500 transition hover:text-red-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (notifications.Count > 0)
            {
                <div class="border-t border-neutral-800 p-2 text-center">
                    <button @onclick="ViewAllNotifications" class="text-sm text-amber-300 transition hover:text-amber-200">
                        View all notifications
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isOpen = false;
    private int unreadCount = 0;
    private List<NotificationDto> notifications = new();
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        
        // Auto-refresh every 30 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadNotifications();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadNotifications()
    {
        notifications = await NotificationApi.GetNotificationsAsync(10);
        unreadCount = await NotificationApi.GetUnreadCountAsync();
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private async Task HandleNotificationClick(NotificationDto notification)
    {
        if (!notification.IsRead)
        {
            await NotificationApi.MarkAsReadAsync(notification.Id);
            notification.IsRead = true;
            unreadCount = Math.Max(0, unreadCount - 1);
        }

        var targetUrl = NormalizeActionUrl(notification.ActionUrl);
        if (!string.IsNullOrEmpty(targetUrl))
        {
            Navigation.NavigateTo(targetUrl);
        }

        isOpen = false;
    }

    private async Task DeleteNotification(Guid id, MouseEventArgs e)
    {
        var notification = notifications.FirstOrDefault(n => n.Id == id);
        if (notification != null)
        {
            if (!notification.IsRead)
            {
                unreadCount = Math.Max(0, unreadCount - 1);
            }
            
            notifications.Remove(notification);
            await NotificationApi.DeleteNotificationAsync(id);
        }
    }

    private async Task MarkAllAsRead()
    {
        await NotificationApi.MarkAllAsReadAsync();
        foreach (var notification in notifications)
        {
            notification.IsRead = true;
        }
        unreadCount = 0;
    }

    private void ViewAllNotifications()
    {
        Navigation.NavigateTo(GetNotificationsHubRoute());
        isOpen = false;
    }

    private string GetNotificationClasses(NotificationDto notification)
    {
        return notification.IsRead 
            ? "border-b border-neutral-800 p-4 hover:bg-neutral-800/70" 
            : "border-b border-neutral-800 bg-amber-500/10 p-4 hover:bg-amber-500/15";
    }

    private string GetTitleClasses(NotificationDto notification)
    {
        return notification.IsRead 
            ? "font-medium text-white" 
            : "font-semibold text-amber-200";
    }

    private string GetNotificationsHubRoute()
    {
        return string.Equals(AuthState.UserType, "Admin", StringComparison.OrdinalIgnoreCase)
            ? "/admin/notifications"
            : "/app/notifications";
    }

    private string? NormalizeActionUrl(string? actionUrl)
    {
        if (string.IsNullOrWhiteSpace(actionUrl))
        {
            return null;
        }

        var normalized = actionUrl.Trim();

        if (!normalized.StartsWith('/'))
        {
            normalized = "/" + normalized;
        }

        if (normalized.Equals("/app/cash-advance", StringComparison.OrdinalIgnoreCase))
            return "/app/cash-advances";

        if (normalized.Equals("/app/liquidation", StringComparison.OrdinalIgnoreCase))
            return "/app/liquidations";

        if (normalized.Equals("/notifications", StringComparison.OrdinalIgnoreCase))
            return GetNotificationsHubRoute();

        return normalized;
    }

    private string FormatTimeAgo(DateTimeOffset time)
    {
        var diff = DateTimeOffset.Now - time;
        
        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}d ago";
        
        return time.ToString("MMM dd");
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
