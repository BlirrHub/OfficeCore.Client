@using OfficeCore.Client.Features.Employees
@using OfficeCore.Client.Components.Common
@using OfficeCore.Client.Components.Forms
@using OfficeCore.Client.Models.Dtos
@using static OfficeCore.Client.Components.Forms.ComboBox<string>
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi
@inject OfficeCore.Client.Services.Api.SettingsApi SettingsApi

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="Edit Employee" Size="Modal.ModalSize.Medium">
    @if (isLoading)
    {
        <div class="text-center py-4">
            <p class="text-neutral-300">Loading employee...</p>
        </div>
    }
    else if (employee is null)
    {
        <div class="text-center py-4">
            <p class="text-neutral-500">Employee not found.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-3">
            <div class="text-sm text-neutral-300">Username: <span class="font-medium text-white">@employee.Username</span></div>

            <div class="grid grid-cols-2 gap-3">
                <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" placeholder="First name" @bind="employee.FirstName" />
                <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" placeholder="Last name" @bind="employee.LastName" />
            </div>

            <ComboBox TValue="string"
                      Label="Department"
                      Placeholder="Select department..."
                      Value="@employee.Department"
                      ValueChanged="@OnDepartmentChanged"
                      Options="@departmentOptions" />

            <ComboBox TValue="string"
                      Label="Position"
                      Placeholder="Select position..."
                      @bind-Value="employee.Position"
                      Options="@filteredPositionOptions" />

            <div class="grid grid-cols-2 gap-3">
                <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" type="number" placeholder="Biometric ID" @bind="employee.BiometricId" />
                <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" type="number" step="0.01" placeholder="Daily rate" @bind="employee.DailyRate" />
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-neutral-300">Schedule</label>
                <select class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" @bind="SelectedSchedule">
                    <option value="8-5" class="bg-neutral-900">8:00 am - 5:00 pm</option>
                    <option value="9-6" class="bg-neutral-900">9:00 am - 6:00 pm</option>
                    <option value="none" class="bg-neutral-900">None</option>
                </select>
            </div>

            <label class="flex items-center gap-2 text-sm text-neutral-200">
                <input type="checkbox" @bind="employee.IsOTEnabled" class="rounded" />
                OT Enabled
            </label>

            <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
                <p class="mb-2 text-sm font-semibold text-neutral-200">Government Deductions</p>
                <div class="grid grid-cols-3 gap-2">
                    <label class="flex items-center gap-2 text-sm text-neutral-200">
                        <input type="checkbox" @bind="employee.HasSSSDeduction" class="rounded" />
                        SSS
                    </label>
                    <label class="flex items-center gap-2 text-sm text-neutral-200">
                        <input type="checkbox" @bind="employee.HasPhilHealthDeduction" class="rounded" />
                        PhilHealth
                    </label>
                    <label class="flex items-center gap-2 text-sm text-neutral-200">
                        <input type="checkbox" @bind="employee.HasPagIBIGDeduction" class="rounded" />
                        Pag-IBIG
                    </label>
                </div>
            </div>

            <div>
                <label class="text-sm font-medium text-neutral-300">Roles</label>
                <div class="max-h-32 overflow-y-auto rounded-2xl border border-neutral-800 bg-neutral-900 p-3">
                    @if (availableRoles.Count == 0)
                    {
                        <p class="text-sm text-neutral-500">No roles available</p>
                    }
                    else
                    {
                        @foreach (var role in availableRoles)
                        {
                            <label class="mb-1 flex cursor-pointer items-center gap-2 text-sm text-neutral-200">
                                <input type="checkbox" 
                                       checked="@employee.Roles.Contains(role.Name)"
                                       @onchange="@(e => ToggleRole(role.Name))"
                                       class="rounded" />
                                @role.Name
                            </label>
                        }
                    }
                </div>
            </div>

            <label class="flex items-center gap-2 text-sm text-neutral-200">
                <input type="checkbox" @bind="employee.IsActive" class="rounded" />
                Active
            </label>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="rounded-2xl border px-4 py-3 text-sm @(isError ? "border-red-500/30 bg-red-500/10 text-red-200" : "border-emerald-500/30 bg-emerald-500/10 text-emerald-200")">@message</div>
            }

            <div class="flex justify-end gap-3">
                <button class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900"
                        @onclick="Cancel">
                    Cancel
                </button>
                <button class="rounded-xl border border-amber-400/40 bg-amber-400/20 px-5 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30" @onclick="Save">
                    Save
                </button>
            </div>
        </div>
    }
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public EventCallback OnEmployeeUpdated { get; set; }

    private Employee? employee;
    private bool isLoading = true;
    private string SelectedSchedule = "8-5";
    
    private List<ComboBoxOption<string>> departmentOptions = new();
    private List<PositionDto> allPositions = new();
    private List<ComboBoxOption<string>> filteredPositionOptions = new();
    private List<RoleDto> availableRoles = new();

    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOptions();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && EmployeeId != Guid.Empty)
        {
            await LoadEmployee();
        }
    }

    private async Task LoadOptions()
    {
        // Load departments
        var departments = await SettingsApi.GetDepartmentsAsync();
        departmentOptions = departments
            .Select(d => new ComboBoxOption<string> { Value = d.Name, Text = d.Name })
            .ToList();

        // Load all positions
        allPositions = await SettingsApi.GetPositionsAsync();

        // Load roles
        availableRoles = await SettingsApi.GetRolesAsync();
    }

    private async Task LoadEmployee()
    {
        message = null;
        isLoading = true;
        employee = await AdminApi.GetEmployeeByIdAsync(EmployeeId);
        
        // Set schedule dropdown based on employee's current schedule
        if (employee != null)
        {
            if (employee.SchedTimeIn == TimeOnly.Parse("08:00") && employee.SchedTimeOut == TimeOnly.Parse("17:00"))
            {
                SelectedSchedule = "8-5";
            }
            else if (employee.SchedTimeIn == TimeOnly.Parse("09:00") && employee.SchedTimeOut == TimeOnly.Parse("18:00"))
            {
                SelectedSchedule = "9-6";
            }
            else
            {
                SelectedSchedule = "none";
            }
            
            // Filter positions based on current department
            FilterPositions();
        }
        
        isLoading = false;
    }

    private async Task OnDepartmentChanged(string? newDepartment)
    {
        if (employee == null) return;
        
        employee.Department = newDepartment;
        employee.Position = null; // Clear position when department changes
        FilterPositions();
        await Task.CompletedTask;
    }

    private void FilterPositions()
    {
        if (employee == null || string.IsNullOrWhiteSpace(employee.Department))
        {
            filteredPositionOptions = new();
        }
        else
        {
            filteredPositionOptions = allPositions
                .Where(p => p.DepartmentName == employee.Department)
                .Select(p => new ComboBoxOption<string> { Value = p.Name, Text = p.Name })
                .ToList();
        }
    }

    private void ToggleRole(string roleName)
    {
        if (employee == null) return;
        
        if (employee.Roles.Contains(roleName))
        {
            employee.Roles.Remove(roleName);
        }
        else
        {
            employee.Roles.Add(roleName);
        }
    }

    private async Task Save()
    {
        if (employee is null)
            return;

        message = null;

        // Apply schedule selection to employee
        if (SelectedSchedule == "8-5")
        {
            employee.SchedTimeIn = TimeOnly.Parse("08:00");
            employee.SchedTimeOut = TimeOnly.Parse("17:00");
        }
        else if (SelectedSchedule == "9-6")
        {
            employee.SchedTimeIn = TimeOnly.Parse("09:00");
            employee.SchedTimeOut = TimeOnly.Parse("18:00");
        }
        else
        {
            employee.SchedTimeIn = null;
            employee.SchedTimeOut = null;
        }

        var ok = await AdminApi.UpdateEmployeeAsync(EmployeeId, employee);
        isError = !ok;
        message = ok ? "Employee updated." : "Failed to update employee.";

        if (ok)
        {
            // Show success message briefly
            await Task.Delay(1000);
            message = null;
            
            // Close modal and notify parent
            await CloseModal();
            await OnEmployeeUpdated.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        message = null;
        isError = false;
        
        await CloseModal();
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
