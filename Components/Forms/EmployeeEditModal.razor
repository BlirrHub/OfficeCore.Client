@using OfficeCore.Client.Features.Employees
@using OfficeCore.Client.Components.Common
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="Edit Employee" Size="Modal.ModalSize.Medium">
    @if (isLoading)
    {
        <div class="text-center py-4">
            <p class="text-gray-600">Loading employee...</p>
        </div>
    }
    else if (employee is null)
    {
        <div class="text-center py-4">
            <p class="text-gray-500">Employee not found.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-3">
            <div class="text-sm text-gray-500">Username: <span class="text-gray-900 font-medium">@employee.Username</span></div>

            <div class="grid grid-cols-2 gap-3">
                <input class="border rounded-lg px-3 py-2" placeholder="First name" @bind="employee.FirstName" />
                <input class="border rounded-lg px-3 py-2" placeholder="Last name" @bind="employee.LastName" />
            </div>

            <input class="border rounded-lg px-3 py-2" placeholder="Department" @bind="employee.Department" />
            <input class="border rounded-lg px-3 py-2" placeholder="Position" @bind="employee.Position" />

            <div class="grid grid-cols-2 gap-3">
                <input class="border rounded-lg px-3 py-2" type="number" placeholder="Biometric ID" @bind="employee.BiometricId" />
                <input class="border rounded-lg px-3 py-2" type="number" step="0.01" placeholder="Daily rate" @bind="employee.DailyRate" />
            </div>

            <div>
                <label class="text-sm text-gray-600">Schedule</label>
                <select class="border rounded-lg px-3 py-2 w-full" @bind="SelectedSchedule">
                    <option value="8-5">8:00 am - 5:00 pm</option>
                    <option value="9-6">9:00 am - 6:00 pm</option>
                    <option value="none">None</option>
                </select>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsOTEnabled" />
                OT Enabled
            </label>

            <div class="border rounded-lg p-3 bg-gray-50">
                <p class="text-sm font-semibold mb-2 text-gray-700">Government Deductions</p>
                <div class="grid grid-cols-3 gap-2">
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasSSSDeduction" />
                        SSS
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasPhilHealthDeduction" />
                        PhilHealth
                    </label>
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="employee.HasPagIBIGDeduction" />
                        Pag-IBIG
                    </label>
                </div>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="employee.IsActive" />
                Active
            </label>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="text-sm @(isError ? "text-red-600" : "text-green-700")">@message</div>
            }

            <div class="flex gap-2">
                <button class="bg-black text-white rounded-lg py-2 px-4 flex-1 hover:bg-gray-800" @onclick="Save">
                    Save
                </button>
                <button class="border border-gray-300 rounded-lg py-2 px-4 text-gray-700 hover:bg-gray-50"
                        @onclick="Cancel">
                    Cancel
                </button>
            </div>
        </div>
    }
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }
    [Parameter] public EventCallback OnEmployeeUpdated { get; set; }

    private Employee? employee;
    private bool isLoading = true;
    private string SelectedSchedule = "8-5";

    private string? message;
    private bool isError;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && EmployeeId != Guid.Empty)
        {
            await LoadEmployee();
        }
    }

    private async Task LoadEmployee()
    {
        message = null;
        isLoading = true;
        employee = await AdminApi.GetEmployeeByIdAsync(EmployeeId);
        
        // Set schedule dropdown based on employee's current schedule
        if (employee != null)
        {
            if (employee.SchedTimeIn == TimeOnly.Parse("08:00") && employee.SchedTimeOut == TimeOnly.Parse("17:00"))
            {
                SelectedSchedule = "8-5";
            }
            else if (employee.SchedTimeIn == TimeOnly.Parse("09:00") && employee.SchedTimeOut == TimeOnly.Parse("18:00"))
            {
                SelectedSchedule = "9-6";
            }
            else
            {
                SelectedSchedule = "none";
            }
        }
        
        isLoading = false;
    }

    private async Task Save()
    {
        if (employee is null)
            return;

        message = null;

        // Apply schedule selection to employee
        if (SelectedSchedule == "8-5")
        {
            employee.SchedTimeIn = TimeOnly.Parse("08:00");
            employee.SchedTimeOut = TimeOnly.Parse("17:00");
        }
        else if (SelectedSchedule == "9-6")
        {
            employee.SchedTimeIn = TimeOnly.Parse("09:00");
            employee.SchedTimeOut = TimeOnly.Parse("18:00");
        }
        else
        {
            employee.SchedTimeIn = null;
            employee.SchedTimeOut = null;
        }

        var ok = await AdminApi.UpdateEmployeeAsync(EmployeeId, employee);
        isError = !ok;
        message = ok ? "Employee updated." : "Failed to update employee.";

        if (ok)
        {
            // Show success message briefly
            await Task.Delay(1000);
            message = null;
            
            // Close modal and notify parent
            await CloseModal();
            await OnEmployeeUpdated.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        message = null;
        isError = false;
        
        await CloseModal();
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
