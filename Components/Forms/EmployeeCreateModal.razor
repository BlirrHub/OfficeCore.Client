@using OfficeCore.Client.Models.Dtos
@using OfficeCore.Client.Components.Common
@using OfficeCore.Client.Components.Forms
@using static OfficeCore.Client.Components.Forms.ComboBox<string>
@inject OfficeCore.Client.Services.Api.AdminApi AdminApi
@inject OfficeCore.Client.Services.Api.SettingsApi SettingsApi

<Modal IsOpen="IsOpen" IsOpenChanged="IsOpenChanged" Title="Create Employee" Size="Modal.ModalSize.Medium">
    <div class="grid grid-cols-1 gap-3">
        <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" placeholder="Username" @bind="Req.Username" />

        <div class="grid grid-cols-2 gap-3">
            <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" placeholder="First name" @bind="Req.FirstName" />
            <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" placeholder="Last name" @bind="Req.LastName" />
        </div>

        <ComboBox TValue="string"
                  Label="Department"
                  Placeholder="Select department..."
                  Value="@Req.Department"
                  ValueChanged="@OnDepartmentChanged"
                  Options="@departmentOptions" />

        <ComboBox TValue="string"
                  Label="Position"
                  Placeholder="Select position..."
                  @bind-Value="Req.Position"
                  Options="@filteredPositionOptions" />

        <div class="grid grid-cols-2 gap-3">
            <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" type="number" placeholder="Biometric ID" @bind="Req.BiometricId" />
            <input class="rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white placeholder:text-neutral-500" type="number" step="0.01" placeholder="Daily rate" @bind="Req.DailyRate" />
        </div>

        <div>
            <label class="mb-1 block text-sm font-medium text-neutral-300">Schedule</label>
            <select class="w-full rounded-xl border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-white" @bind="SelectedSchedule">
                <option value="8-5" class="bg-neutral-900">8:00 am - 5:00 pm</option>
                <option value="9-6" class="bg-neutral-900">9:00 am - 6:00 pm</option>
                <option value="none" class="bg-neutral-900">None</option>
            </select>
        </div>

        <label class="flex items-center gap-2 text-sm text-neutral-200">
            <input type="checkbox" @bind="Req.IsOTEnabled" class="rounded" />
            OT Enabled
        </label>

        <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-4">
            <p class="mb-2 text-sm font-semibold text-neutral-200">Government Deductions</p>
            <div class="grid grid-cols-3 gap-2">
                <label class="flex items-center gap-2 text-sm text-neutral-200">
                    <input type="checkbox" @bind="Req.HasSSSDeduction" class="rounded" />
                    SSS
                </label>
                <label class="flex items-center gap-2 text-sm text-neutral-200">
                    <input type="checkbox" @bind="Req.HasPhilHealthDeduction" class="rounded" />
                    PhilHealth
                </label>
                <label class="flex items-center gap-2 text-sm text-neutral-200">
                    <input type="checkbox" @bind="Req.HasPagIBIGDeduction" class="rounded" />
                    Pag-IBIG
                </label>
            </div>
        </div>

        <div>
            <label class="text-sm font-medium text-neutral-300">Roles</label>
            <div class="max-h-32 overflow-y-auto rounded-2xl border border-neutral-800 bg-neutral-900 p-3">
                @if (availableRoles.Count == 0)
                {
                    <p class="text-sm text-neutral-500">No roles available</p>
                }
                else
                {
                    @foreach (var role in availableRoles)
                    {
                        <label class="mb-1 flex cursor-pointer items-center gap-2 text-sm text-neutral-200">
                            <input type="checkbox" 
                                   checked="@selectedRoles.Contains(role.Name)"
                                   @onchange="@(e => ToggleRole(role.Name))"
                                   class="rounded" />
                            @role.Name
                        </label>
                    }
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="rounded-2xl border px-4 py-3 text-sm @(IsError ? "border-red-500/30 bg-red-500/10 text-red-200" : "border-emerald-500/30 bg-emerald-500/10 text-emerald-200")">@Message</div>
        }

        <div class="flex justify-end gap-3">
            <button class="rounded-xl border border-neutral-700 px-4 py-2 text-sm text-neutral-300 transition hover:bg-neutral-900"
                    @onclick="Cancel">
                Cancel
            </button>
            <button class="rounded-xl border border-amber-400/40 bg-amber-400/20 px-5 py-2 text-sm font-medium text-amber-200 transition hover:bg-amber-400/30"
                    @onclick="CreateNewEmployee">
                Create
            </button>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnEmployeeCreated { get; set; }

    private CreateEmployeeRequest Req = new();
    private List<ComboBoxOption<string>> departmentOptions = new();
    private List<PositionDto> allPositions = new();
    private List<ComboBoxOption<string>> filteredPositionOptions = new();
    private List<RoleDto> availableRoles = new();
    private HashSet<string> selectedRoles = new();
    
    private string SelectedSchedule = "8-5";
    private string? Message;
    private bool IsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOptions();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await LoadOptions();
        }
    }

    private async Task LoadOptions()
    {
        // Load departments
        var departments = await SettingsApi.GetDepartmentsAsync();
        departmentOptions = departments
            .Select(d => new ComboBoxOption<string> { Value = d.Name, Text = d.Name })
            .ToList();

        // Load all positions
        allPositions = await SettingsApi.GetPositionsAsync();
        
        // Filter positions if department is already selected
        FilterPositions();

        // Load roles
        availableRoles = await SettingsApi.GetRolesAsync();
    }

    private async Task OnDepartmentChanged(string? newDepartment)
    {
        Req.Department = newDepartment;
        Req.Position = null; // Clear position when department changes
        FilterPositions();
        await Task.CompletedTask;
    }

    private void FilterPositions()
    {
        if (string.IsNullOrWhiteSpace(Req.Department))
        {
            filteredPositionOptions = new();
        }
        else
        {
            filteredPositionOptions = allPositions
                .Where(p => p.DepartmentName == Req.Department)
                .Select(p => new ComboBoxOption<string> { Value = p.Name, Text = p.Name })
                .ToList();
        }
    }

    private void ToggleRole(string roleName)
    {
        if (selectedRoles.Contains(roleName))
        {
            selectedRoles.Remove(roleName);
        }
        else
        {
            selectedRoles.Add(roleName);
        }
    }

    private async Task CreateNewEmployee()
    {
        Message = null;

        // set default temp password and apply schedule selection
        Req.TempPassword = "password";

        // Set roles from selected checkboxes
        Req.Roles = selectedRoles.ToList();

        // map schedule dropdown to time fields
        if (SelectedSchedule == "8-5")
        {
            Req.SchedTimeIn = TimeOnly.Parse("08:00");
            Req.SchedTimeOut = TimeOnly.Parse("17:00");
        }
        else if (SelectedSchedule == "9-6")
        {
            Req.SchedTimeIn = TimeOnly.Parse("09:00");
            Req.SchedTimeOut = TimeOnly.Parse("18:00");
        }
        else
        {
            Req.SchedTimeIn = null;
            Req.SchedTimeOut = null;
        }

        var ok = await AdminApi.CreateEmployeeAsync(Req);

        IsError = !ok;
        Message = ok ? "Employee created." : "Failed to create employee (check token/roles/server).";

        if (ok)
        {
            // Reset form
            await Task.Delay(1000); // Show success message briefly
            Req = new();
            selectedRoles.Clear();
            SelectedSchedule = "8-5";
            Message = null;
            
            // Close modal and notify parent
            await CloseModal();
            await OnEmployeeCreated.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        // Reset form
        Req = new();
        selectedRoles.Clear();
        SelectedSchedule = "8-5";
        Message = null;
        IsError = false;
        
        await CloseModal();
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
}
