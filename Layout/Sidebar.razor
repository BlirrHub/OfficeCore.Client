@using Microsoft.AspNetCore.Components.Routing
@using OfficeCore.Client.Services.State
@using Microsoft.JSInterop
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (AuthState.UserType == "Admin")
{
    <!-- Admin Navigation -->
    <div class="flex h-full min-h-0 flex-col">
        <nav class="flex-1 space-y-1">
            <NavLink href="/admin/dashboard" Match="NavLinkMatch.All"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                <span>Dashboard</span>
            </NavLink>

        <NavLink href="/admin/clients"
            class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
            activeClass="bg-black font-semibold">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <span>Clients</span>
        </NavLink>

        <div class="@(isEmployeesExpanded ? "" : "")">
            <button @onclick="ToggleEmployees" class="w-full flex items-center justify-between px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                    <span>Employee</span>
                </div>
                <svg class="w-5 h-5 transform transition-transform @(isEmployeesExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
            
            @if (isEmployeesExpanded)
            {
                <div class="ml-4 mt-1 space-y-1 border-l border-gray-600">
                    <NavLink href="/admin/employees"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span>Employees</span>
                    </NavLink>
                    
                    <NavLink href="/admin/attendance-weekly"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                        <span>Weekly Attendance</span>
                    </NavLink>
                    
                    <NavLink href="/admin/payroll-weekly"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Weekly Payroll</span>
                    </NavLink>
                </div>
            }
        </div>

        <div class="@(isFinanceExpanded ? "" : "")">
            <button @onclick="ToggleFinance" class="w-full flex items-center justify-between px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <span>Finance</span>
                </div>
                <svg class="w-5 h-5 transform transition-transform @(isFinanceExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
            
            @if (isFinanceExpanded)
            {
                <div class="ml-4 mt-1 space-y-1 border-l border-gray-600">
                    <NavLink href="/admin/liquidations"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span>Daily Liquidations</span>
                    </NavLink>
                    
                    <NavLink href="/admin/cash-advances"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Cash Advances</span>
                    </NavLink>
                    
                    <NavLink href="/admin/petty-cash"
                             class="flex items-center gap-2 px-4 py-2.5 rounded-md text-white text-base hover:bg-neutral-950"
                             activeClass="bg-black font-semibold">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                        </svg>
                        <span>Petty Cash Fund</span>
                    </NavLink>
                </div>
            }
        </div>

            <NavLink href="/admin/tasks"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                <span>Tasks</span>
            </NavLink>

            <NavLink href="/admin/organization"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <span>Organization</span>
            </NavLink>

            <NavLink href="/admin/settings"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>Settings</span>
            </NavLink>
        </nav>

        <!-- Logout button at bottom -->
        <div class="mt-auto pt-4 border-t border-gray-600">
            <button @onclick="HandleLogout" 
                    class="w-full flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-red-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span>Logout</span>
            </button>
        </div>
    </div>
}
else
{
    <!-- Employee Navigation -->
    <div class="flex h-full min-h-0 flex-col">
        <nav class="flex-1 space-y-1">
            <NavLink href="/app/dashboard" Match="NavLinkMatch.All"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/app/my-tasks"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                <span>My Tasks</span>
            </NavLink>

            <NavLink href="/app/task-pool"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <span>Task Pool</span>
            </NavLink>

            <NavLink href="/app/cash-advances"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Cash Advances</span>
            </NavLink>

            <NavLink href="/app/liquidations"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>Liquidations</span>
            </NavLink>

            <NavLink href="/app/settings"
                     class="flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-neutral-950"
                     activeClass="bg-black font-semibold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>Settings</span>
            </NavLink>
        </nav>

        <!-- Logout button at bottom -->
        <div class="mt-auto pt-4 border-t border-gray-600">
            <button @onclick="HandleLogout" 
                    class="w-full flex items-center gap-3 px-4 py-3 rounded-md text-white text-base font-semibold hover:bg-black transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span>Logout</span>
            </button>
        </div>
    </div>
}

@code {
    private bool isEmployeesExpanded = true;
    private bool isFinanceExpanded = true;

    private void ToggleEmployees()
    {
        isEmployeesExpanded = !isEmployeesExpanded;
    }

    private void ToggleFinance()
    {
        isFinanceExpanded = !isFinanceExpanded;
    }

    private async Task HandleLogout()
    {
        AuthState.Clear();
        await AuthState.SaveAsync(JS);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
