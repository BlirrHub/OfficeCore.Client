@using OfficeCore.Client.Components.Common
@inherits LayoutComponentBase

<SessionTimeoutMonitor />

<div class="min-h-screen bg-neutral-950">
    <!-- Top bar -->
    <header class="h-14 bg-neutral-900 border-b flex items-center justify-between px-4">
        <div class="flex items-center gap-3">
            <!-- Mobile menu button -->
            <button class="lg:hidden text-white p-2 hover:bg-gray-800 rounded" @onclick="ToggleMobileMenu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
            <div class="text-white font-bold text-xl sm:text-2xl">OfficeCore</div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
            <NotificationBell />
            <a href="/profile" class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-neutral-700 text-xs font-semibold text-white hover:bg-neutral-600 transition-colors">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </a>
        </div>
    </header>

    <div class="relative flex min-h-[calc(100vh-56px)] overflow-hidden">
        <!-- Mobile overlay -->
        @if (isMobileMenuOpen)
        {
            <div class="fixed inset-0 bg-black bg-opacity-50 z-30 lg:hidden" @onclick="ToggleMobileMenu"></div>
        }

        <!-- Sidebar -->
        <aside class="@GetSidebarClasses()">
            <Sidebar/>
        </aside>

        <!-- Page content -->
        <main class="flex-1 min-w-0 overflow-x-hidden p-3 sm:p-4 md:p-6">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private string GetSidebarClasses()
    {
        var baseClasses = "w-72 bg-neutral-900 border-r h-[calc(100vh-56px)] overflow-y-auto overflow-x-hidden p-4 transition-transform duration-300 ease-in-out";
        var mobileClasses = "fixed top-14 left-0 bottom-0 z-40 lg:relative lg:top-0";
        var transformClass = isMobileMenuOpen ? "translate-x-0" : "-translate-x-full lg:translate-x-0";
        
        return $"{baseClasses} {mobileClasses} {transformClass}";
    }
}