@inherits LayoutComponentBase

<div class="min-h-screen bg-neutral-300">
    <!-- Top bar -->
    <header class="h-14 bg-neutral-950 border-b flex items-center justify-between px-4">
        <div class="text-white font-bold text-2xl">OfficeCore</div>

        <div class="flex items-center gap-3">
            <button class="px-3 py-1.5 rounded-md border bg-gray-500 hover:bg-gray-400 text-white">
                Notifications
            </button>
            <div class="h-9 w-9 rounded-full bg-gray-200"></div>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-neutral-900 border-r min-h-[calc(100vh-56px)] p-3">
            <Sidebar/>
        </aside>

        <!-- Page content -->
        <main class="flex-1 min-w-0 p-6 overflow-x-hidden">
            @Body
        </main>
    </div>d
</div>